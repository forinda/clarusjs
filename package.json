{
  "name": "clarusjs-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @clarusjs/example-counter dev",
    "docs:dev": "pnpm --filter @clarusjs/docs dev",
    "docs:build": "pnpm --filter @clarusjs/docs build",
    "docs:test": "pnpm --filter @clarusjs/docs test:e2e",
    "docs:check": "pnpm --filter @clarusjs/docs check",
    "ui:dev": "pnpm --filter @clarusjs/ui-site dev",
    "ui:build": "pnpm --filter @clarusjs/ui-site build",
    "ui:test": "pnpm --filter @clarusjs/ui-site test:e2e",
    "ui:check": "pnpm --filter @clarusjs/ui-site check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:tag": "changeset tag",
    "release:enter:alpha": "changeset pre enter alpha",
    "release:enter:beta": "changeset pre enter beta",
    "release:enter:rc": "changeset pre enter rc",
    "release:exit:pre": "changeset pre exit",
    "format:tscl": "prettier --write \"packages/{docs,theme-docs,ui-site}/src/**/*.tscl\"",
    "format:tscl:check": "prettier --check \"packages/{docs,theme-docs,ui-site}/src/**/*.tscl\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@clarusjs/prettier-plugin": "workspace:*",
    "clarusjs": "workspace:*",
    "prettier": "3.10.1"
  }
}
