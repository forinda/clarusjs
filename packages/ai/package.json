{
  "name": "@clarusjs/ai",
  "version": "0.1.1",
  "description": "AI coding tools for clarusjs: an MCP server (check, explain, compile, docs search), AGENTS.md and an agent skill",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/clarusjs.git",
    "directory": "packages/ai"
  },
  "homepage": "https://clarusjs.com/guide/ai-coding",
  "keywords": [
    "clarusjs",
    "mcp",
    "ai",
    "agents",
    "tscl"
  ],
  "bin": {
    "clarusjs-ai": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/mcp.ts",
    "./docs": "./src/docs.ts",
    "./agents": "./src/agents.ts",
    "./skill": "./src/skill.ts"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "commander": "^15.1.0"
  },
  "peerDependencies": {
    "clarusjs": ">=0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "clarusjs": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "./docs": {
        "types": "./dist/docs.d.ts",
        "default": "./dist/docs.js"
      },
      "./agents": {
        "types": "./dist/agents.d.ts",
        "default": "./dist/agents.js"
      },
      "./skill": {
        "types": "./dist/skill.d.ts",
        "default": "./dist/skill.js"
      }
    }
  }
}
