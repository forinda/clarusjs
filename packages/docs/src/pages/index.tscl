@import copy from '@clarusjs/theme-docs/copy.tscl'
@import docs from '../layouts/docs.tscl'
@import counter from '../components/counter.tscl'
@import callout from '@clarusjs/theme-docs/callout.tscl'
@import whatShips from '../components/what-ships.tscl'
@import todo from '../components/todo.tscl'
@import todoSummary from '../components/todo-summary.tscl'

<docs [title]="'Clear, compiled views'">
  <section class="hero">
    <img src="/logo.svg" alt="" width="96" height="96" />
    <h1>clarus<span class="js">.js</span></h1>
    <p class="tagline">Clear, compiled views.</p>
    <p>
      Write components in a familiar template language. clarusjs compiles them to plain server HTML and ships JavaScript
      only for the parts that are interactive. You can always see where each line runs.
    </p>
    <p class="actions">
      <a class="button" href="/guide/getting-started">Get started</a>
      <a class="button ghost" href="https://github.com/forinda/clarusjs">GitHub</a>
    </p>
  </section>

  {{-- The bento (#372): what clarusjs gives you, with the live parts as cards. --}}
  <section class="bento-section" aria-labelledby="bento-title">
    <h2 id="bento-title">What you get</h2>
    <div class="bento">
      <article class="bento-card span-4 tall">
        <p class="bento-kicker"><icon name="lucide:zap" /> Islands</p>
        <h3>This page has one island</h3>
        <p>
          Everything here is static HTML, rendered at build time. The button is a component with a
          <code>&lt;script&gt;</code>, so it is the only thing that ships JavaScript. Click it.
        </p>
        <div class="demo"><counter [start]="0" /></div>
        <whatShips attach="interaction" />
        <div class="sample">
          <pre tabindex="0"><code verbatim lang="tscl">@input start: number = 0

<script>
  let count = state(start)
  const double = derived(() => count * 2)
  function add() { count++ }
</script>

<button (click)="add()">Clicked {{ count }} times (double: {{ double }})</button></code></pre>
          <copy attach="interaction" />
        </div>
      </article>

      <article class="bento-card span-2">
        <p class="bento-kicker"><icon name="lucide:code" /> HTML first</p>
        <h3>No script, no JavaScript</h3>
        <p>A component without a <code>&lt;script&gt;</code> is HTML only. This is all it sends to the browser:</p>
        <pre class="bento-code" tabindex="0"><code verbatim>export {}</code></pre>
      </article>

      <article class="bento-card span-2">
        <p class="bento-kicker"><icon name="lucide:layers" /> No hydration</p>
        <h3>Attach, don't re-render</h3>
        <ol class="bento-flow">
          <li>The server sends HTML</li>
          <li>An island attaches to it</li>
          <li>Only the parts that change update</li>
        </ol>
        <p>Nothing renders twice, so nothing can mismatch.</p>
      </article>

      <article class="bento-card span-3">
        <p class="bento-kicker"><icon name="lucide:list" /> Lists</p>
        <h3>Rows by key</h3>
        <p>
          <code>@for</code> renders the list on the server; in the browser, rows are added and removed by key
          without touching the others.
        </p>
        <todoSummary />
        <todo />
      </article>

      <article class="bento-card span-3">
        <p class="bento-kicker"><icon name="lucide:shield-check" /> Checked</p>
        <h3>Errors at build time</h3>
        <p>
          <code>clarusjs check</code> type-checks templates with your own TypeScript and points at the line you wrote.
        </p>
        <pre class="bento-code bento-terminal" tabindex="0"><code verbatim>$ npx clarusjs check
src/pages/index.tscl:3:13 error TS2339:
  Property 'nmae' does not exist on type 'User'.</code></pre>
        <a class="bento-link" href="/guide/type-checking">Type checking →</a>
      </article>

      <article class="bento-card span-2">
        <p class="bento-kicker"><icon name="lucide:route" /> Rendering</p>
        <h3>Static, server or client</h3>
        <ul class="bento-routes">
          <li><code>/</code><span>static</span></li>
          <li><code>/account/*</code><span>server</span></li>
          <li><code>/app/*</code><span>client</span></li>
        </ul>
        <a class="bento-link" href="/guide/rendering-modes">Rendering modes →</a>
      </article>

      <article class="bento-card span-2">
        <p class="bento-kicker"><icon name="lucide:feather" /> Small</p>
        <h3>A runtime under 5 KB</h3>
        <p class="bento-stat">&lt; 5 KB</p>
        <p>Gzipped, in the browser. A size test in the repo keeps it there.</p>
      </article>

      <article class="bento-card span-2">
        <p class="bento-kicker"><icon name="lucide:bot" /> AI agents</p>
        <h3>Checks for agents too</h3>
        <p>An MCP server to check, compile and search the docs, and the conventions for <code>AGENTS.md</code>.</p>
        <pre class="bento-code bento-terminal" tabindex="0"><code verbatim>$ npx @clarusjs/ai agents</code></pre>
        <a class="bento-link" href="/guide/ai-coding">AI coding →</a>
      </article>
    </div>
  </section>

  {{-- Two ways in: a path to follow once (Learn), or a reference to come back to (Docs). --}}
  <section class="ways" aria-labelledby="ways-title">
    <h2 id="ways-title">Two ways in</h2>
    <div class="ways-cards">
      <a class="way" href="/learn/first-page">
        <span class="way-kicker">Learn</span>
        <strong>Build your first site</strong>
        <span
          >Six short lessons, from install to deploy: code to run, quick quizzes, XP and badges. Your progress stays in
          your browser.</span
        >
        <span class="way-go">Start lesson 1 →</span>
      </a>
      <a class="way" href="/guide/what-is-clarusjs">
        <span class="way-kicker">Docs</span>
        <strong>Look things up</strong>
        <span
          >The guide and the reference: every template feature, islands, routing, Markdown and the build, with
          examples.</span
        >
        <span class="way-go">Read the guide →</span>
      </a>
    </div>
  </section>

  <callout
    ><p>
      This site is built with clarusjs: its pages are static HTML, and only the interactive parts ship JavaScript. Every
      feature it uses is tested here in a real browser.
    </p></callout
  >
</docs>
