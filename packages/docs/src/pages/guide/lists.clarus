@import copy from '../../components/copy.clarus'
@import docs from '../../layouts/docs.clarus'

<docs [title]="'Lists'" [path]="'/guide/lists'" [description]="'Repeat content with @for, track keys and @empty.'">
  <h1>Lists</h1>
  <p class="lead">Repeat content with <code>@for</code>.</p>
  <div class="sample"><pre><code verbatim><ul>
  @for (post of posts; track post.id) {
    <li>{{ $index + 1 }}. {{ post.title }}</li>
  } @empty {
    <li>No posts yet.</li>
  }
</ul></code></pre><copy attach="interaction" /></div>
  <ul>
    <li><code>track</code> gives each row a key; without it, rows are keyed by position.</li>
    <li><code>$index</code> is the row's position.</li>
    <li><code>@empty</code> shows when the list is empty.</li>
  </ul>
  <p>Inside an interactive component, rows with the same key keep their elements when the list changes; new rows are rendered and removed rows are cleaned up. The to-do list on the <a href="/">home page</a> is built this way.</p>
</docs>
