@import copy from '../../components/copy.tscl'
@import docs from '../../layouts/docs.tscl'
@import callout from '../../components/callout.tscl'

<docs [title]="'Fragment navigation'" [path]="'/guide/fragment-navigation'" [description]="'Move between server-rendered pages without reloading: swap the page region, keep persisted elements, attach new islands.'">
  <h1>Fragment navigation</h1>
  <p class="lead">With fragment navigation on, moving between pages swaps the changed part of the page instead of reloading it. Every page is still a complete HTML page that works without JavaScript.</p>
  <div class="sample"><pre><code verbatim>clarusjs({ fragments: true })</code></pre><copy attach="interaction" /></div>

  <h2>How it works</h2>
  <ol>
    <li>The build writes each page's fragment next to it: <code>guide/lists/index.frag.html</code> holds the page's title and its swap region. Server routes serve theirs from the handler.</li>
    <li>A small script (under 1 KB gzip) handles clicks to other pages on the site: it fetches the fragment, swaps the region, updates the title and attaches the page's islands.</li>
    <li>Back and forward work as usual. If anything fails, the page loads normally.</li>
  </ol>

  <h2>Choosing what's swapped</h2>
  <p>Mark the region with <code>data-cl-swap</code>; without one, the whole <code>&lt;body&gt;</code> is swapped. This site swaps the body, so the sidebar and the header follow the page.</p>
  <div class="sample"><pre><code verbatim><body>
  <header>…</header>
  <main data-cl-swap>…</main>
</body></code></pre><copy attach="interaction" /></div>

  <h2>Keeping elements</h2>
  <p>An element marked <code>data-cl-persist="key"</code> is kept across swaps: the one already on the page moves into the new page, in place of the new page's element with the same key. Its state, and any island in it, stay as they are.</p>
  <div class="sample"><pre><code verbatim><span data-cl-persist="theme"><themeToggle /></span></code></pre><copy attach="interaction" /></div>
  <callout [type]="'tip'"><p>This site uses fragment navigation. Change the theme, then follow a link in the sidebar: the page changes without a reload, and the theme toggle is the same element it was.</p></callout>
</docs>
