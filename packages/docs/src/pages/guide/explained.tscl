@import copyButton from '@clarusjs/theme-docs/copy.tscl'
@import docsLayout from '~/layouts/docs.tscl'
@import explainedTable from '~/components/explained-table.tscl'

<script server>
  // Runs on the server while the page renders (at build): nothing here reaches the browser.
  import { execFile } from 'node:child_process'
  import { promisify } from 'node:util'
  import { readManifest } from 'clarusjs/manifest'
  import { explain } from '~/explained.ts'
  const site = explain(readManifest())
  const commit = (await promisify(execFile)('git', ['rev-parse', '--short', 'HEAD'])).stdout.trim()
</script>

<docsLayout
  [title]="'This site, explained'"
  [path]="'/guide/explained'"
  [description]="'Every page of this site with its islands and the JavaScript it ships, generated from the route manifest at build time.'"
>
  <h1>This site, explained</h1>
  <p class="lead">
    Every page of this site, with its islands and the JavaScript it ships. The numbers and tables are generated while
    the site is built, from the same route manifest <code>clarusjs explain</code> reads, so it is always the truth about
    the version you are reading.
  </p>

  {{-- On both build passes, so the first manifest already counts this table's own JavaScript. --}}
  <explainedTable [stats]="site.stats" [rows]="site.rows" />
  <p class="explained-commit">
    Built from commit <code>{{ commit }}</code
    >.
  </p>
  <p>
    Sizes are gzip. "JS on load" is the island loader, the shared runtime and the islands that attach right away; copy
    buttons attach on first interaction, so their code is only in "JS in all".
  </p>

  <h2>How this page is made</h2>
  <p>
    A page can read the manifest with <code>readManifest()</code>. While the site is built, any page that reads it is
    rendered again once the manifest is written; outside a build it returns <code>null</code>. This page reads it in a
    <code>&lt;script server&gt;</code>, which runs on the server while the page renders and can
    <code>await</code> (here, the commit the site was built from): see
    <a href="/guide/fetching#on-the-server">Fetching data</a>.
  </p>
  <div class="sample">
    <pre tabindex="0"><code verbatim lang="tscl">&lt;script server&gt;
  import { readManifest } from 'clarusjs/manifest'
  const routes = Object.entries(readManifest()?.routes ?? {})
&lt;/script&gt;

@for (entry of routes; track entry[0]) {
  <p>{{ entry[0] }}: {{ entry[1].islands.length }} islands</p>
}</code></pre>
    <copyButton attach="interaction" />
  </div>
  <p>To see one page in detail, run <code>clarusjs explain /guide/state</code> after a build.</p>
</docsLayout>
