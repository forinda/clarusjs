@import copy from '../../components/copy.tscl'
@import docs from '../../layouts/docs.tscl'

<docs [title]="'Project structure'" [path]="'/guide/project-structure'" [description]="'Where pages, layouts, components and stores live in a clarusjs project.'">
  <h1>Project structure</h1>
  <p class="lead">clarusjs only requires <code>src/pages</code>. Everything else is a convention this site follows.</p>
  <div class="sample"><pre><code verbatim>my-site/
├── vite.config.ts        clarusjs() plugin
├── public/               copied to the build as is (CSS, images)
└── src/
    ├── pages/            one .tscl file per route
    │   ├── index.tscl          /
    │   └── guide/intro.tscl    /guide/intro
    ├── layouts/          components that render the whole page
    ├── components/       everything else you import
    └── stores/           shared state for islands (.ts)</code></pre><copy attach="interaction" /></div>
  <h2>Generated folders</h2>
  <ul>
    <li><code>dist/client</code>: the static site; <code>dist/server</code>: the request handler.</li>
    <li><code>.clarusjs/</code>: files <code>clarusjs check</code> generates. Keep it out of version control.</li>
  </ul>
</docs>
