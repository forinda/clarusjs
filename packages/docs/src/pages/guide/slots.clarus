@import copy from '../../components/copy.clarus'
@import docs from '../../layouts/docs.clarus'

<docs [title]="'Slots'" [path]="'/guide/slots'" [description]="'Wrap content with <slot />, named slots and fallback content.'">
  <h1>Slots</h1>
  <p class="lead">A component without a script can wrap content: whatever you put between its tags renders at its <code>&lt;slot /&gt;</code>.</p>
  <div class="sample"><pre><code verbatim>{{-- components/card.clarus --}}
<section class="card"><slot /></section>

{{-- a page --}}
<card><p>Inside the card.</p></card></code></pre><copy attach="interaction" /></div>
  <p>The content belongs to the page that writes it, so its holes read the page's inputs. This is how layouts work: this site's layout is a component, and every page wraps its content in it.</p>

  <h2>Named slots</h2>
  <p>Give slots names, and fill them from the parent with <code verbatim>@slot('name') { … }</code>; everything else goes to the default slot. Content inside a <code>&lt;slot&gt;</code> is the fallback, shown when nothing fills it.</p>
  <div class="sample"><pre><code verbatim>{{-- components/panel.clarus --}}
<section>
  <header><slot name="head">Untitled</slot></header>
  <slot />
</section>

{{-- a page --}}
<panel>
  @slot('head') { <h2>Settings</h2> }
  <p>Everything else is the default slot.</p>
</panel></code></pre><copy attach="interaction" /></div>
</docs>
