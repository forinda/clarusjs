@import copy from '../../components/copy.tscl'
@import docs from '../../layouts/docs.tscl'
@import callout from '../../components/callout.tscl'

<docs [title]="'Pages and routes'" [path]="'/guide/routing'" [description]="'File-based routes in clarusjs, dynamic routes with [param] segments, entries() to list their pages and load() for their data.'">
  <h1>Pages and routes</h1>
  <p class="lead">Every <code>.tscl</code> file under <code>src/pages</code> is a route. The file's path is the URL.</p>

  <table>
    <thead><tr><th>File</th><th>URL</th></tr></thead>
    <tbody>
      <tr><td><code>src/pages/index.tscl</code></td><td><code>/</code></td></tr>
      <tr><td><code>src/pages/about.tscl</code></td><td><code>/about</code></td></tr>
      <tr><td><code>src/pages/blog/index.tscl</code></td><td><code>/blog</code></td></tr>
      <tr><td><code>src/pages/users/[id].tscl</code></td><td><code>/users/ada</code>, <code>/users/42</code>, …</td></tr>
    </tbody>
  </table>

  <h2>Dynamic routes</h2>
  <p>A segment in square brackets matches any one segment of the URL. Its value reaches the page as an input with the same name, always a string.</p>
  <div class="sample"><pre><code verbatim>{{-- src/pages/users/[id].tscl --}}
@input id: string

<h1>User {{ id }}</h1></code></pre><copy attach="interaction" /></div>
  <p>A file without brackets wins over a dynamic one, so <code>src/pages/users/new.tscl</code> handles <code>/users/new</code>.</p>

  <h2>Listing the pages to build</h2>
  <p>A static build has to know which pages a dynamic route has. Export <code>entries()</code> from a <code>.load.ts</code> file next to the page; it returns one object per page, and may be async.</p>
  <div class="sample"><pre><code verbatim>// src/pages/users/[id].load.ts
import { users } from '../../data/users.ts'

export function entries() {
  return users.map((user) => ({ id: user.slug }))
}</code></pre><copy attach="interaction" /></div>
  <p>A dynamic route without <code>entries()</code> fails the build and names the file to add. Each value must be a non-empty string without <code>/</code>, so a page can never be written outside its folder.</p>
  <h2>Loading data</h2>
  <p>The same <code>.load.ts</code> file can export <code>load()</code>. It gets the route's <code>params</code> and the <code>request</code>, and what it returns becomes the page's inputs, next to the params.</p>
  <div class="sample"><pre><code verbatim>// src/pages/users/[id].load.ts
import { findUser } from '../../data/users.ts'

export async function load({ params }) {
  return { user: await findUser(params.id) }
}

{{-- src/pages/users/[id].tscl --}}
@import type { User } from '../../data/users.ts'
@input user: User

<h1>{{ user.name }}</h1></code></pre><copy attach="interaction" /></div>
  <ul>
    <li><strong>Server only.</strong> <code>load()</code> runs at build time for static pages (once per page), never in the browser, so it can read files, query a database or use secrets. Only what the page renders reaches the browser.</li>
    <li><strong>Typed.</strong> <code>clarusjs check</code> checks what <code>load()</code> returns against the page's inputs.</li>
    <li><strong>Failures are safe.</strong> If <code>load()</code> throws, the build fails naming the loader; a page rendered on request answers 500 with no internal details, and the error goes to the server log.</li>
  </ul>
  <p><code>clarusjs explain</code> shows which pages ran a loader.</p>

  <callout [type]="'tip'"><p>This site's <a href="/releases">release notes</a> are a dynamic route: <code>src/pages/releases/[version].tscl</code>, with one page per version in the package changelog, each loaded by <code>load()</code>.</p></callout>
</docs>
