@import docs from '../../layouts/docs.tscl'

<docs [title]="'Components inside islands'" [path]="'/guide/components-in-islands'" [description]="'Use other components inside an island.'">
  <h1>Components inside islands</h1>
  <p class="lead">An island can use other components, including inside <code>@if</code> branches and <code>@for</code> rows.</p>
  <ul>
    <li>A component <strong>without</strong> a script is re-rendered in the browser when the props or content it gets from the island change.</li>
    <li>A component <strong>with</strong> a script becomes its own island and keeps its own state, starting from the props it was first given.</li>
  </ul>
  <p>The to-do list on the <a href="/">home page</a> shows its count with a small component whose text comes from the island's state.</p>
</docs>
