@import copy from '../../components/copy.clarus'
@import docs from '../../layouts/docs.clarus'

<docs [title]="'Getting started'" [path]="'/guide/getting-started'" [description]="'Install clarusjs, configure Vite and write your first page.'">
  <h1>Getting started</h1>
  <p class="lead">clarusjs is a Vite plugin plus a small runtime. You need Node 22.12 or later.</p>

  <h2>Install</h2>
  <div class="sample"><pre><code verbatim>pnpm add clarusjs
pnpm add -D vite</code></pre><copy attach="interaction" /></div>

  <h2>Configure Vite</h2>
  <div class="sample"><pre><code verbatim>// vite.config.ts
import { defineConfig } from 'vite'
import clarusjs from 'clarusjs/vite'

export default defineConfig({ plugins: [clarusjs()] })</code></pre><copy attach="interaction" /></div>

  <h2>Write a page</h2>
  <p>Every <code>.clarus</code> file under <code>src/pages</code> is a route: <code>src/pages/index.clarus</code> is <code>/</code>, and <code>src/pages/guide/intro.clarus</code> is <code>/guide/intro</code>.</p>
  <div class="sample"><pre><code verbatim>{{-- src/pages/index.clarus --}}
<h1>Hello</h1>
<p>This page is plain HTML.</p></code></pre><copy attach="interaction" /></div>

  <h2>Run it</h2>
  <div class="sample"><pre><code verbatim>pnpm vite          # dev server, pages rendered on each request
pnpm vite build    # static site in dist/client/</code></pre><copy attach="interaction" /></div>
</docs>
