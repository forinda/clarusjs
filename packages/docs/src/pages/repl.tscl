@import docsLayout from '~/layouts/docs.tscl'
@import codeRepl from '~/components/repl.tscl'
{{-- A tool, laid out like other playgrounds: the header, then the editor and its output filling the window. --}}

<docsLayout
  [title]="'Playground'"
  [path]="'/repl'"
  [description]="'Write a clarusjs component and see it run: compiled in your browser, previewed in a sandbox.'"
  [app]="true"
>
  <codeRepl />
</docsLayout>
