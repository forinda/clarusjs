@import copy from '../../components/copy.tscl'
@import docs from '../../layouts/docs.tscl'

<docs [title]="'CLI'" [path]="'/reference/cli'" [description]="'The clarusjs command line: check and explain.'">
  <h1>CLI</h1>
  <h2>clarusjs check</h2>
  <p>Type-checks every <code>.tscl</code> file under <code>src/</code>, and the TypeScript they use, with your project's TypeScript. Errors are reported at <code>file.tscl:line:col</code>.</p>
  <div class="sample"><pre><code verbatim>clarusjs check [dir] [--json]</code></pre><copy attach="interaction" /></div>
  <table>
    <thead><tr><th>Option</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><code>dir</code></td><td>project folder (default: the current folder)</td></tr>
      <tr><td><code>--json</code></td><td>print diagnostics as JSON: file, line, column, code, message</td></tr>
    </tbody>
  </table>
  <p>Exits with 1 when there are errors. See <a href="/guide/type-checking">Type checking</a> for what it checks and how to run it in CI.</p>

  <h2>clarusjs explain</h2>
  <p>Explains where each part of a built route runs: how it was rendered, its data, its islands and when they attach, and the JavaScript and CSS it ships. Reads <code>dist/clarusjs-manifest.json</code>, so run <code>vite build</code> first.</p>
  <div class="sample"><pre><code verbatim>clarusjs explain [route] [--root dir] [--json]</code></pre><copy attach="interaction" /></div>
  <table>
    <thead><tr><th>Option</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><code>route</code></td><td>a route such as <code>/guide/state</code>; without one, every route is listed with its island count and JavaScript</td></tr>
      <tr><td><code>--root dir</code></td><td>project folder (default: the current folder)</td></tr>
      <tr><td><code>--json</code></td><td>print the route's manifest entry as JSON</td></tr>
    </tbody>
  </table>
  <pre verbatim><code>$ clarusjs explain /guide/state
/guide/state
  Rendered    at build time, to dist/client/guide/state/index.html
  Data        no loader
  Islands     theme-toggle (0.4 KB, on page load)
              copy (0.3 KB, on first interaction)
  JavaScript  4.3 KB on page load, 4.6 KB in all (gzip, 4 files)
  CSS         /docs.css</code></pre>
  <p>Exits with 1 when the route doesn't exist or the site hasn't been built.</p>
</docs>
