@import copy from '../../components/copy.clarus'
@import docs from '../../layouts/docs.clarus'

<docs [title]="'CLI'" [path]="'/reference/cli'" [description]="'The clarusjs command line: check.'">
  <h1>CLI</h1>
  <h2>clarusjs check</h2>
  <p>Type-checks every <code>.clarus</code> file under <code>src/</code>, and the TypeScript they use, with your project's TypeScript. Errors are reported at <code>file.clarus:line:col</code>.</p>
  <div class="sample"><pre><code verbatim>clarusjs check [dir] [--json]</code></pre><copy attach="interaction" /></div>
  <table>
    <thead><tr><th>Option</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><code>dir</code></td><td>project folder (default: the current folder)</td></tr>
      <tr><td><code>--json</code></td><td>print diagnostics as JSON: file, line, column, code, message</td></tr>
    </tbody>
  </table>
  <p>Exits with 1 when there are errors. See <a href="/guide/type-checking">Type checking</a> for what it checks and how to run it in CI.</p>
</docs>
