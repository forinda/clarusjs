@import docs from '../../layouts/docs.tscl'

<docs [title]="'Island attributes'" [path]="'/reference/island-attributes'" [description]="'Attributes you can put on an interactive component tag, and the island element.'">
  <h1>Island attributes</h1>
  <h2>On a component tag</h2>
  <table>
    <thead><tr><th>Attribute</th><th>Values</th><th>Default</th></tr></thead>
    <tbody>
      <tr><td><code>[input]="expr"</code></td><td>any expression</td><td></td></tr>
      <tr><td><code>attach</code></td><td><code>load</code>, <code>idle</code>, <code>visible</code>, <code>interaction</code></td><td><code>load</code></td></tr>
    </tbody>
  </table>
  <h2>On the island element</h2>
  <p>The server wraps each island in <code>&lt;cl-island&gt;</code>. You don't write these; they are listed so the HTML is easy to read.</p>
  <table>
    <thead><tr><th>Attribute</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><code>c</code></td><td>component name</td></tr>
      <tr><td><code>src</code></td><td>URL of its code</td></tr>
      <tr><td><code>p</code></td><td>its props</td></tr>
      <tr><td><code>s</code></td><td>its state when the server rendered it</td></tr>
      <tr><td><code>a</code></td><td>when to attach, if not on load</td></tr>
      <tr><td><code>data-cl-ready</code></td><td>set once it has attached</td></tr>
    </tbody>
  </table>
</docs>
