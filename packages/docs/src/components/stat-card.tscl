{{-- A dashboard card: its stat comes from the shared batch, so cards on one page make one request. --}}
@input key: string
@input label: string
@input money: boolean = false

<script>
  import { resource } from 'clarusjs/fetch'
  import { stats } from '../stores/dashboard.ts'
  const stat = resource(() => stats.get(key))
  function show(v) {
    return (money ? '$' : '') + v.toLocaleString('en-US')
  }
</script>

<div class="stat-card" id="stat-{{ key }}">
  <p class="stat-label">{{ label }}</p>
  @if (stat.value !== undefined) {
    <p class="stat-value">{{ show(stat.value) }}</p>
  } @else if (stat.error) {
    <p class="stat-value stat-muted">Couldn't load {{ key }}</p>
  } @else {
    <p class="stat-value stat-muted">Loading {{ key }}…</p>
  }
</div>

<style scoped>
  :scope {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 12px 16px;
    min-width: 9rem;
  }
  .stat-label {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .stat-value {
    margin: 4px 0 0;
    font-size: 1.4rem;
    font-weight: 600;
  }
  .stat-muted {
    font-size: 1rem;
    font-weight: 400;
    color: var(--muted);
  }
</style>
