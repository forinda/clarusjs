{{-- The view transitions demo's card: the same view-transition-name on both demo pages, small on one, wide on the
     other, so the browser moves and resizes it between them as the page changes. No JavaScript of its own. --}}
@input size: string = 'small'

<figure class="vt-card" [data-size]="size">
  <span class="vt-card-mark" aria-hidden="true">◆</span>
  <figcaption>{{ size === 'small' ? 'A small card' : 'The same card, wide' }}</figcaption>
</figure>

<style scoped>
  :scope {
    view-transition-name: vt-demo-card;
    display: grid;
    place-items: center;
    gap: 8px;
    margin: 16px 0;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 40%, var(--bg)));
    color: var(--bg);
  }
  :scope[data-size='small'] {
    width: 180px;
    height: 120px;
  }
  :scope[data-size='large'] {
    width: 100%;
    height: 260px;
    margin-inline-start: auto;
  }
  .vt-card-mark {
    font-size: 2rem;
  }
  figcaption {
    font-weight: 600;
  }
</style>
