{{-- The Tabs page's demo (#465): a component without a script, so it can hand the tabs island its content. --}}

<div class="tabs-demo">
  <ui-tabs id="gallery-install" label="Install" value="npm" data-gallery="tabs">
    <ui-tab-list>
      <ui-tab value="npm">npm</ui-tab>
      <ui-tab value="pnpm">pnpm</ui-tab>
      <ui-tab value="yarn">yarn</ui-tab>
    </ui-tab-list>
    <ui-tab-panel value="npm"><code>npm i clarusjs</code></ui-tab-panel>
    <ui-tab-panel value="pnpm"><code>pnpm add clarusjs</code></ui-tab-panel>
    <ui-tab-panel value="yarn"><code>yarn add clarusjs</code></ui-tab-panel>
  </ui-tabs>
</div>

<style scoped>
  :scope {
    margin: 16px 0;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
</style>
