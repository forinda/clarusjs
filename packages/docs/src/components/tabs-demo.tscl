{{-- The Tabs page's demo (#465): a component without a script, so it can hand the tabs island its content. --}}
@import uiTabs from '@clarusjs/ui-primitives/tabs.tscl'
@import uiTabList from '@clarusjs/ui-primitives/tab-list.tscl'
@import uiTab from '@clarusjs/ui-primitives/tab.tscl'
@import uiTabPanel from '@clarusjs/ui-primitives/tab-panel.tscl'

<div class="tabs-demo">
  <uiTabs id="gallery-install" label="Install" value="npm" data-gallery="tabs">
    <uiTabList>
      <uiTab value="npm">npm</uiTab>
      <uiTab value="pnpm">pnpm</uiTab>
      <uiTab value="yarn">yarn</uiTab>
    </uiTabList>
    <uiTabPanel value="npm"><code>npm i clarusjs</code></uiTabPanel>
    <uiTabPanel value="pnpm"><code>pnpm add clarusjs</code></uiTabPanel>
    <uiTabPanel value="yarn"><code>yarn add clarusjs</code></uiTabPanel>
  </uiTabs>
</div>

<style scoped>
  :scope {
    margin: 16px 0;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
</style>
