{{-- A child island that tells its parent something happened: its @event rate, sent with emit() from its buttons. --}}
@input max: number = 5
@event rate: number

<script>
  let hovered = state(0)
</script>

<span class="stars" role="group" aria-label="Rate">
  @for (n of Array.from({ length: max }, (_, i) => i + 1); track n) {
    <button
      type="button"
      class="star"
      [aria-label]="n + ' stars'"
      [class]="n <= hovered ? 'star on' : 'star'"
      (mouseenter)="hovered = n"
      (mouseleave)="hovered = 0"
      (click)="emit('rate', n, { reason: 'click', event: $event })"
    >
      ★
    </button>
  }
</span>
