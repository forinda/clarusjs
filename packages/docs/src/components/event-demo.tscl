{{-- Events, live: a custom event from a child island, keys (.esc), focus, and a submit kept in the page (.prevent). --}}
@import starRating from './star-rating.tscl'

<script>
  let rating = state(0)
  let note = state('')
  let log = state([])
  const add = (line) => {
    log = [line, ...log].slice(0, 5)
  }
</script>

<div class="event-demo">
  <starRating (rate)="rating = $event; add('rate: ' + $event + ' (' + $info.reason + ')')" />
  <form (submit.prevent)="add('submit: ' + (note || '(empty)'))">
    <input
      aria-label="Note"
      [(value)]="note"
      (keydown.esc)="note = ''"
      (focus)="add('focus')"
      (blur)="add('blur')"
      placeholder="Type, press Escape or Enter"
    />
  </form>
  <p class="event-rating">Rating: {{ rating || 'none' }}</p>
  <ol class="event-log">
    @for (line of log; track $index) {
      <li>{{ line }}</li>
    }
  </ol>
</div>
