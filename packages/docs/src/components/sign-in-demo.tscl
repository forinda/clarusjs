{{--
  The Auth and cookies guide's demo: an island that signs in through an endpoint. The cookie is HttpOnly, so this
  script never sees it; it asks /api/demo-session who is signed in.
--}}

<script>
  import { browser } from 'clarusjs/runtime'

  let user = state({ name: '' }) // signed out: no name
  let message = state('')

  // body: JSON text, or '' for none.
  const call = async (method, body = '') => {
    const response = await fetch('/api/demo-session', {
      method,
      headers: body ? { 'content-type': 'application/json' } : {},
      body: body || undefined,
    })
    const data = await response.json()
    message = data.error ?? ''
    if (!data.error) user = data.user ?? { name: '' }
  }

  // name: the form's field, from $values.
  const signIn = (name) => call('POST', JSON.stringify({ name }))

  if (browser) call('GET')
</script>

<div class="demo-panel sign-in-demo">
  @if (user.name) {
    <p class="signed-in">
      Signed in as <strong>{{ user.name }}</strong
      >.
    </p>
    <button type="button" (click)="call('DELETE')">Sign out</button>
  } @else {
    <form (submit.prevent)="signIn($values.name)">
      <label>Name <input name="name" autocomplete="off" /></label>
      <button type="submit">Sign in</button>
    </form>
  }
  <p class="demo-muted" role="status">{{ message }}</p>
</div>
