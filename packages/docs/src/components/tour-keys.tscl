{{-- The tour's arrow keys: ← and → move between steps with navigate() from clarusjs/navigation, so the client router renders them. --}}
@input prev: string
@input next: string

<script>
  import { onDispose } from 'clarusjs/runtime'
  import { navigate } from 'clarusjs/navigation'
  if (typeof document !== 'undefined') {
    const keys = (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.target.closest?.('input, textarea, select, [contenteditable]')) return
      const to = event.key === 'ArrowLeft' ? prev : event.key === 'ArrowRight' ? next : ''
      if (to) navigate(to)
    }
    document.addEventListener('keydown', keys)
    onDispose(() => document.removeEventListener('keydown', keys))
  }
</script>

<p class="tour-keys">Use <kbd>←</kbd> and <kbd>→</kbd> to move between steps.</p>
