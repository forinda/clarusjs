{{-- Fetching recipes: prefetch on hover. Pointing at a page (or focusing its button) fetches it into the cache, so
     clicking shows it without waiting. --}}

<script>
  import { json, prefetch, resource } from 'clarusjs/fetch'
  let page = state(1)
  const url = (p) => '/api/demo-records?page=' + p + '&size=3'
  const list = resource(({ signal }) => json(url(page), { signal }), { key: () => ['recipe-pages', page] })
  function warm(p) {
    prefetch(['recipe-pages', p], ({ signal }) => json(url(p), { signal }))
  }
</script>

<div id="recipe-prefetch">
  <p>
    @for (p of [1, 2, 3]; track p) {
      <button
        type="button"
        [aria-current]="page === p ? 'page' : false"
        (mouseenter)="warm(p)"
        (focus)="warm(p)"
        (click)="page = p"
      >
        Page {{ p }}
      </button>
    }
  </p>
  <p class="muted" role="status">{{ list.loading ? 'Loading…' : '' }}</p>
  <ul>
    @for (row of list.value ? list.value.rows : []; track row.id) {
      <li>{{ row.name }}</li>
    }
  </ul>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 8px;
    margin: 12px 0;
    padding: 12px 16px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .muted {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
