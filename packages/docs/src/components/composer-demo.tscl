{{-- The editor guide's composer, made of the parts: messages sent into a list, people to mention, a /shrug command,
     emoji, a limit. ui.clarusjs.com has it as a block to copy. --}}
@import editorField from '@clarusjs/editor/components/field.tscl'
@import editorToolbar from '@clarusjs/editor/components/toolbar.tscl'
@import editorTool from '@clarusjs/editor/components/tool.tscl'
@import editorSuggestions from '@clarusjs/editor/components/suggestions.tscl'
@import editorCount from '@clarusjs/editor/components/count.tscl'
@import editorSend from '@clarusjs/editor/components/send.tscl'

<script>
  const people = [
    { id: 'mara', label: 'Mara Okafor' },
    { id: 'marcus', label: 'Marcus Lee' },
    { id: 'ada', label: 'Ada Lovelace' },
    { id: 'lin', label: 'Lin Wei' },
  ]
  const commands = [{ id: 'shrug', label: 'Shrug', keywords: ['shrug'] }]
  let sent = state([])
  function post(value) {
    sent = [...sent, { id: sent.length + 1, value }]
  }
  // A sent message, shown as it was typed (bold, code, mentions, links). Imported once something is sent: by then
  // the composer has loaded the editor's code, so this adds nothing.
  function show(el, value) {
    let stop
    import('@clarusjs/editor').then(({ content, composerExtensions }) => {
      stop = content(el, { value, format: 'json', extensions: composerExtensions() })
    })
    return () => stop?.()
  }
  const find = (query) => people.filter((p) => p.label.toLowerCase().includes(query.toLowerCase()))
  function run(event) {
    if (event.id === 'shrug') event.editor.view.dispatch(event.editor.view.state.tr.insertText('¯\\_(ツ)_/¯'))
  }
</script>

<div class="composer-demo">
  <ul class="messages" aria-label="Messages" aria-live="polite">
    @for (m of sent; track m.id) {
      <li [use]="(el) => show(el, m.value)"></li>
    } @empty {
      <li class="none">No messages yet. Type one, @ to mention, / for commands, : for emoji.</li>
    }
  </ul>
  <form class="composer" (submit)="$event.preventDefault()">
    <editorField
      class="field"
      attach="interaction"
      [id]="'guide-message'"
      [label]="'Message'"
      [placeholder]="'Message #general'"
      [maxLength]="500"
      (send)="post($event.value)"
    />
    <editorSuggestions [field]="'guide-message'" char="@" (search)="$event.respond(find($event.query))" />
    <editorSuggestions [field]="'guide-message'" char="/" [commands]="commands" (command)="run($event)" />
    <editorSuggestions [field]="'guide-message'" char=":" />
    <div class="footer">
      <editorToolbar [field]="'guide-message'">
        <editorTool command="bold" label="Bold"><b>B</b></editorTool>
        <editorTool command="italic" label="Italic"><i>I</i></editorTool>
        <editorTool command="code" label="Code">&lt;/&gt;</editorTool>
        <editorTool command="link" label="Link">🔗</editorTool>
        <editorTool command="codeBlock" label="Code block">{ }</editorTool>
      </editorToolbar>
      <editorCount [field]="'guide-message'" />
      <editorSend [field]="'guide-message'" />
    </div>
  </form>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    margin: 16px 0;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
  .messages {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .messages li :where(p, pre) {
    margin: 0;
  }
  .messages li :where(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .messages li {
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--bg-soft, transparent);
    white-space: pre-wrap;
  }
  .composer {
    display: grid;
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .composer:focus-within {
    border-color: var(--ui-ring);
    box-shadow: 0 0 0 3px var(--ui-accent-soft);
  }
  .field {
    border: 0;
    box-shadow: none;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border-top: 1px solid var(--rule);
  }
  .footer > :first-child {
    margin-right: auto;
  }
  .messages .none {
    background: none;
    color: var(--muted, inherit);
  }
</style>
