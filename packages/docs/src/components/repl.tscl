{{--
  The playground (#243): a .tscl editor (a textarea over its highlighting) compiled in the page on each edit, and a
  sandboxed preview frame that renders and runs the result. The visitor's code only ever runs in a frame, a fresh one
  per run (so a run's timers and listeners end with it), and its loops are guarded (the frame shares this page's thread).
--}}

<script>
  import { browser, onDispose } from 'clarusjs/runtime'
  import { ClarusError, compile } from 'clarusjs/compiler'
  import runtime from 'virtual:repl-runtime'
  import { frameDoc } from '../repl/frame.ts'
  import { highlightTscl } from '../repl/highlight.ts'
  import { prepare } from '../repl/prepare.ts'
  import { decode, encode } from '../repl/share.ts'
  import { starters } from '../repl/starters.ts'

  let errors = state([])
  let status = state('')

  // Set in the browser below.
  let setSource = (source) => {}
  let currentSource = () => ''
  let loaded = '' // the source last loaded (an example, a shared link): replacing anything else asks first

  function pick(select) {
    const starter = starters.find((s) => s.name === select.value)
    select.value = '' // back to the prompt, so the same example can be picked again
    if (!starter) return
    if (currentSource() !== loaded && !confirm(`Replace your code with the ${starter.name} example?`)) return
    history.replaceState(null, '', location.pathname)
    loaded = starter.source
    setSource(starter.source)
  }

  async function share() {
    history.replaceState(null, '', '#' + (await encode(currentSource())))
    status = 'The link to this code is in the address bar.'
  }

  if (browser) {
    const area = document.getElementById('repl-code')
    const shown = document.getElementById('repl-highlight')
    const box = document.getElementById('repl-preview')
    if (!(area instanceof HTMLTextAreaElement) || !shown || !box) throw new Error('playground: its markup is missing')

    let seq = 0 // each run's number; only the latest one counts
    let visible = { frame: document.createElement('iframe'), id: 0 } // the preview on screen
    let pending = { frame: document.createElement('iframe'), id: 0 } // a run still rendering, shown once it replies
    let timer = setTimeout(() => {})
    let escaped = false // Esc pressed: the next Tab leaves the editor instead of indenting
    let typed = false // the visitor has typed: the initial source (decoded asynchronously) mustn't replace that

    const sync = () => {
      shown.scrollTop = area.scrollTop
      shown.scrollLeft = area.scrollLeft
    }
    const paint = () => {
      shown.innerHTML = highlightTscl(area.value)
      sync()
    }

    const run = () => {
      const id = ++seq
      let server = ''
      let client = ''
      try {
        server = prepare(compile(area.value, { file: 'App.tscl', target: 'server', clientUrl: '/app.js' }).code)
        const c = compile(area.value, { file: 'App.tscl', target: 'client' })
        client = c.stateful ? prepare(c.code) : ''
      } catch (err) {
        // A compile error keeps the last preview: show where, as line:col.
        errors = [
          err instanceof ClarusError
            ? `${err.line}:${err.column} ${err.message.slice(err.message.indexOf(' ') + 1)}`
            : err instanceof Error
              ? err.message
              : String(err),
        ]
        return
      }
      // A fresh frame, hidden until it has rendered; a run still rendering is dropped for this one.
      pending.frame.remove()
      const frame = document.createElement('iframe')
      frame.setAttribute('sandbox', 'allow-scripts')
      frame.title = 'Component preview'
      frame.hidden = true
      frame.addEventListener(
        'load',
        () => frame.contentWindow?.postMessage({ id, server, client: client || null }, '*'),
        { once: true },
      )
      frame.srcdoc = frameDoc(runtime)
      pending = { frame, id }
      box.append(frame)
    }

    const onMessage = (event) => {
      const data = event.data
      if (event.source === pending.frame.contentWindow && data?.id === pending.id) {
        // The run has rendered (or failed): it becomes the preview.
        visible.frame.remove()
        visible = pending
        visible.frame.hidden = false
        pending = { frame: document.createElement('iframe'), id: 0 }
        errors = data.error ? [data.error] : []
      } else if (event.source === visible.frame.contentWindow && data?.id === visible.id && data.error) {
        errors = [data.error] // thrown later: an event handler, a timer
      }
    }

    setSource = (source) => {
      area.value = source
      paint()
      run()
    }
    currentSource = () => area.value

    area.addEventListener('input', () => {
      typed = true
      paint()
      clearTimeout(timer)
      timer = setTimeout(run, 250)
    })
    area.addEventListener('scroll', sync)
    area.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        escaped = true
        return
      }
      if (event.key === 'Tab' && !escaped && !event.shiftKey) {
        event.preventDefault()
        // insertText keeps the browser's undo history; setRangeText where it isn't supported.
        if (!document.execCommand('insertText', false, '  ')) {
          area.setRangeText('  ', area.selectionStart, area.selectionEnd, 'end')
          area.dispatchEvent(new Event('input'))
        }
      }
      escaped = false
    })
    addEventListener('message', onMessage)
    onDispose(() => {
      removeEventListener('message', onMessage)
      clearTimeout(timer)
    })

    // Text typed before this ran (a slow load) is kept; otherwise the shared code, or the first example.
    if (area.value) {
      typed = true
      setSource(area.value)
    }
    decode(location.hash.slice(1)).then((shared) => {
      if (!typed) {
        loaded = shared ?? starters[0].source
        setSource(loaded)
      }
      area.closest('.repl')?.setAttribute('data-ready', '')
    })
  }
</script>

<div class="repl">
  <div class="repl-bar">
    <label>
      Example
      <select (change)="pick($event.target)">
        <option value="">Choose an example…</option>
        @for (s of starters; track s.name) {
          <option [value]="s.name">{{ s.name }}</option>
        }
      </select>
    </label>
    <button type="button" (click)="share()">Share</button>
    <p class="repl-status" role="status">{{ status }}</p>
  </div>
  <div class="repl-panes">
    <div class="repl-editor">
      <pre id="repl-highlight" aria-hidden="true"></pre>
      <textarea
        id="repl-code"
        aria-label="Component source"
        aria-describedby="repl-keys"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
      ></textarea>
    </div>
    <div id="repl-preview" class="repl-preview"></div>
  </div>
  <div aria-live="polite">
    @if (errors.length) {
      <ul class="repl-errors">
        @for (e of errors; track $index) {
          <li>{{ e }}</li>
        }
      </ul>
    }
  </div>
  <p id="repl-keys" class="repl-help">Tab indents. To leave the editor with the keyboard, press Esc, then Tab.</p>
  <noscript><p>The playground needs JavaScript: it compiles your component in the page.</p></noscript>
</div>
