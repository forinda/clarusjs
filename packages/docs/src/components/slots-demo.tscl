{{-- The Slots guide's scoped slots demo: the same list, filled three ways. Rendered on the server; no JavaScript.
     <item-list> is components/item-list.tscl, used by its name (no @import). --}}
@input steps: { id: string; label: string }[] = [
  { id: 'first-page', label: 'Make a page' },
  { id: 'first-island', label: 'Add an island' },
  { id: 'ship-it', label: 'Ship it' },
]

<div class="slots-demo" id="slots-demo">
  <section aria-labelledby="slots-demo-plain">
    <h3 id="slots-demo-plain">Unfilled: the list's own rows</h3>
    <item-list [items]="steps" />
  </section>
  <section aria-labelledby="slots-demo-row">
    <h3 id="slots-demo-row">Filled: the page renders each row</h3>
    <item-list [items]="steps">
      @slot('row', { item, index }) {
        <strong>{{ index + 1 }}.</strong> {{ item.label }} <code>{{ item.id }}</code>
      }
    </item-list>
  </section>
  <section aria-labelledby="slots-demo-empty">
    <h3 id="slots-demo-empty">Empty, with the page's message</h3>
    <item-list [items]="[]">
      @slot('empty') {
        No steps yet. <a href="/learn/first-page">Start the Learn path</a>.
      }
    </item-list>
  </section>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 16px;
    margin: 16px 0;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 15px;
  }
</style>
