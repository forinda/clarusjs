{{-- @transition, live: the panel fades and rises in and out (Vue's classes, from @transition ('fade')); the steps swap
     out-in, the next step coming once the last one has gone. --}}

<script>
  let open = state(true)
  let step = state(1)
  let fruit = state(['Apple', 'Banana', 'Cherry'])
  const more = ['Date', 'Elderberry', 'Fig', 'Grape']
  function addFruit() {
    const next = more.find((f) => !fruit.includes(f))
    if (next) fruit = [...fruit, next]
  }
</script>

<div class="transition-demo">
  <div class="transition-actions">
    <button type="button" [aria-expanded]="String(open)" aria-controls="transition-panel" (click)="open = !open">{{ open ? 'Hide' : 'Show' }} the panel</button>
    <button type="button" (click)="step = step === 3 ? 1 : step + 1">Next step</button>
    <button type="button" (click)="addFruit()">Add a fruit</button>
    <button type="button" (click)="fruit = fruit.slice(1)">Remove the first</button>
    <button type="button" (click)="fruit = [...fruit].reverse()">Reverse</button>
  </div>
  <div id="transition-panel">
    @transition ('fade') {
      @if (open) {
        <p class="transition-panel">Leaves as it came, and is removed once it's gone.</p>
      }
    }
  </div>
  <div class="transition-steps">
    @transition ('fade', { mode: 'out-in' }) {
      @if (step === 1) {
        <p class="transition-step" data-step="1">Step one</p>
      } @else if (step === 2) {
        <p class="transition-step" data-step="2">Step two</p>
      } @else {
        <p class="transition-step" data-step="3">Step three</p>
      }
    }
  </div>
  <ul class="transition-list">
    @transition ('list') {
      @for (f of fruit; track f) {
        <li [data-fruit]="f">{{ f }}</li>
      }
    }
  </ul>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    margin: 16px 0;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
  .transition-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  button {
    font: inherit;
    padding: 6px 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg-soft, transparent);
    color: inherit;
    cursor: pointer;
  }
  #transition-panel,
  .transition-steps {
    min-height: 2.5em;
  }
  .transition-panel,
  .transition-step {
    margin: 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--bg-soft, transparent);
  }
  .fade-enter-active,
  .fade-leave-active {
    transition: opacity 0.2s, translate 0.2s;
  }
  .fade-enter-from,
  .fade-leave-to {
    opacity: 0;
    translate: 0 8px;
  }
  .transition-list {
    position: relative;
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .transition-list li {
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--bg-soft, transparent);
  }
  .list-enter-active,
  .list-leave-active {
    transition: opacity 0.3s, translate 0.3s;
  }
  .list-enter-from,
  .list-leave-to {
    opacity: 0;
    translate: 24px 0;
  }
  .list-move {
    transition: transform 0.3s;
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-enter-active,
    .fade-leave-active,
    .list-enter-active,
    .list-leave-active,
    .list-move {
      transition: none;
    }
  }
</style>
