{{-- "This site, explained": every route in one table, to filter, sort (by any column), sample and trim to some columns. --}}
@import type { Row } from '~/explained.ts'
@input rows: Row[]

<script>
  import { SECTIONS, kb } from '~/explained.ts'
  let query = state('')
  let section = state('All')
  let view = state('heaviest')
  let sortKey = state('load')
  let dir = state('desc')
  let size = state('10')
  let cols = state({ islands: true, load: true, all: true })
  // "Show": a preset that sets the order (and, for "No JavaScript", the filter); a header click sorts by its column.
  function show(next) {
    view = next
    if (next === 'smallest') {
      sortKey = 'load'
      dir = 'asc'
    } else if (next === 'heaviest') {
      sortKey = 'load'
      dir = 'desc'
    } else if (next === 'route') {
      sortKey = 'route'
      dir = 'asc'
    }
  }
  function sortBy(key) {
    if (sortKey === key) dir = dir === 'asc' ? 'desc' : 'asc'
    else {
      sortKey = key
      dir = key === 'route' ? 'asc' : 'desc'
    }
  }
  const filtered = derived(() =>
    rows.filter(
      (r) =>
        (section === 'All' || r.section === section) &&
        r.route.toLowerCase().includes(query.trim().toLowerCase()) &&
        (view !== 'nojs' || r.load === 0),
    ),
  )
  const sorted = derived(() =>
    [...filtered].sort(
      (a, b) =>
        (sortKey === 'route' ? a.route.localeCompare(b.route) : a[sortKey] - b[sortKey]) * (dir === 'asc' ? 1 : -1) ||
        a.route.localeCompare(b.route),
    ),
  )
  const shown = derived(() => (size === 'all' ? sorted : sorted.slice(0, Number(size))))
  function clear() {
    query = ''
    section = 'All'
    show('heaviest')
  }
  // What's filtered, said back: 'for "zzzz" in Reference, with no JavaScript on load'.
  const hint = derived(() =>
    [
      query.trim() && `for "${query.trim()}"`,
      section !== 'All' && `in ${section}`,
      view === 'nojs' && 'with no JavaScript on load',
    ]
      .filter(Boolean)
      .join(', '),
  )
  const span = derived(() => 1 + Number(cols.islands) + Number(cols.load) + Number(cols.all))
  const order = (key) => (sortKey === key ? (dir === 'asc' ? 'ascending' : 'descending') : false)
</script>

<div class="explained-table">
  <div class="explained-controls">
    <label
      ><span><icon name="lucide:search" /> Find</span> <input type="search" placeholder="/guide/" [(value)]="query"
    /></label>
    <label
      >Section
      <select [(value)]="section">
        <option>All</option>
        @for (s of SECTIONS; track s) {
          <option>{{ s }}</option>
        }
      </select></label
    >
    <label
      >Show
      <select [value]="view" (change)="show($event.target.value)">
        <option value="heaviest">Heaviest first</option>
        <option value="smallest">Smallest first</option>
        <option value="nojs">No JavaScript on load</option>
        <option value="route">By route</option>
      </select></label
    >
    <label
      >Rows
      <select [(value)]="size">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="all">All</option>
      </select></label
    >
    <fieldset>
      <legend><icon name="lucide:columns-3" /> Columns</legend>
      <label><input type="checkbox" [(checked)]="cols.islands" /> Islands</label>
      <label><input type="checkbox" [(checked)]="cols.load" /> JS on load</label>
      <label><input type="checkbox" [(checked)]="cols.all" /> JS in all</label>
    </fieldset>
  </div>
  <div class="explained-scroll" tabindex="0" role="region" aria-label="Pages">
    <table class="explained">
      <thead>
        <tr>
          <th [aria-sort]="order('route')">
            <button type="button" (click)="sortBy('route')">Route @if (sortKey !== 'route') {<icon name="lucide:arrow-up-down" class="sort-icon" />} @else if (dir === 'asc') {<icon name="lucide:arrow-up" class="sort-icon" />} @else {<icon name="lucide:arrow-down" class="sort-icon" />}</button>
          </th>
          @if (cols.islands) {
            <th [aria-sort]="order('islandCount')">
              <button type="button" (click)="sortBy('islandCount')">Islands @if (sortKey !== 'islandCount') {<icon name="lucide:arrow-up-down" class="sort-icon" />} @else if (dir === 'asc') {<icon name="lucide:arrow-up" class="sort-icon" />} @else {<icon name="lucide:arrow-down" class="sort-icon" />}</button>
            </th>
          }
          @if (cols.load) {
            <th [aria-sort]="order('load')">
              <button type="button" (click)="sortBy('load')">JS on load @if (sortKey !== 'load') {<icon name="lucide:arrow-up-down" class="sort-icon" />} @else if (dir === 'asc') {<icon name="lucide:arrow-up" class="sort-icon" />} @else {<icon name="lucide:arrow-down" class="sort-icon" />}</button>
            </th>
          }
          @if (cols.all) {
            <th [aria-sort]="order('all')">
              <button type="button" (click)="sortBy('all')">JS in all @if (sortKey !== 'all') {<icon name="lucide:arrow-up-down" class="sort-icon" />} @else if (dir === 'asc') {<icon name="lucide:arrow-up" class="sort-icon" />} @else {<icon name="lucide:arrow-down" class="sort-icon" />}</button>
            </th>
          }
        </tr>
      </thead>
      <tbody>
        @for (r of shown; track r.route) {
          <tr>
            <td>
              <a [href]="r.route">{{ r.route }}</a>
            </td>
            @if (cols.islands) {
              <td>{{ r.islands }}</td>
            }
            @if (cols.load) {
              <td>{{ kb(r.load) }}</td>
            }
            @if (cols.all) {
              <td>{{ kb(r.all) }}</td>
            }
          </tr>
        } @empty {
          <tr>
            <td [colspan]="span">
              <div class="explained-empty">
                <icon name="lucide:search-x" class="explained-empty-icon" />
                <p class="explained-empty-title">No page matches</p>
                <p class="explained-empty-hint">Nothing {{ hint }}. Try another search, or clear the filters.</p>
                <button type="button" (click)="clear()"><icon name="lucide:rotate-ccw" /> Clear filters</button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
  <p class="explained-count" role="status">
    Showing {{ shown.length }} of {{ filtered.length }} ({{ rows.length }} pages)
  </p>
</div>
