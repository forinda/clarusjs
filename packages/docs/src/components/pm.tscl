{{-- Commands as tabs for pnpm, npm, yarn and bun. Every group on the page follows the same choice, and it is remembered. --}}
@import copy from '@clarusjs/theme-docs/copy.tscl'
@input commands: string[]

<script>
  import { pm } from '../stores/pm.ts'
  import { managers, command } from '../pm.ts'
  import { browser } from 'clarusjs/runtime'
  let manager = shared(pm)
  function pick(m) {
    manager = m
    try { localStorage.setItem('clarusjs-pm', m) } catch {}
  }
  // In the browser, start from the saved choice (the server always renders pnpm).
  if (browser) {
    try {
      const saved = managers.find((m) => m === localStorage.getItem('clarusjs-pm'))
      if (saved) manager = saved
    } catch {}
  }
</script>

<div class="sample pm">
  <div class="pm-tabs" role="tablist" aria-label="Package manager">
    @for (m of managers; track m) {<button type="button" role="tab" [aria-selected]="manager === m ? 'true' : 'false'" (click)="pick(m)">{{ m }}</button>}
  </div>
  <pre tabindex="0"><code>{{ commands.map((c) => command(manager, c)).join('\n') }}</code></pre>
  <copy attach="interaction" />
</div>
