{{--
  The Tabs page's second demo (#465): tabs inside an island. The page binds the selected tab two ways, cancels the
  change while "Locked" is on, and has its own button and count inside a panel: content an island passes to the
  tabs island, each wiring its own. Its parts are used by name: the site lists ui-primitives as a component library.
--}}

<script>
  let pm = state('npm')
  let locked = state(false)
  let count = state(0)
</script>

<div class="tabs-bound-demo">
  <label class="bound-lock"><input type="checkbox" [(checked)]="locked" /> Locked</label>
  <ui-tabs id="bound-install" label="Package manager" [(value)]="pm" (change)="if (locked) $info.cancel()">
    <ui-tab-list>
      <ui-tab value="npm">npm</ui-tab>
      <ui-tab value="pnpm">pnpm</ui-tab>
      <ui-tab value="yarn">yarn</ui-tab>
    </ui-tab-list>
    <ui-tab-panel value="npm">
      <button type="button" class="bound-inc" (click)="count++">+1</button>
      <span class="bound-count">{{ count }}</span>
    </ui-tab-panel>
    <ui-tab-panel value="pnpm"><code>pnpm add clarusjs</code></ui-tab-panel>
    <ui-tab-panel value="yarn"><code>yarn add clarusjs</code></ui-tab-panel>
  </ui-tabs>
  <p class="bound-out">Selected: {{ pm }}</p>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    margin: 16px 0;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  p {
    margin: 0;
  }
</style>
