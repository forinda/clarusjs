{{-- A form from field components: one state object, written back copy-on-write; reset needs no cloning. --}}
@import textField from './text-field.tscl'
@import uiCombobox from '@clarusjs/ui-primitives/combobox.tscl'

<script>
  // The choices, as data: the radios, checkboxes and options below are loops over them.
  const plans = [
    { id: 'free', label: 'Free' },
    { id: 'pro', label: 'Pro' },
  ]
  const topics = [
    { id: 'news', label: 'News' },
    { id: 'releases', label: 'Releases' },
  ]
  const langs = [
    { value: 'en', label: 'English' },
    { value: 'sw', label: 'Kiswahili' },
    { value: 'fr', label: 'Français' },
    { value: 'ar', label: 'العربية (Arabic)' },
    { value: 'am', label: 'አማርኛ (Amharic)' },
    { value: 'yo', label: 'Yorùbá' },
  ]
  let form = state({ name: '', email: '', plan: 'free', updates: false, topics: ['news'], langs: ['en'] })
  const initial = form // the starting value, taken from the state itself
  const changed = derived(() => form !== initial)
  function reset() {
    form = initial
  }
  // What the fields tell the form (their events): the last thing that happened, for the line under the summary.
  let activity = state('')
  function langChange(change, info) {
    if (change.selected && form.langs.length >= 3) {
      info.cancel() // the combobox doesn't add it
      activity = 'Up to 3 languages: ' + change.label + ' was not added.'
    } else activity = (change.selected ? 'Added ' : 'Removed ') + change.label + ' (' + info.reason + ').'
  }
</script>

<form class="signup" (submit)="$event.preventDefault()">
  <textField
    [label]="'Name'"
    [placeholder]="'Ada Lovelace'"
    [(value)]="form.name"
    (blur)="activity = 'Left the name field.'"
  />
  <textField
    [label]="'Email'"
    [type]="'email'"
    [placeholder]="'ada@example.com'"
    [(value)]="form.email"
    (blur)="activity = 'Left the email field.'"
  />
  <fieldset class="plan">
    <legend>Plan</legend>
    @for (p of plans; track p.id) {
      <label><input type="radio" name="plan" [value]="p.id" [(value)]="form.plan" /> {{ p.label }}</label>
    }
  </fieldset>
  <label class="check"><input type="checkbox" [(checked)]="form.updates" /> Send me updates</label>
  <fieldset class="topics">
    <legend>Topics</legend>
    @for (t of topics; track t.id) {
      <label><input type="checkbox" [value]="t.id" [(value)]="form.topics" /> {{ t.label }}</label>
    }
  </fieldset>
  <uiCombobox
    [id]="'signup-langs'"
    [label]="'Languages'"
    [options]="langs"
    [multiple]="true"
    [placeholder]="'Search languages…'"
    [(values)]="form.langs"
    (change)="langChange($event, $info)"
  />
  <p class="signup-lists">
    Topics: {{ form.topics.join(', ') || 'none' }} · Languages: {{ form.langs.join(', ') || 'none' }}
  </p>
  <p class="signup-summary" aria-live="polite">
    {{ form.name || 'Someone' }} ({{ form.email || 'no email' }}) on {{ form.plan
    }}{{ form.updates ? ', with updates' : '' }}.{{ changed ? ' Changed.' : '' }}
  </p>
  <p class="signup-activity" aria-live="polite">{{ activity }}</p>
  <button type="button" class="signup-reset" (click)="reset()" [disabled]="!changed">Reset</button>
</form>

<style scoped>
  :scope {
    display: grid;
    gap: 16px;
    max-width: 440px;
    margin: 16px 0;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--surface);
  }
  /* Plan: a radio group as a segmented choice; the picked option is highlighted, keyboard focus keeps its ring. */
  .plan {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: 6px;
    font: 600 13px var(--sans);
    color: var(--muted);
  }
  .plan label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .plan label:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--rule));
  }
  .plan label:has(:checked) {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .plan label:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  input[type='radio'],
  input[type='checkbox'] {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
    margin: 0;
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: center;
    cursor: pointer;
  }
  /* Topics: a checkbox group, a row of options; Languages: a multiple select. */
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .topics label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .signup-lists {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .signup-summary {
    margin: 0;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--bg);
    border: 1px dashed var(--rule);
    color: var(--muted);
    font-size: 14px;
  }
  .signup-reset {
    justify-self: start;
    font: 600 14px var(--sans);
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    transition: background 0.15s;
  }
  .signup-reset:hover:not(:disabled) {
    background: var(--accent-soft);
  }
  .signup-reset:disabled {
    border-color: var(--rule);
    color: var(--muted);
    cursor: not-allowed;
    opacity: 0.7;
  }
  /* A thin button, like the other form demos'. */
  button {
    justify-self: start;
    min-height: 32px;
    padding: 0 12px;
    font: 500 14px var(--sans);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  button:disabled {
    opacity: 0.6;
    cursor: default;
  }
</style>
