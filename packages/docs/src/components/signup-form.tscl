{{-- A form from field components: one state object, written back copy-on-write; reset needs no cloning. --}}
@import textField from './text-field.tscl'

<script>
  let form = state({ name: '', email: '', plan: 'free', updates: false })
  const initial = form // the starting value, taken from the state itself
  const changed = derived(() => form !== initial)
  function reset() { form = initial }
</script>

<form class="signup" (submit)="$event.preventDefault()">
  <textField [label]="'Name'" [(value)]="form.name" />
  <textField [label]="'Email'" [type]="'email'" [(value)]="form.email" />
  <fieldset class="plan"><legend>Plan</legend>
    <label><input type="radio" name="plan" value="free" [(value)]="form.plan"> Free</label>
    <label><input type="radio" name="plan" value="pro" [(value)]="form.plan"> Pro</label>
  </fieldset>
  <label class="check"><input type="checkbox" [(checked)]="form.updates"> Send me updates</label>
  <p class="signup-summary" aria-live="polite">{{ form.name || 'Someone' }} ({{ form.email || 'no email' }}) on {{ form.plan }}{{ form.updates ? ', with updates' : '' }}.{{ changed ? ' Changed.' : '' }}</p>
  <button type="button" class="signup-reset" (click)="reset()" [disabled]="!changed">Reset</button>
</form>

<style scoped>
  :scope { display: grid; gap: 16px; max-width: 440px; margin: 16px 0; padding: 20px; border: 1px solid var(--rule); border-radius: 12px; background: var(--surface); }
  /* Plan: a radio group as a segmented choice; the picked option is highlighted, keyboard focus keeps its ring. */
  .plan { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  legend { float: left; width: 100%; padding: 0; margin-bottom: 6px; font: 600 13px var(--sans); color: var(--muted); }
  .plan label { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--rule); border-radius: 999px; background: var(--bg); cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .plan label:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--rule)); }
  .plan label:has(:checked) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .plan label:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  input[type='radio'], input[type='checkbox'] { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
  .check { display: flex; gap: 10px; align-items: center; cursor: pointer; }
  .signup-summary { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--bg); border: 1px dashed var(--rule); color: var(--muted); font-size: 14px; }
  .signup-reset { justify-self: start; font: 600 14px var(--sans); padding: 8px 16px; border-radius: 8px; border: 1px solid var(--accent); background: transparent; color: var(--accent); cursor: pointer; transition: background 0.15s; }
  .signup-reset:hover:not(:disabled) { background: var(--accent-soft); }
  .signup-reset:disabled { border-color: var(--rule); color: var(--muted); cursor: not-allowed; opacity: 0.7; }
</style>
