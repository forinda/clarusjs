{{-- A larger form: one state object with a section, repeating lines bound by index, a derived total, and the forms
     engine for validation. Each field's error shows once you've left it, or after Send; then it follows what you
     type. The name and email are components that show their own error: f.shown(path) tells them when. --}}
@import textField from './text-field.tscl'

<script>
  import { form } from 'clarusjs/forms'
  import { orderSchema } from '~/order.ts'
  let order = state({ customer: { name: '', email: '' }, lines: [{ item: 'Notebook', qty: '1', price: '4' }] })
  const total = derived(() => order.lines.reduce((sum, line) => sum + Number(line.qty) * Number(line.price), 0))
  let sent = state('')
  const f = form(order, { schema: orderSchema, submit: (values) => { sent = JSON.stringify(values) } })
  function addLine() {
    order = { ...order, lines: [...order.lines, { item: '', qty: '1', price: '0' }] }
  }
  function removeLine(index) {
    order = { ...order, lines: order.lines.filter((_, i) => i !== index) }
  }
</script>

<form class="order" [engine]="f">
  <fieldset>
    <legend>Customer</legend>
    <textField
      [label]="'Name'"
      [placeholder]="'Ada Lovelace'"
      [error]="f.error('customer.name')"
      [show]="f.shown('customer.name')"
      [(value)]="order.customer.name"
    />
    <textField
      [label]="'Email'"
      [type]="'email'"
      [placeholder]="'ada@example.com'"
      [error]="f.error('customer.email')"
      [show]="f.shown('customer.email')"
      [(value)]="order.customer.email"
    />
  </fieldset>
  <fieldset>
    <legend>Lines</legend>
    @for (line of order.lines; track $index) {
      <div class="order-line">
        <input [aria-label]="'Item ' + ($index + 1)" placeholder="Item" [(value)]="order.lines[$index].item" />
        <input type="number" min="0" [aria-label]="'Quantity ' + ($index + 1)" [(value)]="order.lines[$index].qty" />
        <input
          type="number"
          min="0"
          step="any"
          [aria-label]="'Price ' + ($index + 1)"
          [(value)]="order.lines[$index].price"
        />
        <button type="button" [aria-label]="'Remove line ' + ($index + 1)" (click)="removeLine($index)">×</button>
      </div>
    }
    <button type="button" class="order-add" (click)="addLine()">Add a line</button>
    @if (f.error('lines')) {
      <p class="order-error order-lines-error" role="alert">{{ f.error('lines') }}</p>
    }
  </fieldset>
  <p class="order-total">Total: {{ total }}</p>
  <div class="order-actions">
    <button type="submit" class="primary" [disabled]="f.submitting">Send</button>
    <button type="button" class="order-reset" (click)="f.reset(); sent = ''">Reset</button>
    @if (f.dirty) {
      <span class="order-changed">Unsaved changes</span>
    }
  </div>
  @if (sent) {
    <pre class="order-sent">{{ sent }}</pre>
  }
</form>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    max-width: 560px;
    margin: 16px 0;
  }
  fieldset {
    display: grid;
    gap: 10px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 12px 16px;
  }
  .order-line {
    display: grid;
    grid-template-columns: 1fr 72px 72px auto;
    gap: 6px;
  }
  .order-line input {
    min-width: 0;
  }
  input:not([type='checkbox']),
  select {
    min-height: 32px;
    font: 14px var(--sans);
    padding: 0 10px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
  }
  /* Thin controls: 32px tall, 1px lines; the main action in the accent colour. */
  button {
    min-height: 32px;
    padding: 0 12px;
    font: 500 14px var(--sans);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }
  button.primary:hover:not(:disabled) {
    color: var(--bg);
    background: color-mix(in srgb, var(--accent) 85%, var(--fg));
  }
  button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .order-line button {
    min-width: 32px;
    padding: 0;
  }
  .order-error {
    margin: 0;
    color: var(--bad);
    font-size: 13px;
  }
  .order-add {
    justify-self: start;
  }
  .order-actions {
    display: flex;
    gap: 8px;
  }
  .order-changed {
    align-self: center;
    color: var(--muted);
    font-size: 13px;
  }
  .order-total {
    margin: 0;
    font-weight: 600;
  }
  .order-sent {
    font-size: 13px;
    overflow-x: auto;
  }
</style>
