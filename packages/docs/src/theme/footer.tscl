{{--
  This site's footer, in place of the theme's (themeDocs({ components: { footer } }) in vite.config.ts, #361): the
  footer line from the config, and links for the project.
--}}
@import type { ThemeConfig } from '@clarusjs/theme-docs/nav.ts'
@input config: ThemeConfig

<footer class="site-footer site-footer-links">
  <slot>@if (config.footer) {<p>{{ config.footer }}</p>}</slot>
  <nav aria-label="Project">
    <a href="https://github.com/forinda/clarusjs">GitHub</a>
    <a href="https://www.npmjs.com/package/clarusjs">npm</a>
    <a href="/releases">Releases</a>
    <a href="/guide/ai-coding">For AI agents</a>
  </nav>
</footer>

<style scoped>
  :scope nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin-top: 8px;
    font-size: 14px;
  }
  :scope a {
    color: var(--muted);
  }
  :scope a:hover {
    color: var(--accent);
  }
</style>
