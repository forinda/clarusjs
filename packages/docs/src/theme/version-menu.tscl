{{--
  The version menu (#373), at the top of the sidebar through the theme's sidebar-top slot: the version these docs are
  for, and where the others and the release notes are. A <details>: it opens without JavaScript.
--}}
@import { version, versions } from './links.ts'

<details class="version-menu">
  <summary>{{ version }}</summary>
  <ul>
    @for (v of versions; track v.href) {
      <li><a [href]="v.href" [aria-current]="v.current ? 'true' : false">{{ v.label }}</a></li>
    }
    <li><a href="/releases">Release notes</a></li>
  </ul>
</details>

<style scoped>
  :scope {
    position: relative;
    margin-bottom: 12px;
    font-size: 13px;
  }
  :scope summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  :scope summary::-webkit-details-marker {
    display: none;
  }
  :scope summary::after {
    content: '▾';
    font-size: 10px;
  }
  :scope summary:hover,
  :scope[open] summary {
    border-color: var(--accent);
    color: var(--fg);
  }
  :scope ul {
    margin: 6px 0 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
  }
  :scope a {
    display: block;
    padding: 6px 8px;
    border-radius: 6px;
    color: var(--fg);
    text-decoration: none;
  }
  :scope a:hover {
    background: var(--surface);
  }
  :scope a[aria-current='true'] {
    color: var(--accent);
    font-weight: 600;
  }
</style>
