{{-- This site's layout: the docs theme with this site's navigation and settings (src/nav.ts). --}}
@import docsTheme from '@clarusjs/theme-docs/layout.tscl'
@import { theme } from '../nav.ts'
@import type { Heading } from '@clarusjs/theme-docs/nav.ts'
@import '../styles/docs.css'
@input title: string
@input path: string = '/'
@input source: string = ''
@input url: string = ''
@input description: string = 'clarusjs: clear, compiled views. Server HTML with JavaScript only where it is interactive.'
@input headings: Heading[] = []
@input app: boolean = false

<docsTheme
  [config]="theme"
  [title]="title"
  [path]="path"
  [source]="source"
  [url]="url"
  [description]="description"
  [headings]="headings"
  [app]="app"
  ><slot
/></docsTheme>
