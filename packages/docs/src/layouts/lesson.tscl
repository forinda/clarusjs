{{-- Lessons (src/pages/learn, frontmatter `layout: /src/layouts/lesson.tscl` and `steps: true`): the theme's lesson layout. --}}
@import lessonTheme from '@clarusjs/theme-docs/lesson.tscl'
@import { theme } from '~/nav.ts'
@import type { Heading } from '@clarusjs/theme-docs/nav.ts'
@import '~/styles/docs.css'
@input title: string
@input path: string = '/'
@input description: string = 'Learn clarusjs by building a site, one step at a time.'
@input headings: Heading[] = []

<lessonTheme [config]="theme" [title]="title" [path]="path" [description]="description" [headings]="headings"
  ><slot
/></lessonTheme>
