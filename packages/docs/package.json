{
  "name": "@clarusjs/docs",
  "private": true,
  "type": "module",
  "description": "The clarusjs docs site, built with clarusjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "node --experimental-strip-types ../clarusjs/src/cli/index.ts check --strict",
    "explain": "node --experimental-strip-types --no-warnings ../clarusjs/src/cli/index.ts explain",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.tscl\""
  },
  "dependencies": {
    "@clarusjs/theme-docs": "workspace:*",
    "@clarusjs/ui": "workspace:*",
    "@clarusjs/ui-primitives": "workspace:*",
    "clarusjs": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clarusjs/ai": "workspace:*",
    "@clarusjs/content": "workspace:*",
    "@clarusjs/eslint-plugin": "workspace:*",
    "@iconify-json/lucide": "^1.2.158",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "eslint": "10.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
