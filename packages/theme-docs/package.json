{
  "name": "@clarusjs/theme-docs",
  "version": "0.3.0",
  "description": "A docs theme for clarusjs: layout with header, sidebar, content and on-this-page, design tokens, dark mode, copy buttons and callouts.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "types": "node scripts/types.mjs",
    "prepack": "pnpm types",
    "test": "vitest run",
    "typecheck": "pnpm types && tsc --noEmit"
  },
  "peerDependencies": {
    "clarusjs": "workspace:^"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/clarusjs.git",
    "directory": "packages/theme-docs"
  },
  "keywords": [
    "clarusjs",
    "theme",
    "docs",
    "ssg",
    "vite"
  ],
  "homepage": "https://clarusjs.com",
  "bugs": {
    "url": "https://github.com/forinda/clarusjs/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "clarusjs": "workspace:^",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "vite": "^8.3.8"
  }
}
