{{--
  A lesson: a focused header (leave, "Lesson n of N", one segment per step, a slot for XP), the lesson, and a fixed
  action bar. Steps are the page's <section class="step"> (Markdown frontmatter `steps: true`), named by its h2
  headings. Without JavaScript the lesson is a plain page and the bar stays hidden; with it, one step shows at a time.
  Lessons are the items of the config section the page is in, in sidebar order.
  Slots: header-end (XP, …).
--}}
@import lessonBar from './lesson-bar.tscl'
@import learnStatus from './learn-status.tscl'
@import learnPath from './learn-path.tscl'
@import pageHead from './page-head.tscl'
@import type { ThemeConfig, Heading } from './nav.ts'
@import { lessonOf, lessonsOf } from './nav.ts'
@import './theme.css'
@import './lesson.css'
@input config: ThemeConfig
@input title: string
@input description: string = ''
@input path: string = '/'
@input headings: Heading[] = []

<html lang="en">
  <head>
    <pageHead [config]="config" [title]="title" [description]="description" [url]="path" />
  </head>
  <body class="lesson-page">
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="lesson-header">
      <a class="leave" [href]="lessonOf(config, path).leave" aria-label="Leave the lesson">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </a>
      <div class="lesson-name">
        @if (lessonOf(config, path).total) {
          <p class="eyebrow">{{ lessonOf(config, path).label }}</p>
        }
        <p class="name">{{ title }}</p>
      </div>
      {{-- Links to each step: jumps without JavaScript, the progress bar with it. --}}
      <ol class="segments" aria-label="Steps">
        @for (h of headings.filter((h) => h.level === 2); track h.id) {
          <li>
            <a [href]="'#' + h.id">{{ h.text }}</a>
          </li>
        }
      </ol>
      @if (config.learn) {<learnStatus [lessons]="lessonsOf(config).map((l) => l.href)" [progress]="config.learn.progress" />}
      <slot name="header-end"></slot>
    </header>
    <div class="lesson-body">
      {{-- The path (#371): a lesson of config.learn's section, from 1024px. --}}
      @if (config.learn && lessonsOf(config).some((l) => l.href === path)) {
        <aside class="lesson-path">
          <learnPath
            [lessons]="lessonsOf(config)"
            [path]="path"
            [eyebrow]="config.sections.find((s) => s.key === config.learn?.section)?.title ?? 'Learn'"
            [course]="
              config.sections
                .find((s) => s.key === config.learn?.section)
                ?.groups.find((g) => g.items.some((i) => i.href === path))?.title ?? ''
            "
            [steps]="headings.filter((h) => h.level === 2)"
            [progress]="config.learn.progress"
          />
        </aside>
      }
      <main class="lesson" id="content" tabindex="-1"><slot /></main>
    </div>
    <div class="lesson-bar" role="region" aria-label="Lesson actions" hidden>
      <lessonBar
        [lesson]="path"
        [prev]="lessonOf(config, path).prev"
        [next]="lessonOf(config, path).next"
        [leave]="lessonOf(config, path).leave"
        [layout]="config.learn?.layout ?? 'split'"
      />
    </div>
  </body>
</html>
