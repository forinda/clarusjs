{{--
  The page list (a public part, #360): a drawer below 1024px (popover: Escape and a click outside close it), always
  visible from 1024px. Slots: top, bottom. Replace it with themeDocs({ components: { sidebar } }) (#361).

  As designed (#369): search at the top; each group a <details> with its icon and a chevron (the current page's
  group always open, a `collapsed` one closed until opened: no JavaScript); its pages on a guide line, the current one
  marked with a bar; a badge ("New") beside a page that has one.
  As a drawer (#370): "Menu" and a close button, a switch between the sections, then the groups (larger, without icons
  or the search box: the header has one on phones), and a row of links at the bottom.
--}}
@import groupIcon from './icon.tscl'
@import type { ThemeConfig } from '../nav.ts'
@import { groupsOf, sectionKey } from '../nav.ts'
@input config: ThemeConfig
@input path: string = '/'

<nav id="sidebar" class="sidebar" aria-label="Pages" popover>
  <div class="sidebar-head">
    <span>Menu</span>
    <button type="button" popovertarget="sidebar" popovertargetaction="hide" aria-label="Close the menu">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <div class="sidebar-switch tw:mb-3 tw:auto-cols-fr tw:grid-flow-col tw:gap-1 tw:rounded-xl tw:bg-surface tw:p-1">
    @for (s of config.sections.filter((s) => s.switch !== false); track s.key) {
      <a
        [href]="s.href"
        [aria-current]="s.key === sectionKey(config.sections, path) ? 'true' : false"
        class="tw:rounded-lg tw:py-2 tw:text-center tw:text-sm tw:font-semibold tw:text-muted tw:no-underline tw:aria-[current=true]:bg-bg tw:aria-[current=true]:text-accent tw:aria-[current=true]:shadow-sm"
        >{{ s.title }}</a
      >
    }
  </div>
  @if (config.search) {
    {{-- Opens the search dialog, as the header's button and Ctrl/⌘K do (search.tscl listens for data-search-open). --}}
    <button
      type="button"
      data-search-open
      aria-haspopup="dialog"
      class="sidebar-search tw:mb-4 tw:flex tw:h-9 tw:w-full tw:cursor-pointer tw:items-center tw:gap-2 tw:rounded-lg tw:border tw:border-rule tw:bg-bg tw:px-2.5 tw:text-left tw:text-[13px] tw:text-muted tw:transition-colors tw:hover:border-accent tw:hover:text-fg"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <span class="tw:flex-1">Search</span>
      <kbd
        class="tw:rounded tw:border tw:border-rule tw:bg-surface tw:px-1.5 tw:py-px tw:font-sans tw:text-[11px] tw:leading-4 tw:text-muted"
        >⌘K</kbd
      >
    </button>
  }
  <slot name="top"></slot>
  @for (group of groupsOf(config.sections, path); track group.title) {
    <details
      class="tw:group tw:mb-1.5"
      [data-group]="group.title"
      [open]="!group.collapsed || group.items.some((i) => i.href === path)"
    >
      <summary
        class="tw:flex tw:cursor-pointer tw:list-none tw:items-center tw:gap-2.5 tw:rounded-md tw:py-1.5 tw:pr-1 tw:text-[13px] tw:font-semibold tw:text-fg tw:select-none tw:[&::-webkit-details-marker]:hidden"
      >
        <span
          class="group-icon tw:grid tw:size-[22px] tw:flex-none tw:place-items-center tw:rounded-md tw:bg-accent-soft tw:text-accent"
          >@if (group.icon) {<groupIcon [name]="group.icon" />}</span
        >
        <span class="tw:flex-1">{{ group.title }}</span>
        <svg
          class="tw:flex-none tw:text-muted tw:transition-transform tw:group-open:rotate-90"
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 6 6 6-6 6"></path>
        </svg>
      </summary>
      <ul class="tw:my-1 tw:ml-[10px] tw:list-none tw:border-l tw:border-rule tw:p-0">
        @for (item of group.items; track item.href) {
          <li class="tw:m-0">
            <a
              [href]="item.href"
              [aria-current]="item.href === path ? 'page' : false"
              class="tw:-ml-px tw:flex tw:items-center tw:gap-2 tw:rounded-r-md tw:border-l-2 tw:border-transparent tw:py-[5px] tw:pr-2 tw:pl-3 tw:text-[13px] tw:text-fg/80 tw:no-underline tw:transition-colors tw:hover:text-fg tw:aria-[current=page]:border-accent tw:aria-[current=page]:bg-accent-soft tw:aria-[current=page]:font-semibold tw:aria-[current=page]:text-accent"
            >
              <span class="tw:flex-1">{{ item.title }}</span>
              @if (item.badge) {
                <span
                  class="badge tw:rounded tw:bg-amber-100 tw:px-1.5 tw:py-px tw:text-[10.5px] tw:font-bold tw:text-amber-800"
                  >{{ item.badge }}</span
                >
              }
            </a>
          </li>
        }
      </ul>
    </details>
  }
  <slot name="bottom"></slot>
  {{-- The drawer's links row: config.menuLinks, then the social links. --}}
  <div
    class="sidebar-links tw:mt-auto tw:justify-between tw:gap-x-3 tw:gap-y-1 tw:border-t tw:border-rule tw:pt-3 tw:text-[13px] tw:font-medium tw:[&_a]:text-accent tw:[&_a]:no-underline"
  >
    @for (link of [...(config.menuLinks ?? []), ...(config.social ?? [])]; track link.href) {
      <a [href]="link.href">{{ link.label }}</a>
    }
  </div>
</nav>
