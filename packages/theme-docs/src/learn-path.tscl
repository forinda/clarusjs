{{--
  The Learn path (#371), beside a lesson from 1024px: the course and how far you are, each lesson with the XP it can
  earn (done, the one you're on, the next, then locked: a hint, every lesson stays open), this lesson's steps, and your
  XP and badges. Progress is read from this browser, so without JavaScript only the lessons and steps show.
  The steps follow the lesson bar (learn:step); everything else follows saved progress (learn:progress).
--}}
@import type { Heading } from './nav.ts'
@interface Lesson { title: string; href: string; xp?: number; minutes?: number }
@input lessons: Lesson[]
@input path: string
@input eyebrow: string = 'Learn'
@input course: string = ''
@input steps: Heading[] = []
@input progress: string = ''

<script>
  import { load, stats } from './progress.ts'
  let ready = state(false)
  let statuses = state(Object.create(null)) // lesson href → done, current, next or locked
  let done = state(0)
  let xp = state(0)
  let earned = state(0)
  let step = state(0)
  function refresh() {
    const s = stats(
      load(),
      lessons.map((l) => l.href),
    )
    const current = lessons.findIndex((l) => s.status(l.href) === 'current')
    statuses = Object.fromEntries(
      lessons.map((l, i) => [l.href, s.status(l.href) === 'locked' && i === current + 1 ? 'next' : s.status(l.href)]),
    )
    done = s.done
    xp = s.xp
    earned = s.badges.filter((b) => b.earned).length
    ready = true
  }
  const note = (lesson, i) =>
    ready && statuses[lesson.href] === 'done'
      ? 'Done'
      : ready && statuses[lesson.href] === 'locked'
        ? 'Finish lesson ' + i + ' first'
        : lesson.minutes
          ? lesson.minutes + ' min'
          : ''
  if (typeof document !== 'undefined') {
    refresh()
    window.addEventListener('learn:progress', refresh)
    window.addEventListener('learn:step', (event) => {
      if (event instanceof CustomEvent) step = event.detail
    })
  }
</script>

<nav class="learn-path tw:flex tw:flex-col" aria-label="Lessons">
  <div class="tw:border-b tw:border-rule tw:px-4 tw:pt-5 tw:pb-4">
    <p class="tw:m-0 tw:text-[11px] tw:font-bold tw:tracking-wider tw:text-accent tw:uppercase">{{ eyebrow }}</p>
    <p class="tw:m-0 tw:mt-0.5 tw:text-[17px] tw:font-bold tw:text-fg">{{ course }}</p>
    <div class="tw:mt-3 tw:flex tw:items-center tw:gap-2.5">
      <progress
        class="path-progress tw:h-1.5 tw:flex-1"
        [value]="done"
        [max]="lessons.length"
        aria-label="Lessons done"
      ></progress>
      <span class="tw:text-[13px] tw:font-semibold tw:text-fg">{{ done }} of {{ lessons.length }}</span>
    </div>
  </div>
  <ol class="tw:m-0 tw:flex-1 tw:list-none tw:overflow-y-auto tw:p-3">
    @for (lesson of lessons; track lesson.href) {
      <li class="tw:m-0 tw:mb-1" [data-status]="ready ? statuses[lesson.href] : false">
        <a
          class="path-lesson tw:flex tw:items-center tw:gap-3 tw:rounded-xl tw:border-2 tw:border-transparent tw:px-2.5 tw:py-2.5 tw:text-fg tw:no-underline tw:aria-[current=page]:border-accent"
          [href]="lesson.href"
          [aria-current]="lesson.href === path ? 'page' : false"
        >
          <span
            class="path-dot tw:grid tw:size-7 tw:flex-none tw:place-items-center tw:rounded-full tw:text-xs tw:font-bold"
            aria-hidden="true"
          >
            @if (ready && statuses[lesson.href] === 'done') {
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m5 12 5 5 9-10"></path>
              </svg>
            } @else if (!(ready && statuses[lesson.href] === 'locked')) {
              {{ $index + 1 }}
            }
          </span>
          <span class="tw:min-w-0 tw:flex-1">
            <span class="path-title tw:block tw:text-sm tw:leading-snug tw:font-semibold">{{ lesson.title }}</span>
            <span class="tw:block tw:text-xs tw:text-muted">{{ note(lesson, $index) }}</span>
          </span>
          @if (lesson.xp) {
            <span class="path-xp tw:text-xs tw:font-bold">+{{ lesson.xp }}</span>
          }
        </a>
        @if (lesson.href === path && steps.length) {
          <ol class="path-steps tw:my-1.5 tw:ml-[46px] tw:list-none tw:p-0" aria-label="Steps">
            @for (s of steps; track s.id) {
              <li class="tw:m-0" [data-step]="$index < step ? 'done' : $index === step ? 'current' : 'next'">
                <a
                  class="tw:flex tw:items-center tw:gap-2.5 tw:py-1 tw:text-[13px] tw:text-muted tw:no-underline"
                  [href]="'#' + s.id"
                  [aria-current]="$index === step ? 'step' : false"
                  ><span class="step-dot tw:size-2 tw:flex-none tw:rounded-full" aria-hidden="true"></span
                  >{{ s.text }}</a
                >
              </li>
            }
          </ol>
        }
      </li>
    }
  </ol>
  <a
    class="path-footer tw:m-3 tw:mt-0 tw:flex tw:items-center tw:gap-2 tw:rounded-xl tw:px-3.5 tw:py-3 tw:text-sm tw:font-bold tw:no-underline"
    [href]="progress"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13 2L4 14h7l-1 8 9-12h-7z"></path>
    </svg>
    <span class="tw:flex-1" [hidden]="!ready">{{ xp }} XP · {{ earned }} {{ earned === 1 ? 'badge' : 'badges' }}</span>
    <span class="tw:flex-1" [hidden]="ready">Your progress</span>
    <span aria-hidden="true">→</span>
  </a>
</nav>
