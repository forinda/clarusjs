{{--
  The docs layout. Four regions at every width (header, sidebar, content, on this page); only how they show changes:
  below 1024px the sidebar is a drawer (native popover: no JavaScript) and "On this page" a collapsible box, from
  1024px the sidebar is always there, from 1280px "On this page" is a column. Everything site-specific comes from config.
  Slots: sidebar-top, sidebar-bottom, content-top, content-bottom, footer.
--}}
@import pageHead from './page-head.tscl'
@import siteHeader from './parts/header.tscl'
@import docsSidebar from './parts/sidebar.tscl'
@import pageContents from './parts/contents.tscl'
@import pageFooter from './parts/page-footer.tscl'
@import siteFooter from './parts/footer.tscl'
@import type { ThemeConfig, Heading } from './nav.ts'
@import { sectionKey, crumb } from './nav.ts'
@import './theme.css'
@input config: ThemeConfig
@input title: string
@input description: string = ''
@input path: string = '/'
{{-- The page's own route, when it differs from the sidebar entry it belongs to (e.g. /releases/[version]). --}}
@input source: string = ''
{{-- The page's own address, when path names its sidebar entry instead (e.g. /releases/0.7.0 under /releases). --}}
@input url: string = ''
{{-- The page's h2/h3 for "On this page" (Markdown pages pass them; none: the region is left out). --}}
@input headings: Heading[] = []
{{-- A tool (a playground) rather than a page: the header and a full-height main, without sidebar, crumb or footers. --}}
@input app: boolean = false

<html lang="en">
  <head>
    <pageHead [config]="config" [title]="title" [description]="description" [url]="url || path" />
  </head>
  <body>
    {{-- First in the tab order: keyboard and screen reader users jump past the header and page list. --}}
    <a class="skip-link" href="#content">Skip to content</a>
    <siteHeader [config]="config" [path]="path" [app]="app">@slot('end') {<slot name="header-end"></slot>}</siteHeader>
    @if (app) {
      <main class="content app" id="content" tabindex="-1"><slot /></main>
    } @else if (sectionKey(config.sections, path)) {
      <div class="docs">
        {{-- A drawer below 1024px (popover: Escape and a click outside close it), always visible from 1024px. --}}
        <docsSidebar [config]="config" [path]="path">@slot('top') {<slot name="sidebar-top"></slot>}@slot('bottom') {<slot name="sidebar-bottom"></slot>}</docsSidebar>
        {{-- tabindex -1: the skip link (and navigation) can move focus here. --}}
        <main class="content" id="content" tabindex="-1">
          <p class="crumb">{{ crumb(config.sections, path) }}</p>
          <pageContents [headings]="headings" [inline]="true" />
          <slot name="content-top"></slot>
          <slot />
          <slot name="content-bottom"></slot>
          <pageFooter [config]="config" [path]="path" [source]="source" />
        </main>
        <pageContents [headings]="headings" />
      </div>
    } @else {
      <main class="content home" id="content" tabindex="-1"><slot /></main>
    }
    @if (!app) {
      <siteFooter [config]="config"><slot name="footer">@if (config.footer) {<p>{{ config.footer }}</p>}</slot></siteFooter>
    }
  </body>
</html>
