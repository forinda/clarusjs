{{--
  The docs layout. Four regions at every width (header, sidebar, content, on this page); only how they show changes:
  below 1024px the sidebar is a drawer (native popover: no JavaScript) and "On this page" a collapsible box, from
  1024px the sidebar is always there, from 1280px "On this page" is a column. Everything site-specific comes from config.
  Slots: sidebar-top, sidebar-bottom, content-top, content-bottom, footer.
--}}
@import themeToggle from './theme-toggle.tscl'
@import pageTransitions from './view-transitions.tscl'
@import siteSearch from './search.tscl'
@import pageHead from './page-head.tscl'
@import learnStatus from './learn-status.tscl'
@import type { ThemeConfig, Heading } from './nav.ts'
@import { sectionKey, groupsOf, crumb, pager, editHref, updatedOf, lessonsOf } from './nav.ts'
@import './theme.css'
@input config: ThemeConfig
@input title: string
@input description: string = ''
@input path: string = '/'
{{-- The page's own route, when it differs from the sidebar entry it belongs to (e.g. /releases/[version]). --}}
@input source: string = ''
{{-- The page's own address, when path names its sidebar entry instead (e.g. /releases/0.7.0 under /releases). --}}
@input url: string = ''
{{-- The page's h2/h3 for "On this page" (Markdown pages pass them; none: the region is left out). --}}
@input headings: Heading[] = []

<html lang="en">
  <head><pageHead [config]="config" [title]="title" [description]="description" [url]="url || path" /></head>
  <body>
    {{-- First in the tab order: keyboard and screen reader users jump past the header and page list. --}}
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      @if (sectionKey(config.sections, path)) {
        <button type="button" class="menu-button" popovertarget="sidebar" aria-label="Open menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
      }
      <a class="brand" href="/">@if (config.brand.logo) {<img [src]="config.brand.logo" alt="" width="28" height="28">}<span>{{ config.brand.text }}@if (config.brand.accent) {<span class="js">{{ config.brand.accent }}</span>}</span></a>
      <nav class="top-nav" aria-label="Main">
        @for (s of config.sections; track s.key) {<a [href]="s.href" [aria-current]="sectionKey(config.sections, path) === s.key ? 'true' : false">{{ s.title }}</a>}
      </nav>
      <div class="header-end">
        {{-- On Learn pages: the XP chip, and the sidebar's lessons marked done, current or locked. --}}
        @if (config.learn && sectionKey(config.sections, path) === config.learn.section) {<learnStatus [lessons]="lessonsOf(config).map((l) => l.href)" [progress]="config.learn.progress" />}
        {{-- Kept across fragment navigations, like the theme toggle: its shortcut listener is added once. --}}
        @if (config.search) {<span class="persist" data-cl-persist="search"><siteSearch /></span>}
        @if ((config.social ?? []).length) {
          <span class="social">
            @for (link of config.social ?? []; track link.href) {
              <a [href]="link.href" [aria-label]="link.label" [title]="link.label">
                @if (link.icon === 'github') {<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>} @else if (link.icon === 'npm') {<span class="npm" aria-hidden="true">npm</span>} @else {<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>}
              </a>
            }
          </span>
          {{-- When the header runs out of room, the social links fold into this menu (native popover). --}}
          <button type="button" class="more-button" popovertarget="more" aria-label="More links">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="12" r="2"></circle></svg>
          </button>
          <div id="more" class="more" popover>
            @for (link of config.social ?? []; track link.href) {<a [href]="link.href">{{ link.label }}</a>}
          </div>
        }
        {{-- Kept across fragment navigations: the same element, with its state. --}}
        <span class="persist" data-cl-persist="theme"><themeToggle /></span>
        @if (config.viewTransitions) {<span class="persist" data-cl-persist="view-transitions"><pageTransitions /></span>}
      </div>
    </header>
    @if (sectionKey(config.sections, path)) {
      <div class="docs">
        {{-- A drawer below 1024px (popover: Escape and a click outside close it), always visible from 1024px. --}}
        <nav id="sidebar" class="sidebar" aria-label="Pages" popover>
          <div class="sidebar-head">
            <span>{{ config.brand.text }}{{ config.brand.accent ?? '' }}</span>
            <button type="button" popovertarget="sidebar" popovertargetaction="hide" aria-label="Close the menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
          </div>
          <slot name="sidebar-top"></slot>
          @for (group of groupsOf(config.sections, path); track group.title) {
            <p class="group">{{ group.title }}</p>
            <ul>
              @for (item of group.items; track item.href) {<li><a [href]="item.href" [aria-current]="item.href === path ? 'page' : false">{{ item.title }}</a></li>}
            </ul>
          }
          <slot name="sidebar-bottom"></slot>
          {{-- On phones, the header's links live here. --}}
          <div class="sidebar-links">
            @for (s of config.sections; track s.key) {<a [href]="s.href">{{ s.title }}</a>}
            @for (link of config.social ?? []; track link.href) {<a [href]="link.href">{{ link.label }}</a>}
          </div>
        </nav>
        {{-- tabindex -1: the skip link (and navigation) can move focus here. --}}
        <main class="content" id="content" tabindex="-1">
          <p class="crumb">{{ crumb(config.sections, path) }}</p>
          @if (headings.length) {
            <details class="toc-inline">
              <summary>On this page</summary>
              <ul>@for (h of headings; track h.id) {<li [class]="h.level === 3 ? 'sub' : false"><a [href]="'#' + h.id">{{ h.text }}</a></li>}</ul>
            </details>
          }
          <slot name="content-top"></slot>
          <slot />
          <slot name="content-bottom"></slot>
          <footer class="page-footer">
            @if (editHref(config, source || path)) {<a class="edit" [href]="editHref(config, source || path)">Edit this page on GitHub</a>}
            @if (updatedOf(config, source || path)) {<p class="updated">Last updated <time [datetime]="updatedOf(config, source || path)?.iso">{{ updatedOf(config, source || path)?.text }}</time></p>}
            <nav class="pager" aria-label="Previous and next">
              @if (pager(config.sections, path).prev.href) {<a class="prev" [href]="pager(config.sections, path).prev.href"><small>Previous</small>{{ pager(config.sections, path).prev.title }}</a>}
              @if (pager(config.sections, path).next.href) {<a class="next" [href]="pager(config.sections, path).next.href"><small>Next</small>{{ pager(config.sections, path).next.title }}</a>}
            </nav>
          </footer>
        </main>
        @if (headings.length) {
          <aside class="toc" aria-label="On this page">
            <p>On this page</p>
            <ul>@for (h of headings; track h.id) {<li [class]="h.level === 3 ? 'sub' : false"><a [href]="'#' + h.id">{{ h.text }}</a></li>}</ul>
          </aside>
        }
      </div>
    } @else {
      <main class="content home" id="content" tabindex="-1"><slot /></main>
    }
    <footer class="site-footer"><slot name="footer">@if (config.footer) {<p>{{ config.footer }}</p>}</slot></footer>
  </body>
</html>
