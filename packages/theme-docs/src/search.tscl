{{--
  Search: a button in the header (and Ctrl/⌘K or /) opens a modal dialog. A native <dialog>: focus stays inside it,
  Escape closes it and focus goes back. Arrow keys move through the results, Enter opens one. The index is the one
  themeDocs() writes at build time; a query fetches only the files it needs.
--}}

<script>
  import { navigate } from 'clarusjs/navigation'
  import { base, search } from './search.js'
  let query = state('')
  let results = state([])
  let active = state(0)
  let searched = state(false)
  const status = derived(() =>
    !searched
      ? ''
      : results.length === 0
        ? 'No results for "' + query + '"'
        : results.length === 1
          ? '1 result'
          : results.length + ' results',
  )
  const load = (file) => fetch(base + 'search/' + file).then((r) => (r.ok ? r.json() : {}))
  let latest = 0
  async function run(value) {
    query = value
    const mine = ++latest
    const found = value.trim() ? await search(value, load, 8) : []
    if (mine !== latest) return // a newer query already answered
    results = found
    active = 0
    searched = value.trim() !== ''
  }
  const dialog = () => {
    const d = document.querySelector('.search-dialog')
    return d instanceof HTMLDialogElement ? d : null
  }
  function open() {
    const d = dialog()
    if (!d || d.open) return
    d.showModal()
    d.querySelector('input')?.select()
  }
  function move(by) {
    if (!results.length) return
    active = (active + by + results.length) % results.length
    document.getElementById('search-result-' + active)?.scrollIntoView({ block: 'nearest' })
  }
  function key(event) {
    if (event.key === 'ArrowDown') {
      event.preventDefault()
      move(1)
    } else if (event.key === 'ArrowUp') {
      event.preventDefault()
      move(-1)
    } else if (event.key === 'Enter' && results.length) {
      event.preventDefault()
      dialog()?.close()
      navigate(results[active].u)
    }
    // One Escape closes (a search field would only clear itself first).
    else if (event.key === 'Escape') {
      event.preventDefault()
      dialog()?.close()
    }
  }
  if (typeof document !== 'undefined') {
    document.addEventListener('keydown', (event) => {
      const typing =
        event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable]')
      if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
        event.preventDefault()
        open()
      }
    })
  }
</script>

<div class="search">
  <button type="button" class="search-button" aria-haspopup="dialog" (click)="open()">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
    <span class="search-label">Search</span>
    <kbd aria-hidden="true">⌘K</kbd>
  </button>
  {{-- A click on the backdrop (the dialog itself, outside its box) closes it; so does choosing a result. --}}
  <dialog
    class="search-dialog"
    aria-label="Search the docs"
    (click)="($event.target.matches('dialog') || $event.target.closest('a')) && dialog()?.close()"
  >
    <div class="search-box">
      <input
        type="search"
        role="combobox"
        aria-label="Search the docs"
        aria-controls="search-results"
        aria-autocomplete="list"
        [aria-expanded]="results.length ? 'true' : 'false'"
        [aria-activedescendant]="results.length ? 'search-result-' + active : false"
        placeholder="Search the docs"
        autocomplete="off"
        spellcheck="false"
        (input)="run($event.target.value)"
        (keydown)="key($event)"
      />
      <p class="search-status" role="status">{{ status }}</p>
      <ul id="search-results" role="listbox" aria-label="Results">
        @for (r of results; track r.u) {
          <li [id]="'search-result-' + $index" role="option" [aria-selected]="$index === active ? 'true' : 'false'">
            <a [href]="r.u" tabindex="-1"
              ><span class="search-heading">{{ r.h }}</span
              >@if (r.h !== r.p) {<span class="search-page">{{ r.p }}</span>}<span class="search-text">{{ r.t }}</span></a
            >
          </li>
        }
      </ul>
    </div>
  </dialog>
</div>
