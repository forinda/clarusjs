{{--
  Editor toolbar (@clarusjs/editor): the buttons inside it (<editor-tool>, or your own with data-command) run commands
  on the field named by [field]; aria-pressed and disabled follow the selection; one tab stop, arrow keys between.

  <editor-toolbar [field]="'msg'">
    <editor-tool command="bold" label="Bold">B</editor-tool>
    <editor-tool command="italic" label="Italic">I</editor-tool>
  </editor-toolbar>

  Headless: data-part="toolbar".
--}}
@input field: string
@input label: string = 'Formatting'

<script>
  import { onEditor } from '@clarusjs/editor/registry'
  import { toolbar } from '@clarusjs/editor/toolbar'
  const wire = (el) => onEditor(field, (_editor, fieldEl) => toolbar(el, { editor: fieldEl }))
</script>

<div data-part="toolbar" role="toolbar" [aria-label]="label" [use]="wire"><slot /></div>
