{
  // The browser runtime, compiled again with its comments: apps bundle (and minify) it, and Vite reads magic
  // comments such as /* @vite-ignore */ in it. The rest of dist/ is built without comments (tsconfig.build.json).
  "extends": "./tsconfig.build.json",
  "compilerOptions": { "declaration": false },
  "include": ["src/runtime"]
}
