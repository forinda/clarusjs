{{-- #430: a page that loads its posts on the server, at render. Nothing ships: it isn't an island. --}}
@input limit: number = 3

<script server>
  const res = await fetch('https://jsonplaceholder.typicode.com/posts')
  const posts = (await res.json()).slice(0, limit)
</script>

<h1>Latest posts</h1>
@for (post of posts; track post.id) {
  <h2>{{ post.title }}</h2>
}
