{
  "name": "clarusjs",
  "version": "0.8.0",
  "description": "Clear, compiled views: templates compiled to server HTML, with JavaScript only for interactive islands. SSR, SSG and CSR from one component model, built on Vite.",
  "license": "MIT",
  "keywords": [
    "clarusjs",
    "framework",
    "compiler",
    "templates",
    "ssr",
    "ssg",
    "islands",
    "partial-hydration",
    "signals",
    "vite",
    "vite-plugin",
    "html-first",
    "typescript"
  ],
  "homepage": "https://clarusjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/clarusjs.git",
    "directory": "packages/clarusjs"
  },
  "bugs": {
    "url": "https://github.com/forinda/clarusjs/issues"
  },
  "type": "module",
  "exports": {
    "./compiler": "./src/compiler/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/server": "./src/runtime/server.ts",
    "./server": "./src/server/handler.ts",
    "./vite": "./src/vite/plugin.ts",
    "./manifest": "./src/server/manifest.ts",
    "./views": "./src/server/views.ts"
  },
  "bin": {
    "clarusjs": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "commander": "^15.1.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./compiler": {
        "types": "./dist/compiler/index.d.ts",
        "default": "./dist/compiler/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "./runtime/server": {
        "types": "./dist/runtime/server.d.ts",
        "default": "./dist/runtime/server.js"
      },
      "./server": {
        "types": "./dist/server/handler.d.ts",
        "default": "./dist/server/handler.js"
      },
      "./vite": {
        "types": "./dist/vite/plugin.d.ts",
        "default": "./dist/vite/plugin.js"
      },
      "./manifest": {
        "types": "./dist/server/manifest.d.ts",
        "default": "./dist/server/manifest.js"
      },
      "./views": {
        "types": "./dist/server/views.d.ts",
        "default": "./dist/server/views.js"
      }
    }
  }
}
