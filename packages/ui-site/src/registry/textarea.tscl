{{-- Textarea: a native <textarea>. Every <textarea> attribute you pass (name, placeholder, required, disabled…),
     and id, class, style, aria-* and data-*, land on it. value is its text. --}}
@input rows: number = 3
@input value: string = ''

@extends textarea

<textarea [rows]="rows" data-part="textarea">{{ value }}</textarea>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      box-sizing: border-box;
      width: 100%;
      padding: 8px 12px;
      border: 1px solid var(--ui-input);
      border-radius: var(--ui-radius);
      background: var(--ui-bg);
      color: var(--ui-fg);
      font: var(--ui-font-size)/1.5 var(--ui-font);
      resize: vertical;
    }
    :where(:scope)::placeholder {
      color: var(--ui-muted);
    }
    :where(:scope:focus-visible) {
      outline: 2px solid var(--ui-ring);
      outline-offset: 1px;
    }
    :where(:scope[aria-invalid='true']) {
      border-color: var(--ui-danger);
    }
    :where(:scope:disabled) {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }
</style>
