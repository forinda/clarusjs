{{--
  Login: a page that signs people in with email and password. The rules and the handler are in data.ts beside it:
  replace signIn with your own. Errors show on their fields after a submit, the first one focused; signIn runs as an
  action() (clarusjs/fetch): the button waits while it runs, and a failed call shows an alert. Copy it into
  src/pages/ (as login.tscl) and the components it imports into src/components/ui/.
--}}
@import uiCard from '~/components/ui/card.tscl'
@import uiField from '~/components/ui/field.tscl'
@import uiButton from '~/components/ui/button.tscl'

<script>
  import { action } from 'clarusjs/fetch'
  import { signIn, validateLogin } from './data.ts'
  let email = state('')
  let password = state('')
  let tried = state(false)
  // The call: pending while it runs, one at a time, its answer in .result and a thrown error in .error. The
  // credentials it sent are kept, so its errors stand only while those are unchanged; the first one is focused.
  let sent = state({ email: '', password: '' })
  const login = action(async (_, { signal }) => {
    sent = { email, password }
    const answer = await signIn({ email, password }, { signal })
    const first = Object.keys(answer.errors ?? {})[0]
    // After the answer is shown (showing it renders the fields again): the next frame.
    if (first) requestAnimationFrame(() => document.getElementById('login-' + first)?.focus())
    return answer
  })
  const server = () => (email === sent.email && password === sent.password ? (login.result?.errors ?? {}) : {})
  // This page's own rules first: an old answer never hides what's wrong now.
  const errors = () => ({ ...server(), ...validateLogin({ email, password }) })
  function submit(event) {
    event.preventDefault()
    tried = true
    const found = validateLogin({ email, password })
    if (Object.keys(found).length) return document.getElementById('login-' + Object.keys(found)[0])?.focus()
    login.run()
  }
</script>

<cl-head>
  <title>Sign in</title>
</cl-head>

<main class="login" aria-labelledby="login-title">
  <uiCard>
    @slot('header') {
      <h1 id="login-title" class="login-title">Sign in to your account</h1>
      <p class="login-lead">Enter your email and password.</p>
    }
    <form class="login-form" novalidate (submit)="submit($event)">
      <uiField
        id="login-email"
        label="Email"
        type="email"
        name="email"
        placeholder="you@example.com"
        [error]="errors().email ?? ''"
        [show]="tried"
        [(value)]="email"
      />
      <uiField
        id="login-password"
        label="Password"
        type="password"
        name="password"
        [error]="errors().password ?? ''"
        [show]="tried"
        [(value)]="password"
      />
      <a class="login-forgot" href="#">Forgot password?</a>
      @if (login.error) {
        <p class="login-alert" role="alert">Couldn't sign in. Check your connection and try again.</p>
      }
      <uiButton type="submit" [disabled]="login.pending">{{ login.pending ? 'Signing in…' : 'Sign in' }}</uiButton>
      <p class="login-status" role="status">
        {{ login.result?.user ? 'Signed in as ' + login.result.user + '.' : '' }}
      </p>
    </form>
    @slot('footer') {
      <p class="login-footer">Don't have an account? <a href="#">Sign up</a></p>
    }
  </uiCard>
</main>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: grid;
      place-items: center;
      min-height: 100vh;
      padding: var(--ui-space-6) var(--ui-space-4);
      background: var(--ui-muted-bg);
      color: var(--ui-fg);
      font: var(--ui-font-size) var(--ui-font);
    }
    :where(:scope [data-part='card']) {
      width: 100%;
      max-width: 400px;
    }
  }
</style>

<style global>
  /* What sits inside the card: global (a block's scoped rules stop at the card), on login- classes, zero specificity. */
  @layer theme, base, components, utilities;
  @layer components {
    :where(.login-title) {
      margin: 0;
      font-size: calc(var(--ui-font-size) * 1.5);
    }
    :where(.login-lead),
    :where(.login-footer) {
      margin: 0;
      color: var(--ui-muted);
    }
    :where(.login-footer) {
      text-align: center;
      width: 100%;
    }
    :where(.login-form) {
      display: grid;
      gap: var(--ui-space-4);
    }
    :where(.login-form [data-part='field']) {
      max-width: none;
    }
    :where(.login-form [data-part='button']) {
      width: 100%;
    }
    :where(.login-form a),
    :where(.login-footer a) {
      color: var(--ui-fg);
      text-underline-offset: 2px;
    }
    :where(.login-forgot) {
      justify-self: end;
      margin-top: calc(var(--ui-space-2) * -1);
      font-size: calc(var(--ui-font-size) - 1px);
    }
    :where(.login-status) {
      margin: 0;
    }
    :where(.login-status:empty) {
      display: none;
    }
    :where(.login-alert) {
      margin: 0;
      color: var(--ui-danger);
    }
  }
</style>
