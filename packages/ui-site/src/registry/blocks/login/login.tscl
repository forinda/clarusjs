{{--
  Login: a page that signs people in with email and password. The form is login-form.tscl beside it, its rules and
  the call it makes in data.ts: replace signIn with your own. Copy the page into src/pages/ (as login.tscl), the
  other two beside it, and the components they import into src/components/ui/. The page brings its own
  <toastRegion />: drop it if your layout has one.
--}}
@import uiCard from '~/components/ui/card.tscl'
@import loginForm from './login-form.tscl'
@import '~/components/ui/toast.css'
@import toastRegion from '@clarusjs/ui-primitives/toast-region.tscl'

<cl-head>
  <title>Sign in</title>
</cl-head>

<main class="login" aria-labelledby="login-title">
  <uiCard>
    @slot('header') {
      <h1 id="login-title" class="login-title">Sign in to your account</h1>
      <p class="login-lead">Enter your email and password.</p>
    }
    <loginForm />
    @slot('footer') {
      <p class="login-footer">Don't have an account? <a href="#">Sign up</a></p>
    }
  </uiCard>
  <toastRegion label="Sign-in messages" />
</main>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: grid;
      place-items: center;
      min-height: 100vh;
      padding: var(--ui-space-6) var(--ui-space-4);
      background: var(--ui-muted-bg);
      color: var(--ui-fg);
      font: var(--ui-font-size) var(--ui-font);
    }
    :where(:scope [data-part='card']) {
      width: 100%;
      max-width: 400px;
    }
  }
</style>

<style global>
  /* What sits inside the card: global (a block's scoped rules stop at the card), on login- classes, zero specificity. */
  @layer theme, base, components, utilities;
  @layer components {
    :where(.login-title) {
      margin: 0;
      font-size: calc(var(--ui-font-size) * 1.5);
    }
    :where(.login-lead),
    :where(.login-footer) {
      margin: 0;
      color: var(--ui-muted);
    }
    :where(.login-footer) {
      text-align: center;
      width: 100%;
    }
    :where(.login-form) {
      display: grid;
      gap: var(--ui-space-4);
    }
    :where(.login-form [data-part='field']) {
      max-width: none;
    }
    :where(.login-form [data-part='button']) {
      width: 100%;
    }
    :where(.login-form a),
    :where(.login-footer a) {
      color: var(--ui-fg);
      text-underline-offset: 2px;
    }
    :where(.login-forgot) {
      justify-self: end;
      margin-top: calc(var(--ui-space-2) * -1);
      font-size: calc(var(--ui-font-size) - 1px);
    }
  }
</style>
