@import uiInputGroup from './input-group.tscl'
@import uiInput from './input.tscl'

<script>
  let shown = state(false)
  // Nothing inside the group is bound: a binding there would render the group again, and replace the input with
  // what was typed. The input's type and the button's state change in place.
  function toggle(event) {
    shown = !shown
    const input = document.getElementById('password-demo')
    if (input instanceof HTMLInputElement) input.type = shown ? 'text' : 'password'
    const button = event.target.closest('button')
    button?.setAttribute('aria-pressed', String(shown))
    button?.setAttribute('aria-label', shown ? 'Hide password' : 'Show password')
  }
</script>

<div class="demo">
  <uiInputGroup>
    <uiInput id="password-demo" type="password" aria-label="Password" autocomplete="new-password" />
    @slot('end') {
      <button type="button" class="reveal" aria-label="Show password" aria-pressed="false" (click)="toggle($event)">
        <span class="reveal-show"><icon name="lucide:eye" /></span
        ><span class="reveal-hide"><icon name="lucide:eye-off" /></span>
      </button>
    }
  </uiInputGroup>
</div>

<style scoped>
  :scope {
    display: grid;
    max-width: 28rem;
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
</style>
<style global>
  .reveal {
    display: grid;
    place-items: center;
    padding: var(--ui-space-1);
    border: 0;
    border-radius: calc(var(--ui-radius) - 2px);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .reveal[aria-pressed='true'] .reveal-show,
  .reveal[aria-pressed='false'] .reveal-hide {
    display: none;
  }
  .reveal:focus-visible {
    outline: 2px solid var(--ui-ring);
  }
</style>
