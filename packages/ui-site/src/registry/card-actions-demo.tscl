@import uiCard from './card.tscl'
@import uiButton from './button.tscl'

<div class="demo example">
  <uiCard>
    @slot('header') {
      <h3 class="card-title">Invite your team</h3>
      <p class="card-muted">They'll get an email with a link.</p>
    }
    <p class="card-muted">3 seats left on your plan.</p>
    @slot('footer') {
      <uiButton variant="outline">Later</uiButton>
      <uiButton>Invite</uiButton>
    }
  </uiCard>
  <uiCard>
    @slot('header') {
      <h3 class="card-title">Delete project</h3>
      <p class="card-muted">This removes its files for everyone.</p>
    }
    @slot('footer') {
      <uiButton variant="destructive">Delete</uiButton>
    }
  </uiCard>
</div>

