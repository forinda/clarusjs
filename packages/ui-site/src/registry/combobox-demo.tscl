@import './combobox.css'
@import uiCombobox from '@clarusjs/ui-primitives/combobox.tscl'

<script>
  let fruit = state('')
  const fruits = [
    { value: 'apple', label: 'Apple' },
    { value: 'banana', label: 'Banana' },
    { value: 'cherry', label: 'Cherry' },
    { value: 'grape', label: 'Grape' },
  ]
</script>

<div class="demo">
  <uiCombobox [id]="'demo-fruit'" [label]="'Fruit'" [options]="fruits" [(value)]="fruit" />
  <p>
    Picked: <span class="out">{{ fruit }}</span>
  </p>
</div>

