@import uiInput from './input.tscl'
@import uiLabel from './label.tscl'

<div class="demo">
  <uiLabel control="demo-email">Email</uiLabel>
  <uiInput id="demo-email" type="email" placeholder="you@example.com" autocomplete="email" />
  <uiLabel control="demo-code">Invite code</uiLabel>
  <uiInput id="demo-code" value="ABC" aria-invalid="true" aria-describedby="demo-code-error" />
  <p id="demo-code-error" class="error">That code has expired.</p>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  .error {
    margin: 0;
    color: var(--ui-danger);
    font-size: 13px;
  }
</style>
