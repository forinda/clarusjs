@import uiScrollArea from './scroll-area.tscl'

<script server>
  const tags = Array.from({ length: 40 }, (_, i) => `v1.${40 - i}.0`)
</script>

<div class="demo">
  <uiScrollArea label="Tags" class="scroll-tags">
    <p class="scroll-head">Tags</p>
    @for (tag of tags; track tag) {
      <p>{{ tag }}</p>
    }
  </uiScrollArea>
</div>

<style scoped>
  :scope {
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
</style>

