@import './tooltip.css'
@import uiTooltip from '@clarusjs/ui-primitives/tooltip.tscl'
@import uiTooltipTrigger from '@clarusjs/ui-primitives/tooltip-trigger.tscl'

<div class="demo">
  <uiTooltipTrigger target="demo-tip">Copy link</uiTooltipTrigger>
  <uiTooltip id="demo-tip" side="bottom">Copies the page's address</uiTooltip>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    justify-items: start;
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
