@import './dialog.css'
@import uiAlertDialog from './alert-dialog.tscl'
@import uiDialogTrigger from '@clarusjs/ui-primitives/dialog-trigger.tscl'
@import uiDialogClose from '@clarusjs/ui-primitives/dialog-close.tscl'

<div class="demo">
  <uiDialogTrigger target="demo-delete">Delete project…</uiDialogTrigger>
  <uiAlertDialog id="demo-delete">
    @slot('title') {
      Delete this project?
    }
    Its files and history go with it. This can't be undone.
    @slot('actions') {
      <uiDialogClose target="demo-delete">Cancel</uiDialogClose>
      <uiDialogClose target="demo-delete">Delete</uiDialogClose>
    }
  </uiAlertDialog>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    justify-items: start;
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
