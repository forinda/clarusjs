{{-- Button: a native <button>, or a link (<a>) with the same look when href is set. class, style, id, aria-*,
     data-* and (click) (any DOM event that bubbles; (focusin) for focus) you pass reach it. loading shows a spinner
     and disables it (aria-busy); block fills its container; shape round or circle (an icon alone: give it an
     aria-label). An icon goes where you put it in the content, before or after the text. --}}
@input variant: 'default' | 'secondary' | 'outline' | 'dashed' | 'ghost' | 'destructive' | 'link' = 'default'
@input size: 'sm' | 'md' | 'lg' = 'md'
@input type: 'button' | 'submit' | 'reset' = 'button'
@input disabled: boolean = false
@input href: string = ''
@input loading: boolean = false
@input block: boolean = false
@input shape: 'default' | 'round' | 'circle' = 'default'

@if (href) {
  <a
    [href]="href"
    data-part="button"
    [data-variant]="variant"
    [data-size]="size"
    [data-block]="block ? 'true' : false"
    [data-shape]="shape === 'default' ? false : shape"
    ><slot
  /></a>
} @else {
  <button
    [type]="type"
    data-part="button"
    [data-variant]="variant"
    [data-size]="size"
    [data-block]="block ? 'true' : false"
    [data-shape]="shape === 'default' ? false : shape"
    [aria-busy]="loading ? 'true' : false"
    [disabled]="disabled || loading"
  >
    @if (loading) {<span data-part="button-spinner" aria-hidden="true"></span>}<slot />
  </button>
}

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: calc(var(--ui-space) * 1.5);
      min-height: 36px;
      padding: 0 calc(var(--ui-space) * 3.5);
      border: 1px solid transparent;
      border-radius: var(--ui-radius);
      background: var(--ui-accent);
      color: var(--ui-accent-fg);
      font: 600 var(--ui-font-size)/1 var(--ui-font);
      cursor: pointer;
    }
    :where(:scope:hover) {
      filter: brightness(1.08);
    }
    :where(:scope:focus-visible) {
      outline: 2px solid var(--ui-ring);
      outline-offset: 2px;
    }
    :where(:scope:disabled) {
      opacity: 0.5;
      cursor: not-allowed;
    }
    :where(:scope[data-variant='secondary']) {
      background: var(--ui-secondary);
      color: var(--ui-secondary-fg);
    }
    :where(:scope[data-variant='outline']) {
      background: var(--ui-bg);
      color: var(--ui-fg);
      border-color: var(--ui-border);
    }
    :where(:scope[data-variant='dashed']) {
      background: var(--ui-bg);
      color: var(--ui-fg);
      border-color: var(--ui-border);
      border-style: dashed;
    }
    :where(:scope[data-variant='dashed']:hover) {
      border-color: var(--ui-accent);
      color: var(--ui-accent);
      filter: none;
    }
    :where(:scope[data-variant='ghost']) {
      background: transparent;
      color: var(--ui-fg);
    }
    :where(:scope[data-variant='ghost']:hover),
    :where(:scope[data-variant='outline']:hover) {
      background: var(--ui-accent-soft);
      filter: none;
    }
    :where(:scope[data-variant='destructive']) {
      background: var(--ui-danger);
      color: var(--ui-danger-fg);
    }
    :where(:scope[data-variant='link']) {
      background: transparent;
      color: var(--ui-accent);
      text-decoration: underline;
      text-underline-offset: 3px;
      padding: 0;
      min-height: 0;
    }
    :where(:scope[data-size='sm']) {
      min-height: 30px;
      padding: 0 calc(var(--ui-space) * 2.5);
      font-size: calc(var(--ui-font-size) - 1px);
    }
    :where(:scope[data-size='lg']) {
      min-height: 44px;
      padding: 0 var(--ui-space-5);
      font-size: calc(var(--ui-font-size) + 2px);
    }
    :where(:scope[data-block='true']) {
      display: flex;
      width: 100%;
    }
    :where(:scope[data-shape='round']) {
      border-radius: 999px;
    }
    /* An icon alone: as wide as it is tall. */
    :where(:scope[data-shape='circle']) {
      width: 36px;
      padding: 0;
      border-radius: 50%;
    }
    :where(:scope[data-shape='circle'][data-size='sm']) {
      width: 30px;
    }
    :where(:scope[data-shape='circle'][data-size='lg']) {
      width: 44px;
    }
    :where(:scope[aria-busy='true']) {
      cursor: progress;
    }
    :where([data-part='button-spinner']) {
      width: 1em;
      height: 1em;
      border: 2px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: ui-button-spin 0.7s linear infinite;
    }
    @keyframes ui-button-spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      :where([data-part='button-spinner']) {
        animation-duration: 2s;
      }
    }
  }
</style>
