@import './popover.css'
@import uiPopover from '@clarusjs/ui-primitives/popover.tscl'
@import uiPopoverTrigger from '@clarusjs/ui-primitives/popover-trigger.tscl'

<div class="demo">
  <uiPopoverTrigger target="demo-popover">Share</uiPopoverTrigger>
  <uiPopover id="demo-popover" side="bottom" align="start">
    <p>Copy the link, or send it by email.</p>
  </uiPopover>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    justify-items: start;
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
