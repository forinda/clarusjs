{{-- Input: a native <input>. Every <input> attribute you pass (name, value, placeholder, required, disabled…),
     and id, class, style, aria-* and data-*, land on it. size sm or lg, or a data-size around it, sets its height. --}}
@input type: string = 'text'
@input size: '' | 'sm' | 'md' | 'lg' = ''

@extends input

<input [type]="type" data-part="text-input" [data-size]="size || false" />

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      box-sizing: border-box;
      width: 100%;
      min-height: var(--ui-control-md);
      padding: 0 var(--ui-space-3);
      border: 1px solid var(--ui-input);
      border-radius: var(--ui-radius);
      background: var(--ui-bg);
      color: var(--ui-fg);
      font: var(--ui-font-size) var(--ui-font);
    }
    :where(:scope)::placeholder {
      color: var(--ui-muted);
    }
    :where(:scope:focus-visible) {
      outline: 2px solid var(--ui-ring);
      outline-offset: 1px;
    }
    :where(:scope[aria-invalid='true']) {
      border-color: var(--ui-danger);
    }
    :where(:scope:disabled) {
      opacity: 0.5;
      cursor: not-allowed;
    }
    :where([data-size='sm'] :scope),
    :where(:scope[data-size='sm']) {
      min-height: var(--ui-control-sm);
      font-size: calc(var(--ui-font-size) - 1px);
    }
    :where([data-size='lg'] :scope),
    :where(:scope[data-size='lg']) {
      min-height: var(--ui-control-lg);
      font-size: calc(var(--ui-font-size) + 2px);
    }
  }
</style>
