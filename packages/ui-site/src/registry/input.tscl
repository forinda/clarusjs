{{-- Input: a native <input>. Every <input> attribute you pass (name, value, placeholder, required, disabled…),
     and id, class, style, aria-* and data-*, land on it. size sm or lg, or a data-size around it, sets its height.
     variant: outline (the default), filled, borderless or underlined. Error is aria-invalid; status="warning" warns. --}}
@input type: string = 'text'
@input size: '' | 'sm' | 'md' | 'lg' = ''
@input variant: 'outline' | 'filled' | 'borderless' | 'underlined' = 'outline'
@input status: '' | 'warning' = ''

@extends input

<input
  [type]="type"
  data-part="text-input"
  [data-size]="size || false"
  [data-variant]="variant === 'outline' ? false : variant"
  [data-status]="status || false"
/>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      box-sizing: border-box;
      width: 100%;
      min-height: var(--ui-control-h, var(--ui-control-md));
      padding: 0 var(--ui-space-3);
      border: 1px solid var(--ui-input);
      border-radius: var(--ui-radius);
      background: var(--ui-bg);
      color: var(--ui-fg);
      font: var(--ui-control-font, var(--ui-font-size)) var(--ui-font);
    }
    :where(:scope)::placeholder {
      color: var(--ui-muted);
    }
    :where(:scope:focus-visible) {
      outline: 2px solid var(--ui-ring);
      outline-offset: 1px;
    }
    :where(:scope[aria-invalid='true']) {
      border-color: var(--ui-danger);
    }
    :where(:scope[data-status='warning']) {
      border-color: var(--ui-warning);
    }
    :where(:scope[data-variant='filled']) {
      border-color: transparent;
      background: var(--ui-muted-bg);
    }
    :where(:scope[data-variant='borderless']) {
      border-width: 0;
      background: transparent;
    }
    /* A line under it, no box: the line takes the error and warning colours. */
    :where(:scope[data-variant='underlined']) {
      border-width: 0 0 1px;
      border-radius: 0;
      background: transparent;
      padding-inline: 0;
    }
    :where(:scope[data-variant='filled'][aria-invalid='true']),
    :where(:scope[data-variant='underlined'][aria-invalid='true']) {
      border-color: var(--ui-danger);
    }
    :where(:scope:read-only:not(:disabled)) {
      background: var(--ui-muted-bg);
    }
    :where(:scope:disabled) {
      opacity: 0.5;
      cursor: not-allowed;
    }
    /* In an input group, the group is the box. */
    :where([data-part='input-group'] > :scope) {
      flex: 1;
      min-width: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }
    :where([data-part='input-group'] > :scope:focus-visible) {
      outline: none;
    }
  }
</style>

<style global>
  /* Sizes: the nearest data-size (on the input, or on anything around it) sets these, and they inherit, so an input's
     own size wins over its row's. The same rules as the other controls'. */
  @layer theme, base, components, utilities;
  @layer components {
    :where([data-size='sm']) {
      --ui-control-h: var(--ui-control-sm);
      --ui-control-font: calc(var(--ui-font-size) - 1px);
    }
    :where([data-size='md']) {
      --ui-control-h: var(--ui-control-md);
      --ui-control-font: var(--ui-font-size);
    }
    :where([data-size='lg']) {
      --ui-control-h: var(--ui-control-lg);
      --ui-control-font: calc(var(--ui-font-size) + 2px);
    }
  }
</style>
