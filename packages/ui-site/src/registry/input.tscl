{{-- Input: a native <input>. id, aria-* (aria-invalid, aria-describedby) and data-* you pass land on it. --}}
@input type: string = 'text'
@input name: string = ''
@input value: string = ''
@input placeholder: string = ''
@input autocomplete: string = ''
@input required: boolean = false
@input disabled: boolean = false

<input
  [type]="type"
  [name]="name || null"
  [value]="value || null"
  [placeholder]="placeholder || null"
  [autocomplete]="autocomplete || null"
  [required]="required"
  [disabled]="disabled"
  data-part="text-input"
/>

<style scoped>
  :scope {
    box-sizing: border-box;
    width: 100%;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
    font: 14px var(--ui-font);
  }
  :scope::placeholder {
    color: var(--ui-muted);
  }
  :scope:focus-visible {
    outline: 2px solid var(--ui-accent);
    outline-offset: 1px;
  }
  :scope[aria-invalid='true'] {
    border-color: var(--ui-danger);
  }
  :scope:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
