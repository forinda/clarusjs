@import uiFileUpload from './file-upload.tscl'
{{-- One file: a new pick replaces the last. --}}

<div class="demo example">
  <uiFileUpload
    id="single-avatar"
    label="Profile picture"
    name="avatar"
    accept="image/png,image/jpeg"
    [multiple]="false"
  />
</div>

<style scoped>
  :scope {
    display: grid;
    max-width: 24rem;
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
</style>
