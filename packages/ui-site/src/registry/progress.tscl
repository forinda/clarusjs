{{-- Progress: a native <progress>. Without a value it is indeterminate (still working, amount unknown). --}}
@input value: number | null = null
@input max: number = 100
@input label: string = ''

<progress [max]="max" [value]="value" [aria-label]="label || null" data-part="progress"></progress>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      width: 100%;
      height: 8px;
      border: 0;
      border-radius: 999px;
      overflow: hidden;
      background: var(--ui-muted-bg);
      accent-color: var(--ui-accent);
      appearance: none;
    }
    :where(:scope)::-webkit-progress-bar {
      background: var(--ui-muted-bg);
    }
    :where(:scope)::-webkit-progress-value {
      background: var(--ui-accent);
      border-radius: 999px;
    }
    :where(:scope)::-moz-progress-bar {
      background: var(--ui-accent);
      border-radius: 999px;
    }
  }
</style>
