{{-- orientation="horizontal": a row wider than its box scrolls sideways; shadows show at the ends with more. --}}
<div class="demo example">
  <uiScrollArea label="Photos" orientation="horizontal" class="scroll-row">
    @for (work of works; track work) {
      <figure>
        <div></div>
        <figcaption>{{ work }}</figcaption>
      </figure>
    }
  </uiScrollArea>
</div>

