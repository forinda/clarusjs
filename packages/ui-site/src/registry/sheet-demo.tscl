@import './sheet.css'
@import uiDialog from '@clarusjs/ui-primitives/dialog.tscl'
@import uiDialogTrigger from '@clarusjs/ui-primitives/dialog-trigger.tscl'
@import uiDialogClose from '@clarusjs/ui-primitives/dialog-close.tscl'

<div class="demo">
  <uiDialogTrigger target="demo-sheet">Open filters</uiDialogTrigger>
  <uiDialog id="demo-sheet" data-side="right">
    @slot('title') {
      Filters
    }
    <p>Status, owner and date range.</p>
    <uiDialogClose target="demo-sheet">Done</uiDialogClose>
  </uiDialog>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 24px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
