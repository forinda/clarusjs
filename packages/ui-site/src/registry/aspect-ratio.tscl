{{-- Aspect ratio: a box that keeps its shape (ratio, '16/9' by default) as its width changes. --}}
@input ratio: string = '16/9'

<div data-part="aspect-ratio" [style]="'aspect-ratio: ' + ratio"><slot /></div>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: var(--ui-radius);
    }
    :where(:scope > img),
    :where(:scope > video),
    :where(:scope > iframe) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
