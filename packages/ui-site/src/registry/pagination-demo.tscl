@import uiPagination from './pagination.tscl'

{{-- On your site, href points at your list's pages ("/posts?page={page}") and the server renders the page asked for.
     This page is static, so the demo's links stay on it (#page-2): loading it again would change nothing. --}}
<div class="demo">
  <uiPagination [page]="1" [pages]="5" href="#page-{page}" />
  <uiPagination [page]="50" [pages]="100" href="#page-{page}" label="Archive pages" />
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
</style>
