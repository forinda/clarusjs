{{-- Alert: a message box with a title. [live]="true" makes it role="alert", for a message that appears after the page loads. --}}
@input variant: 'default' | 'destructive' | 'success' | 'warning' = 'default'
@input live: boolean = false

<div [role]="live ? 'alert' : null" data-part="alert" [data-variant]="variant">
  <p data-part="alert-title"><slot name="title" /></p>
  <div data-part="alert-description"><slot /></div>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 4px;
    padding: 12px 16px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
    font: var(--ui-font-size)/1.5 var(--ui-font);
  }
  :scope[data-variant='destructive'] {
    border-color: var(--ui-danger);
    color: var(--ui-danger);
  }
  :scope[data-variant='success'] {
    border-color: var(--ui-success);
    color: var(--ui-success);
  }
  :scope[data-variant='warning'] {
    border-color: var(--ui-warning);
    color: var(--ui-warning);
  }
  [data-part='alert-title'] {
    margin: 0;
    font-weight: 600;
  }
  [data-part='alert-title']:empty {
    display: none;
  }
</style>
