{{-- Pagination, in Tailwind classes (needs tailwind.css after theme.css): the same inputs and look as pagination.tscl.
     Copy it into src/components/ui/ as pagination.tscl. --}}
@input page: number
@input pages: number
@input href: string
@input label: string = 'Pagination'

<script server>
  const link = (n) => href.replaceAll('{page}', String(n))
  const list = 'flex flex-wrap gap-1 m-0 p-0 list-none font-sans text-(length:--ui-font-size) leading-[normal]'
  const box =
    'inline-flex items-center justify-center min-w-[36px] min-h-[36px] px-2.5 rounded-lg text-foreground no-underline'
  const anchor =
    box + ' hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2'
  const shown = new Set([1, pages, page - 1, page, page + 1].filter((n) => n >= 1 && n <= pages))
  if (pages <= 7) for (let n = 1; n <= pages; n++) shown.add(n)
  // Typed by its first shape, then emptied: a plain [] would type as never[].
  const items = [{ kind: 'page', n: 0, key: '' }].slice(0, 0)
  let previous = 0
  for (const n of [...shown].sort((a, b) => a - b)) {
    // An ellipsis stands for two or more pages; one missing page is shown as itself.
    if (n - previous === 2) items.push({ kind: n - 1 === page ? 'current' : 'page', n: n - 1, key: 'p-' + (n - 1) })
    else if (n - previous > 2) items.push({ kind: 'gap', n: 0, key: 'gap-' + n })
    items.push({ kind: n === page ? 'current' : 'page', n, key: 'p-' + n })
    previous = n
  }
</script>

<nav [aria-label]="label" data-part="pagination">
  <ul data-part="pagination-list" [class]="list">
    @if (page > 1) {
      <li><a [href]="link(page - 1)" rel="prev" data-part="pagination-prev" [class]="anchor">Previous</a></li>
    }
    @for (item of items; track item.key) {
      <li>
        @if (item.kind === 'gap') {
          <span aria-hidden="true" data-part="pagination-ellipsis" [class]="box + ' text-muted-foreground'">…</span>
        } @else if (item.kind === 'current') {
          <span
            aria-current="page"
            data-part="pagination-current"
            [class]="box + ' border border-border font-semibold'"
            >{{ item.n }}</span
          >
        } @else {
          <a [href]="link(item.n)" data-part="pagination-link" [class]="anchor">{{ item.n }}</a>
        }
      </li>
    }
    @if (page < pages) {
      <li><a [href]="link(page + 1)" rel="next" data-part="pagination-next" [class]="anchor">Next</a></li>
    }
  </ul>
</nav>
