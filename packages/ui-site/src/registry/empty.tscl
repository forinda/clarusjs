{{-- Empty: what to show when there's nothing yet: an icon, a title, a line of help, and an action. --}}

<div data-part="empty">
  <div aria-hidden="true" data-part="empty-icon"><slot name="icon" /></div>
  <p data-part="empty-title"><slot name="title" /></p>
  <div data-part="empty-description"><slot /></div>
  <div data-part="empty-action"><slot name="action" /></div>
</div>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: grid;
      justify-items: center;
      gap: var(--ui-space-2);
      padding: var(--ui-space-8) var(--ui-space-4);
      border: 1px dashed var(--ui-border);
      border-radius: var(--ui-radius);
      color: var(--ui-fg);
      font-family: var(--ui-font);
      text-align: center;
    }
    :where([data-part='empty-icon']) {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--ui-muted-bg);
      color: var(--ui-muted);
    }
    :where([data-part='empty-title']) {
      margin: 0;
      font: 600 calc(var(--ui-font-size) + 2px) var(--ui-font-heading);
    }
    :where([data-part='empty-description']) {
      max-width: 40ch;
      color: var(--ui-muted);
    }
    :where([data-part='empty-icon']:empty),
    :where([data-part='empty-title']:empty),
    :where([data-part='empty-description']:empty),
    :where([data-part='empty-action']:empty) {
      display: none;
    }
  }
</style>
