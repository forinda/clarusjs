{{-- Call to action, centred: one line of headline, a line under it and two buttons, on grid lines that bow toward the
     pointer (lean). Delete the <gridEffect> tag for no JavaScript. Its words and links are in data.ts beside it. --}}
@import uiButton from '~/components/ui/button.tscl'
@import gridBackdrop from '~/components/ui/grid-backdrop.tscl'
@import gridEffect from '~/components/ui/grid-effect.tscl'
@import { cta } from './data.ts'

<section class="cta">
  <gridBackdrop corners />
  <gridEffect effect="lean" />
  <div class="content">
    <h2>{{ cta.title }}</h2>
    <p>{{ cta.line }}</p>
    <div class="actions">
      <uiButton size="lg" [href]="cta.primary.href">{{ cta.primary.label }}</uiButton>
      <uiButton size="lg" variant="outline" [href]="cta.secondary.href">{{ cta.secondary.label }}</uiButton>
    </div>
  </div>
</section>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      position: relative;
      display: grid;
      place-items: center;
      padding: var(--ui-space-12) var(--ui-space-6);
      overflow: hidden;
      text-align: center;
      background: var(--ui-bg);
      color: var(--ui-fg);
      font-family: var(--ui-font);
    }
    :where(.content) {
      position: relative;
      z-index: 1;
      display: grid;
      justify-items: center;
      gap: var(--ui-space-5);
    }
    :where(h2) {
      max-width: 20ch;
      margin: 0;
      font: 700 clamp(calc(var(--ui-font-size) * 1.75), 4vw, calc(var(--ui-font-size) * 2.75)) / 1.1 var(--ui-font-heading);
      letter-spacing: -0.02em;
      text-wrap: balance;
    }
    :where(p) {
      max-width: 50ch;
      margin: 0;
      color: var(--ui-muted);
    }
    :where(.actions) {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--ui-space-3);
    }
  }
</style>
