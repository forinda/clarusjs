{{-- Features in a ruled grid: a heading over six cells divided by thin lines, each a feature with a link, and a soft
     light that follows the pointer across the grid (spotlight). Delete the <gridEffect> tag for no JavaScript. Its
     words, icons and links are in data.ts beside it. --}}
@import gridBackdrop from '~/components/ui/grid-backdrop.tscl'
@import gridEffect from '~/components/ui/grid-effect.tscl'
@import { features, items } from './data.ts'

<section class="features">
  <gridBackdrop />
  <gridEffect effect="spotlight" />
  <h2>{{ features.title }}</h2>
  <ul>
    @for (item of items; track item.title) {
      <li>
        <p class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path [d]="item.icon" /></svg>{{ item.title }}</p>
        <p class="text">{{ item.text }}</p>
        <a [href]="item.href" [aria-label]="'More about ' + item.title.toLowerCase()">→</a>
      </li>
    }
  </ul>
</section>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      position: relative;
      display: grid;
      gap: var(--ui-space-8);
      padding: var(--ui-space-12) var(--ui-space-6);
      overflow: hidden;
      background: var(--ui-bg);
      color: var(--ui-fg);
      font-family: var(--ui-font);
    }
    :where(h2), :where(ul) {
      position: relative;
      z-index: 1;
    }
    :where(h2) {
      max-width: 22ch;
      margin: 0;
      font: 700 calc(var(--ui-font-size) * 2) / 1.15 var(--ui-font-heading);
      letter-spacing: -0.02em;
    }
    :where(ul) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--ui-border);
      border-left: 1px solid var(--ui-border);
    }
    :where(li) {
      display: grid;
      gap: var(--ui-space-3);
      align-content: start;
      padding: var(--ui-space-6);
      border-right: 1px solid var(--ui-border);
      border-bottom: 1px solid var(--ui-border);
    }
    :where(.label) {
      display: flex;
      align-items: center;
      gap: var(--ui-space-2);
      margin: 0;
      font-size: calc(var(--ui-font-size) * 0.9);
      color: var(--ui-muted);
    }
    :where(svg) {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    :where(.text) {
      margin: 0;
      font: 600 calc(var(--ui-font-size) * 1.1) / 1.4 var(--ui-font-heading);
    }
    :where(a) {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border: 1px solid var(--ui-border);
      border-radius: 50%;
      background: var(--ui-bg);
      color: var(--ui-fg);
      text-decoration: none;
    }
    :where(a:hover) {
      background: var(--ui-muted-bg);
    }
  }
</style>
