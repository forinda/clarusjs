{{-- Testimonials in a grid: a heading over every quote in data.ts, each a card with who said it. No JavaScript. --}}
@import { quotes } from './data.ts'

<section class="testimonials">
  <h2>What teams say</h2>
  <ul>
    @for (q of quotes; track q.name) {
      <li>
        <figure>
          <blockquote><p>“{{ q.text }}”</p></blockquote>
          <figcaption><strong>{{ q.name }}</strong> <span>{{ q.role }}, {{ q.company }}</span></figcaption>
        </figure>
      </li>
    }
  </ul>
</section>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: grid;
      gap: var(--ui-space-8);
      padding: var(--ui-space-12) var(--ui-space-6);
      background: var(--ui-bg);
      color: var(--ui-fg);
      font-family: var(--ui-font);
    }
    :where(h2) {
      margin: 0;
      text-align: center;
      font: 700 calc(var(--ui-font-size) * 2) / 1.15 var(--ui-font-heading);
      letter-spacing: -0.02em;
    }
    :where(ul) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: var(--ui-space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    :where(figure) {
      display: grid;
      gap: var(--ui-space-4);
      height: 100%;
      margin: 0;
      padding: var(--ui-space-6);
      border: 1px solid var(--ui-border);
      border-radius: calc(var(--ui-radius) * 1.5);
      background: var(--ui-card);
    }
    :where(blockquote) {
      margin: 0;
    }
    :where(blockquote p) {
      margin: 0;
      line-height: 1.6;
    }
    :where(figcaption) {
      align-self: end;
      font-size: calc(var(--ui-font-size) * 0.9);
    }
    :where(figcaption span) {
      display: block;
      color: var(--ui-muted);
    }
  }
</style>
