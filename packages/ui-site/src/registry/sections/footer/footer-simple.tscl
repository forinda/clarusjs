{{-- Footer, simple: the copyright and one row of links. No JavaScript. Its links are in data.ts beside it. --}}
@import { brand, columns } from './data.ts'

<footer class="footer" aria-label="Site footer, simple">
  <p>{{ brand.copyright }}</p>
  <nav aria-label="Footer links">
    <ul>
      @for (l of columns.flatMap((c) => c.links).slice(0, 6); track l.href) {
        <li><a [href]="l.href">{{ l.label }}</a></li>
      }
    </ul>
  </nav>
</footer>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--ui-space-4);
      padding: var(--ui-space-6);
      border-top: 1px solid var(--ui-border);
      background: var(--ui-bg);
      color: var(--ui-muted);
      font-family: var(--ui-font);
      font-size: calc(var(--ui-font-size) * 0.9);
    }
    :where(p) {
      margin: 0;
    }
    :where(ul) {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ui-space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    /* A 24px touch target however small the font (WCAG 2.5.8). */
    :where(a) {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      color: var(--ui-muted);
      text-decoration: none;
    }
    :where(a:hover) {
      color: var(--ui-fg);
    }
  }
</style>
