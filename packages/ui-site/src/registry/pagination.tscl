{{-- Pagination: links to pages of a list. href is a pattern with {page}; long ranges keep the first, last and
     neighbours of the current page, with ellipses between. Plain links: no JavaScript. Two on one page need
     different labels. --}}
@input page: number
@input pages: number
@input href: string
@input label: string = 'Pagination'

<script server>
  const link = (n) => href.replaceAll('{page}', String(n))
  const shown = new Set([1, pages, page - 1, page, page + 1].filter((n) => n >= 1 && n <= pages))
  if (pages <= 7) for (let n = 1; n <= pages; n++) shown.add(n)
  const items = []
  let previous = 0
  for (const n of [...shown].sort((a, b) => a - b)) {
    if (n - previous > 1) items.push({ kind: 'gap', key: 'gap-' + n })
    items.push({ kind: n === page ? 'current' : 'page', n, key: 'p-' + n })
    previous = n
  }
</script>

<nav [aria-label]="label" data-part="pagination">
  <ul data-part="pagination-list">
    @if (page > 1) {
      <li><a [href]="link(page - 1)" rel="prev" data-part="pagination-prev">Previous</a></li>
    }
    @for (item of items; track item.key) {
      <li>
        @if (item.kind === 'gap') {
          <span aria-hidden="true" data-part="pagination-ellipsis">…</span>
        } @else if (item.kind === 'current') {
          <span aria-current="page" data-part="pagination-current">{{ item.n }}</span>
        } @else {
          <a [href]="link(item.n)" data-part="pagination-link">{{ item.n }}</a>
        }
      </li>
    }
    @if (page < pages) {
      <li><a [href]="link(page + 1)" rel="next" data-part="pagination-next">Next</a></li>
    }
  </ul>
</nav>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where([data-part='pagination-list']) {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin: 0;
      padding: 0;
      list-style: none;
      font: var(--ui-font-size) var(--ui-font);
    }
    :where([data-part='pagination-list'] a),
    :where([data-part='pagination-current']),
    :where([data-part='pagination-ellipsis']) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 36px;
      min-height: 36px;
      padding: 0 10px;
      border-radius: var(--ui-radius);
      color: var(--ui-fg);
      text-decoration: none;
    }
    :where([data-part='pagination-list'] a:hover) {
      background: var(--ui-accent-soft);
    }
    :where([data-part='pagination-list'] a:focus-visible) {
      outline: 2px solid var(--ui-ring);
      outline-offset: 2px;
    }
    :where([data-part='pagination-current']) {
      border: 1px solid var(--ui-border);
      font-weight: 600;
    }
    :where([data-part='pagination-ellipsis']) {
      color: var(--ui-muted);
    }
  }
</style>
