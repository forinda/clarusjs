{{-- Textarea: a native <textarea>. id, aria-* and data-* you pass land on it. --}}
@input rows: number = 3
@input name: string = ''
@input value: string = ''
@input placeholder: string = ''
@input required: boolean = false
@input disabled: boolean = false

<textarea
  [rows]="rows"
  [name]="name || null"
  [placeholder]="placeholder || null"
  [required]="required"
  [disabled]="disabled"
  data-part="textarea"
  >{{ value }}</textarea>

<style scoped>
  :scope {
    box-sizing: border-box;
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
    font: 14px/1.5 var(--ui-font);
    resize: vertical;
  }
  :scope::placeholder {
    color: var(--ui-muted);
  }
  :scope:focus-visible {
    outline: 2px solid var(--ui-accent);
    outline-offset: 1px;
  }
  :scope[aria-invalid='true'] {
    border-color: var(--ui-danger);
  }
  :scope:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
