{{-- Table: a native <table> in a region that scrolls sideways on small screens; keyboard users can scroll it too.
     Give it a caption or a label: that names the region for screen readers. --}}
@input caption: string = ''
@input label: string = ''

<div
  [role]="label || caption ? 'region' : null"
  [aria-label]="label || caption || null"
  tabindex="0"
  data-part="table-scroll"
>
  <table data-part="table">
    @if (caption) {
      <caption>
        {{
          caption
        }}
      </caption>
    }
    <slot />
  </table>
</div>

<style scoped>
  :scope {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
  }
  :scope:focus-visible {
    outline: 2px solid var(--ui-accent);
    outline-offset: 2px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    color: var(--ui-fg);
    font: 14px/1.5 var(--ui-font);
  }
  caption {
    padding: 8px 12px;
    color: var(--ui-muted);
    text-align: start;
  }
  th,
  td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--ui-border);
    text-align: start;
    white-space: nowrap;
  }
  th {
    font-weight: 600;
  }
  tr:last-child > td {
    border-bottom: 0;
  }
</style>
