  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: inline-block;
      min-width: 1.6em;
      padding: calc(var(--ui-space) * 0.25) calc(var(--ui-space) * 1.5);
      border: 1px solid var(--ui-border);
      border-bottom-width: 2px;
      border-radius: 4px;
      background: var(--ui-bg);
      color: var(--ui-fg);
      font: calc(var(--ui-font-size) - 2px)/1.5 var(--ui-font-mono);
      text-align: center;
    }
  }
</style>
