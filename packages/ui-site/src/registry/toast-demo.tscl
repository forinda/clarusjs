@import './toast.css'

<script>
  import { toast } from '@clarusjs/ui-primitives'
  let removed = state(0)
  const save = () => toast('Saved')
  function remove() {
    removed++
    toast('Project deleted', { action: { label: 'Undo', onClick: () => removed-- } })
  }
</script>

<div class="demo">
  <button type="button" (click)="save()">Save</button>
  <button type="button" (click)="remove()">Delete project</button>
  <p>
    Deleted: <span class="out">{{ removed }}</span>
  </p>
</div>

<style scoped>
  :scope {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding: 24px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
