{{-- Calendar, in Tailwind classes (needs tailwind.css after theme.css): the same inputs and look as calendar.tscl.
     Copy it into src/components/ui/ as calendar.tscl. --}}
@input id: string = 'calendar'
@input label: string = 'Calendar'
@input range: boolean = false
@input min: string = ''
@input max: string = ''
@input locale: string = 'en-US'
@input firstDay: number = 0
@model value: string = ''
@model end: string = ''
@event select: string

<script>
  import { effect } from 'clarusjs/runtime'
  import { addDays, addMonths, clamp, inRange, monthGrid, parseIso, today, weekStart } from './calendar-dates.ts'
  // The day the keyboard is on; its month is the one shown. Today is known in the browser only (a static page's
  // "today" would be the day it was built), so it's set once the calendar is live.
  // min and max may be 'today': the visitor's day, worked out in the browser (a static page's build day goes stale).
  const lo = () => (min === 'today' ? today() : min)
  const hi = () => (max === 'today' ? today() : max)
  let focus = state(clamp(value || today(), lo(), hi()))
  let now = state('')
  let hovered = state('')
  // A date set from outside (a shortcut, a reset) shows its month.
  let seen = value
  effect(() => {
    if (value === seen) return
    seen = value
    if (value) focus = clamp(value, lo(), hi())
  })
  const date = (iso, options) =>
    new Intl.DateTimeFormat(locale, { timeZone: 'UTC', ...options }).format(parseIso(iso) ?? undefined)
  const weeks = () => monthGrid(focus, firstDay)
  const days = () =>
    weeks()[0].map((d) => ({ short: date(d.iso, { weekday: 'short' }), long: date(d.iso, { weekday: 'long' }) }))
  const off = (iso) => (lo() !== '' && iso < lo()) || (hi() !== '' && iso > hi())
  const picked = (iso) => (range ? iso === value || iso === end : iso === value)
  // Between a start and an end (or, while choosing the end, the day under the pointer).
  const between = (iso) => range && value !== '' && inRange(iso, value, end || hovered || value) && !picked(iso)
  // The month and year lists: months by name in the locale; years within min and max, else a century back and
  // twenty years on (from this year, or the shown one if it's outside that).
  const months = () =>
    Array.from({ length: 12 }, (_, i) => ({
      value: i + 1,
      label: date(`2026-${String(i + 1).padStart(2, '0')}-01`, { month: 'long' }),
    }))
  const years = () => {
    const shown = Number(focus.slice(0, 4))
    const now = Number(today().slice(0, 4))
    const from = lo() ? Number(lo().slice(0, 4)) : Math.min(shown, now - 100)
    const to = hi() ? Number(hi().slice(0, 4)) : Math.max(shown, now + 20)
    return Array.from({ length: to - from + 1 }, (_, i) => to - i)
  }
  // To month m of year y, keeping the day (or the month's last), within the limits.
  function jump(y, m) {
    focus = clamp(addMonths(focus, (y - Number(focus.slice(0, 4))) * 12 + m - Number(focus.slice(5, 7))), lo(), hi())
  }
  function show(iso) {
    focus = iso
    requestAnimationFrame(() => document.getElementById(`${id}-${iso}`)?.focus())
  }
  function pick(iso) {
    if (off(iso)) return
    if (!range) value = iso
    else if (!value || end) {
      value = iso
      end = ''
    } else if (iso < value) {
      end = value
      value = iso
    } else end = iso
    focus = iso
    emit('select', iso)
  }
  function key(event) {
    const moves = {
      ArrowLeft: () => addDays(focus, -1),
      ArrowRight: () => addDays(focus, 1),
      ArrowUp: () => addDays(focus, -7),
      ArrowDown: () => addDays(focus, 7),
      PageUp: () => addMonths(focus, event.shiftKey ? -12 : -1),
      PageDown: () => addMonths(focus, event.shiftKey ? 12 : 1),
      Home: () => weekStart(focus, firstDay),
      End: () => addDays(weekStart(focus, firstDay), 6),
    }
    const move = moves[event.key]
    if (!move) return
    event.preventDefault()
    show(move())
  }
  function wire() {
    now = today()
  }
</script>

<div
  data-part="calendar"
  [data-range]="range ? 'true' : false"
  [use]="wire"
  class="
    inline-grid gap-2 p-3 text-foreground font-sans text-(length:--ui-font-size) leading-[normal]
    [&_[data-part=calendar-head]]:flex [&_[data-part=calendar-head]]:gap-1 [&_[data-part=calendar-head]]:items-center [&_[data-part=calendar-title]]:absolute [&_[data-part=calendar-title]]:w-px [&_[data-part=calendar-title]]:h-px [&_[data-part=calendar-title]]:m-0 [&_[data-part=calendar-title]]:overflow-hidden [&_[data-part=calendar-title]]:[clip-path:inset(50%)] [&_[data-part=calendar-title]]:whitespace-nowrap
    [&_:is([data-part=calendar-month],[data-part=calendar-year])]:min-h-(--ui-control-sm) [&_:is([data-part=calendar-month],[data-part=calendar-year])]:px-1 [&_:is([data-part=calendar-month],[data-part=calendar-year])]:border [&_:is([data-part=calendar-month],[data-part=calendar-year])]:border-border [&_:is([data-part=calendar-month],[data-part=calendar-year])]:rounded-lg [&_:is([data-part=calendar-month],[data-part=calendar-year])]:bg-background [&_:is([data-part=calendar-month],[data-part=calendar-year])]:text-foreground [&_:is([data-part=calendar-month],[data-part=calendar-year])]:font-[inherit] [&_:is([data-part=calendar-month],[data-part=calendar-year])]:font-semibold [&_:is([data-part=calendar-month],[data-part=calendar-year])]:cursor-pointer
    [&_[data-part=calendar-month]]:flex-1 [&_[data-part=calendar-month]]:ml-1 [&_[data-part=calendar-year]]:mr-1
    [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:grid [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:place-items-center [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:size-(--ui-control-sm) [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:p-0 [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:border [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:border-border [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:rounded-lg [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:bg-background [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:text-foreground [&_:is([data-part=calendar-prev],[data-part=calendar-next],[data-part=calendar-prev-year],[data-part=calendar-next-year])]:cursor-pointer
    [&_[data-part=calendar-grid]]:border-collapse [&_[data-part=calendar-grid]_td]:p-[calc(var(--ui-space)/4)]
    [&_[data-part=calendar-grid]_th]:pt-0 [&_[data-part=calendar-grid]_th]:px-0 [&_[data-part=calendar-grid]_th]:pb-1 [&_[data-part=calendar-grid]_th]:text-muted-foreground [&_[data-part=calendar-grid]_th]:font-normal [&_[data-part=calendar-grid]_th]:text-[length:calc(var(--ui-font-size)-1px)]
    [&_[data-part=calendar-day]]:size-(--ui-control-md) [&_[data-part=calendar-day]]:p-0 [&_[data-part=calendar-day]]:border-0 [&_[data-part=calendar-day]]:border-none [&_[data-part=calendar-day]]:rounded-lg [&_[data-part=calendar-day]]:bg-transparent [&_[data-part=calendar-day]]:text-foreground [&_[data-part=calendar-day]]:font-[inherit] [&_[data-part=calendar-day]]:tabular-nums [&_[data-part=calendar-day]]:cursor-pointer
    [&_[data-part=calendar-day]:hover]:bg-accent [&_[data-part=calendar-day][data-outside=true]]:text-muted-foreground
    [&_[data-part=calendar-day][aria-current=date]]:font-bold [&_[data-part=calendar-day][aria-current=date]]:underline [&_[data-part=calendar-day][aria-current=date]]:underline-offset-3
    [&_[data-part=calendar-day][data-between=true]]:rounded-none [&_[data-part=calendar-day][data-between=true]]:bg-accent
    [&_[data-part=calendar-day][aria-pressed=true]]:bg-primary [&_[data-part=calendar-day][aria-pressed=true]]:text-primary-foreground
    [&_[data-part=calendar-day][aria-disabled=true]]:opacity-40 [&_[data-part=calendar-day][aria-disabled=true]]:cursor-not-allowed
    [&_[data-part=calendar-day]:focus-visible]:outline-2 [&_[data-part=calendar-day]:focus-visible]:outline-ring [&_[data-part=calendar-day]:focus-visible]:outline-offset-1
    [&_:is([data-part=calendar-prev],[data-part=calendar-next]):focus-visible]:outline-2 [&_:is([data-part=calendar-prev],[data-part=calendar-next]):focus-visible]:outline-ring [&_:is([data-part=calendar-prev],[data-part=calendar-next]):focus-visible]:outline-offset-1
  "
>
  <div data-part="calendar-head">
    <button
      type="button"
      data-part="calendar-prev-year"
      aria-label="Previous year"
      (click)="show(clamp(addMonths(focus, -12), lo(), hi()))"
    >
      <icon name="lucide:chevrons-left" />
    </button>
    <button
      type="button"
      data-part="calendar-prev"
      aria-label="Previous month"
      (click)="show(clamp(addMonths(focus, -1), lo(), hi()))"
    >
      <icon name="lucide:chevron-left" />
    </button>
    <p data-part="calendar-title" aria-live="polite">{{ date(focus, { month: 'long', year: 'numeric' }) }}</p>
    <select
      data-part="calendar-month"
      aria-label="Month"
      (change)="jump(Number(focus.slice(0, 4)), Number($event.target.value))"
    >
      @for (m of months(); track m.value) {
        <option [value]="m.value" [selected]="m.value === Number(focus.slice(5, 7))">{{ m.label }}</option>
      }
    </select>
    <select
      data-part="calendar-year"
      aria-label="Year"
      (change)="jump(Number($event.target.value), Number(focus.slice(5, 7)))"
    >
      @for (y of years(); track y) {
        <option [value]="y" [selected]="y === Number(focus.slice(0, 4))">{{ y }}</option>
      }
    </select>
    <button
      type="button"
      data-part="calendar-next"
      aria-label="Next month"
      (click)="show(clamp(addMonths(focus, 1), lo(), hi()))"
    >
      <icon name="lucide:chevron-right" />
    </button>
    <button
      type="button"
      data-part="calendar-next-year"
      aria-label="Next year"
      (click)="show(clamp(addMonths(focus, 12), lo(), hi()))"
    >
      <icon name="lucide:chevrons-right" />
    </button>
  </div>
  <table
    data-part="calendar-grid"
    [aria-label]="label + ', ' + date(focus, { month: 'long', year: 'numeric' })"
    (keydown)="key($event)"
  >
    <thead>
      <tr>
        @for (d of days(); track d.long) {
          <th scope="col" [abbr]="d.long">{{ d.short }}</th>
        }
      </tr>
    </thead>
    <tbody>
      @for (week of weeks(); track week[0].iso) {
        <tr>
          @for (d of week; track d.iso) {
            <td>
              <button
                type="button"
                [id]="id + '-' + d.iso"
                data-part="calendar-day"
                [tabindex]="d.iso === focus ? 0 : -1"
                [aria-label]="
                  date(d.iso, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) +
                  (off(d.iso) ? ', unavailable' : '')
                "
                [aria-pressed]="picked(d.iso) ? 'true' : 'false'"
                [aria-disabled]="off(d.iso) ? 'true' : false"
                [aria-current]="d.iso === now ? 'date' : false"
                [data-outside]="d.outside ? 'true' : false"
                [data-between]="between(d.iso) ? 'true' : false"
                (click)="pick(d.iso)"
                (focusin)="focus = d.iso"
                (mouseover)="hovered = d.iso"
              >
                {{ Number(d.iso.slice(8)) }}
              </button>
            </td>
          }
        </tr>
      }
    </tbody>
  </table>
</div>
