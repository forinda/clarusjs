@import uiAspectRatio from './aspect-ratio.tscl'

<script>
  const RATIOS = ['1/1', '4/3', '16/9', '21/9']
  let ratio = state('16/9')
</script>

{{-- ratio is any CSS ratio ("16/9", "4/3", "1/1", "21/9", "3/4" for portrait). --}}
<div class="demo example">
  <div class="ratios" role="group" aria-label="Ratio">
    @for (r of RATIOS; track r) {
      <button type="button" [aria-pressed]="ratio === r ? 'true' : 'false'" (click)="ratio = r">
        {{ r.replace('/', ':') }}
      </button>
    }
  </div>
  <uiAspectRatio [ratio]="ratio">
    <div class="fill">{{ ratio.replace('/', ':') }}</div>
  </uiAspectRatio>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    max-width: 32rem;
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  .ratios {
    display: flex;
    gap: var(--ui-space-1);
  }
  .ratios button {
    padding: var(--ui-space-1) var(--ui-space-3);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .ratios button[aria-pressed='true'] {
    border-color: var(--ui-accent);
    background: var(--ui-accent-soft);
  }
</style>
<style global>
  .fill {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: var(--ui-radius);
    background: linear-gradient(135deg, var(--ui-accent-soft), var(--ui-muted-bg));
    color: var(--ui-muted);
    font-weight: 600;
  }
</style>
