@import uiAlert from './alert.tscl'

<div class="demo">
  <uiAlert>
    @slot('title') {
      Saved
    }
    Your changes are live.
  </uiAlert>
  <uiAlert variant="destructive">
    @slot('title') {
      Couldn't publish
    }
    The build failed: check the log.
  </uiAlert>
  <uiAlert variant="success">
    @slot('title') {
      Published
    }
    Your site is live.
  </uiAlert>
  <uiAlert variant="warning">
    @slot('title') {
      Almost full
    }
    You've used 90% of your storage.
  </uiAlert>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
