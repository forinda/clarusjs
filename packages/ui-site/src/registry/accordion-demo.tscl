@import uiAccordion from './accordion.tscl'

<div class="demo">
  <uiAccordion group="faq" [open]="true">
    @slot('trigger') {
      Does it need JavaScript?
    }
    No: it's a details element.
  </uiAccordion>
  <uiAccordion group="faq">
    @slot('trigger') {
      Can two be open?
    }
    Not in the same group: opening one closes the other.
  </uiAccordion>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: var(--ui-space-3);
    padding: var(--ui-space-6);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
