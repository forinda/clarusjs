{{-- Button group: buttons that belong together, joined into one row. label names the group. --}}
@input label: string

<div role="group" [aria-label]="label" data-part="button-group"><slot /></div>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: inline-flex;
    }
    /* The buttons square their inner corners: they read these (a component's own rules always beat a parent's). */
    :where(:scope > *:not(:first-child)) {
      --ui-group-radius-start: 0;
      margin-left: calc(var(--ui-space) * -0.25);
    }
    :where(:scope > *:not(:last-child)) {
      --ui-group-radius-end: 0;
    }
    :where(:scope > *:focus-visible) {
      position: relative;
      z-index: 1;
    }
  }
</style>
