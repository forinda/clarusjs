{{-- Field: a label, a native input, a description and an error, wired by id, bound two ways with [(value)]. The
     error shows once the field has been left, or with [show] (after a submit). For (blur), use field.tscl from
     @clarusjs/ui-primitives directly: the styles apply the same. --}}
@import uiField from '@clarusjs/ui-primitives/field.tscl'
@input id: string
@input label: string
@input description: string = ''
@input error: string = ''
@input show: boolean = false
@input type: string = 'text'
@input name: string = ''
@input placeholder: string = ''
@input required: boolean = false
@input autocomplete: string = ''
@input inputmode: string = ''
@model value: string = ''

<uiField
  [id]="id"
  [label]="label"
  [description]="description"
  [error]="error"
  [show]="show"
  [type]="type"
  [name]="name"
  [placeholder]="placeholder"
  [required]="required"
  [autocomplete]="autocomplete"
  [inputmode]="inputmode"
  [(value)]="value"
/>

<style global>
  /* The same rules as @clarusjs/ui's ui.css, for this part: change them here to change its look. */
  @layer theme, base, components, utilities;
  @layer components {
    /* Focus is always visible, on every part and what's inside it. */
    :where([data-part]):focus-visible,
    :where([data-part]) :focus-visible {
      outline: 2px solid var(--ui-ring);
      outline-offset: 2px;
    }
    /* A combobox's or chip input's box shows its focus: the input inside doesn't draw a second ring (~=: another part's name, not this one's). */
    :where([data-part~='combobox'] [data-part~='input'], [data-part~='chip-input'] [data-part~='input']):focus-visible {
      outline: none;
    }

    /* Field and select: label, control, description, error. */
    :where([data-part='field'], [data-part='select']) {
      display: grid;
      gap: var(--ui-space-1);
      max-width: 360px;
      font: var(--ui-font-size) var(--ui-font);
      color: var(--ui-fg);
    }
    :where([data-part='label']) {
      font-weight: 600;
      font-size: calc(var(--ui-font-size) - 1px);
      color: var(--ui-fg);
    }
    :where([data-part='control']) {
      min-height: var(--ui-control-h, var(--ui-control-md));
      padding: var(--ui-space-1) calc(var(--ui-space) * 2.5);
      border: 1px solid var(--ui-input);
      border-radius: var(--ui-radius);
      background: var(--ui-bg);
      color: var(--ui-fg);
      font: var(--ui-control-font, var(--ui-font-size)) var(--ui-font);
    }
    /* Sizes: the nearest data-size (on the control, or on anything around it) sets these, and they inherit, so a
       control's own size wins over its row's. */
    :where([data-size='sm']) {
      --ui-control-h: var(--ui-control-sm);
      --ui-control-font: calc(var(--ui-font-size) - 1px);
    }
    :where([data-size='md']) {
      --ui-control-h: var(--ui-control-md);
      --ui-control-font: var(--ui-font-size);
    }
    :where([data-size='lg']) {
      --ui-control-h: var(--ui-control-lg);
      --ui-control-font: calc(var(--ui-font-size) + 2px);
    }
    :where([data-part='control'])[aria-invalid='true'] {
      border: 1px solid var(--ui-danger);
    }
    :where([data-part='control']):disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    :where([data-part='description']) {
      margin: 0;
      color: var(--ui-muted);
      font-size: calc(var(--ui-font-size) - 1px);
    }
    :where([data-part='error']) {
      margin: 0;
      color: var(--ui-danger);
      font-size: calc(var(--ui-font-size) - 1px);
    }
    :where([data-part='option']) {
      padding: calc(var(--ui-space) * 1.5) calc(var(--ui-space) * 2.5);
      border-radius: calc(var(--ui-radius) - 2px);
    }
    :where([data-part='select']) ::picker(select) {
      padding: var(--ui-space-1);
      border: 1px solid var(--ui-border);
      border-radius: var(--ui-radius);
      background: var(--ui-popover);
      color: var(--ui-popover-fg);
      box-shadow: var(--ui-shadow);
    }

    @media (prefers-reduced-motion: reduce) {
      :where([data-part]),
      :where([data-part]) * {
        transition: none !important;
      }
    }
  }
</style>
