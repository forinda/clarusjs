{{--
  Date picker: a button that shows the date and opens a Calendar in a popover (Escape or a click outside closes it,
  and the focus goes back to the button). [range]="true" picks a start and an end. The date is 'YYYY-MM-DD' in a
  hidden input named name (a range adds name-end), so a form sends it; bind it with [(value)] (and [(end)]).
--}}
@import uiCalendar from './calendar.tscl'
@input id: string
@input label: string
@input name: string = 'date'
@input placeholder: string = 'Pick a date'
@input range: boolean = false
@input min: string = ''
@input max: string = ''
@input locale: string = 'en-US'
@input firstDay: number = 0
@model value: string = ''
@model end: string = ''

<script>
  import { parseIso } from './calendar-dates.ts'
  const format = new Intl.DateTimeFormat(locale, { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' })
  const text = () => {
    const a = parseIso(value)
    const b = parseIso(end)
    if (range && a && b) return format.formatRange(a, b)
    if (a) return range ? format.format(a) + ' – …' : format.format(a)
    return placeholder
  }
  const popover = () => document.getElementById(`${id}-popover`)
  // A day picked: done once there's a date (both, for a range); the focus goes back to the button.
  function chosen() {
    if (range && !(value && end)) return
    popover()?.hidePopover()
    document.getElementById(`${id}-trigger`)?.focus()
  }
  // Opened: the keyboard starts on the chosen day (or today).
  function toggled(event) {
    if (event.newState !== 'open') return
    requestAnimationFrame(() => {
      const day = popover()?.querySelector('[data-part="calendar-day"][tabindex="0"]')
      if (day instanceof HTMLElement) day.focus()
    })
  }
</script>

<div data-part="date-picker" [data-empty]="value ? false : 'true'">
  <span [id]="id + '-label'" data-part="date-picker-label">{{ label }}</span>
  <button
    type="button"
    [id]="id + '-trigger'"
    [popovertarget]="id + '-popover'"
    aria-haspopup="dialog"
    [aria-labelledby]="id + '-label ' + id + '-text'"
    [style]="'anchor-name: --' + id"
    data-part="date-picker-trigger"
  >
    <icon name="lucide:calendar" />
    <span [id]="id + '-text'">{{ text() }}</span>
  </button>
  <div
    [id]="id + '-popover'"
    popover="auto"
    role="dialog"
    [aria-label]="label"
    [style]="'position-anchor: --' + id"
    data-part="date-picker-popover"
    (toggle)="toggled($event)"
  >
    <uiCalendar
      [id]="id + '-calendar'"
      [label]="label"
      [range]="range"
      [min]="min"
      [max]="max"
      [locale]="locale"
      [firstDay]="firstDay"
      [(value)]="value"
      [(end)]="end"
      (select)="chosen()"
    />
  </div>
  <input type="hidden" [name]="name" [value]="value" />
  @if (range) {
    <input type="hidden" [name]="name + '-end'" [value]="end" />
  }
</div>

<style scoped>
  @layer theme, base, components, utilities;
  @layer components {
    :where(:scope) {
      display: inline-grid;
      gap: var(--ui-space-1);
      color: var(--ui-fg);
      font: var(--ui-font-size) var(--ui-font);
    }
    :where([data-part='date-picker-label']) {
      font-weight: 500;
    }
    :where([data-part='date-picker-trigger']) {
      display: inline-flex;
      gap: var(--ui-space-2);
      align-items: center;
      min-width: 14rem;
      min-height: var(--ui-control-h, var(--ui-control-md));
      padding: 0 var(--ui-space-3);
      border: 1px solid var(--ui-input);
      border-radius: var(--ui-radius);
      background: var(--ui-bg);
      color: var(--ui-fg);
      font: inherit;
      text-align: start;
      cursor: pointer;
    }
    :where(:scope[data-empty='true'] [data-part='date-picker-trigger']) {
      color: var(--ui-muted);
    }
    :where([data-part='date-picker-trigger']:focus-visible) {
      outline: 2px solid var(--ui-ring);
      outline-offset: 1px;
    }
    /* Under its button, flipping above when there's no room below. */
    :where([data-part='date-picker-popover']) {
      position-area: bottom span-right;
      position-try-fallbacks: flip-block;
      margin: var(--ui-space-1) 0;
      padding: 0;
      border: 1px solid var(--ui-border);
      border-radius: var(--ui-radius);
      background: var(--ui-popover);
      color: var(--ui-popover-fg);
      box-shadow: var(--ui-shadow);
    }
  }
</style>
