{{-- The theme builder's preview: a small dashboard built only from the site's components, so every token shows.
     Site-only (not in the registry). It lays itself out by its own width (container queries), so the builder's phone
     toggle works by narrowing it. --}}
@import '~/registry/menu.css'
@import '~/registry/dialog.css'
@import '~/registry/tabs.css'
@import '~/registry/select.css'
@import uiButton from '~/registry/button.tscl'
@import uiCard from '~/registry/card.tscl'
@import uiBadge from '~/registry/badge.tscl'
@import uiAlert from '~/registry/alert.tscl'
@import uiInput from '~/registry/input.tscl'
@import uiLabel from '~/registry/label.tscl'
@import uiTable from '~/registry/table.tscl'
@import uiSwitch from '~/registry/switch.tscl'
@import uiKbd from '~/registry/kbd.tscl'
@import uiMenu from '@clarusjs/ui-primitives/menu.tscl'
@import uiMenuTrigger from '@clarusjs/ui-primitives/menu-trigger.tscl'
@import uiMenuList from '@clarusjs/ui-primitives/menu-list.tscl'
@import uiMenuItem from '@clarusjs/ui-primitives/menu-item.tscl'
@import uiDialog from '@clarusjs/ui-primitives/dialog.tscl'
@import uiDialogTrigger from '@clarusjs/ui-primitives/dialog-trigger.tscl'
@import uiDialogClose from '@clarusjs/ui-primitives/dialog-close.tscl'
@import uiTabs from '@clarusjs/ui-primitives/tabs.tscl'
@import uiTabList from '@clarusjs/ui-primitives/tab-list.tscl'
@import uiTab from '@clarusjs/ui-primitives/tab.tscl'
@import uiTabPanel from '@clarusjs/ui-primitives/tab-panel.tscl'
@import uiSelect from '@clarusjs/ui-primitives/select.tscl'

<div data-ui-preview class="preview">
  <nav class="side" aria-label="Preview sections">
    <p class="brand">Acme</p>
    <a href="#pv-overview" aria-current="page">Overview</a>
    <a href="#pv-team">Team</a>
    <a href="#pv-settings">Settings</a>
  </nav>
  <div class="main">
    <div class="head">
      <h2 id="pv-overview">Overview</h2>
      <div class="actions">
        <uiMenu id="pv-actions">
          <uiMenuTrigger>Actions</uiMenuTrigger>
          <uiMenuList>
            <uiMenuItem value="archive">Archive</uiMenuItem>
            <uiMenuItem value="export">Export</uiMenuItem>
            <uiMenuItem value="delete" [disabled]="true">Delete</uiMenuItem>
          </uiMenuList>
        </uiMenu>
        <uiDialogTrigger target="pv-invite">Invite people</uiDialogTrigger>
        <uiDialog id="pv-invite">
          @slot('title') {
            Invite people
          }
          <uiLabel control="pv-email">Email</uiLabel>
          <uiInput id="pv-email" type="email" placeholder="ada@example.com" />
          <uiDialogClose target="pv-invite">Cancel</uiDialogClose>
        </uiDialog>
      </div>
    </div>
    <div class="stats">
      <uiCard>
        @slot('header') {
          <p>Revenue</p>
        }
        <p class="big">$12,480</p>
        <uiBadge variant="success">+12%</uiBadge>
      </uiCard>
      <uiCard>
        @slot('header') {
          <p>Customers</p>
        }
        <p class="big">1,234</p>
        <uiBadge variant="secondary">this month</uiBadge>
      </uiCard>
      <uiCard>
        @slot('header') {
          <p>Refunds</p>
        }
        <p class="big">8</p>
        <uiBadge variant="warning">2 open</uiBadge>
      </uiCard>
    </div>
    <uiAlert variant="destructive">
      @slot('title') {
        Payment failed
      }
      The card ending 4242 was declined.
    </uiAlert>
    <uiTabs id="pv-tabs" label="Sections" value="team">
      <uiTabList>
        <uiTab value="team">Team</uiTab>
        <uiTab value="settings">Settings</uiTab>
      </uiTabList>
      <uiTabPanel value="team">
        <uiTable caption="Team members">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Role</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Ada Lovelace</td>
              <td>Owner</td>
              <td><uiBadge>Active</uiBadge></td>
            </tr>
            <tr>
              <td>Grace Hopper</td>
              <td>Admin</td>
              <td><uiBadge variant="outline">Invited</uiBadge></td>
            </tr>
          </tbody>
        </uiTable>
      </uiTabPanel>
      <uiTabPanel value="settings">
        <form class="form" id="pv-settings">
          <uiLabel control="pv-name">Workspace name</uiLabel>
          <uiInput id="pv-name" value="Acme" />
          <uiSelect
            id="pv-plan"
            label="Plan"
            [options]="[
              { value: 'free', label: 'Free' },
              { value: 'pro', label: 'Pro' },
            ]"
            value="pro"
          />
          <uiSwitch label="Email me a weekly summary" />
          <p class="hint">Save with <uiKbd>Ctrl</uiKbd> <uiKbd>S</uiKbd></p>
          <div class="buttons">
            <uiButton variant="ghost">Cancel</uiButton>
            <uiButton variant="secondary">Preview</uiButton>
            <uiButton type="submit">Save</uiButton>
          </div>
        </form>
      </uiTabPanel>
    </uiTabs>
  </div>
</div>

<style scoped>
  :scope {
    container-type: inline-size;
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--ui-border);
    border-radius: calc(var(--ui-radius) * 1.5);
    background: var(--ui-bg);
    color: var(--ui-fg);
    font-family: var(--ui-font);
    font-size: var(--ui-font-size);
    overflow: hidden;
  }
  .side {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    padding: 12px;
    background: var(--ui-sidebar);
    color: var(--ui-sidebar-fg);
    border-bottom: 1px solid var(--ui-sidebar-border);
  }
  .side a {
    padding: 6px 10px;
    border-radius: var(--ui-radius);
    color: inherit;
    text-decoration: none;
  }
  .side a[aria-current='page'] {
    background: var(--ui-sidebar-accent);
    color: var(--ui-sidebar-accent-fg);
  }
  .brand {
    color: var(--ui-sidebar-fg);
    margin: 0 8px 0 0;
    padding: 6px 4px;
    font-family: var(--ui-font-heading);
    font-weight: 700;
  }
  .main {
    color: var(--ui-fg);
    display: grid;
    gap: 16px;
    padding: 16px;
    min-width: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }
  h2 {
    margin: 0;
    font-family: var(--ui-font-heading);
    font-size: calc(var(--ui-font-size) + 6px);
  }
  .actions,
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stats {
    display: grid;
    gap: 12px;
  }
  .big {
    margin: 0;
    font-family: var(--ui-font-heading);
    font-size: calc(var(--ui-font-size) + 10px);
    font-weight: 700;
  }
  .form {
    display: grid;
    gap: 10px;
    max-width: 420px;
  }
  .hint {
    margin: 0;
    color: var(--ui-muted);
  }
  @container (min-width: 640px) {
    :scope {
      grid-template-columns: 180px 1fr;
    }
    .side {
      flex-direction: column;
      flex-wrap: nowrap;
      border-bottom: 0;
      border-right: 1px solid var(--ui-sidebar-border);
    }
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
