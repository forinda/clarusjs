{{-- Shown only while a theme from /theme is saved: puts the demos back to the default look. --}}

<script>
  import { STORAGE_KEY } from '~/theme/apply.ts'
  let saved = state(false)
  const check = () => {
    try {
      saved = !!localStorage.getItem(STORAGE_KEY)
    } catch {}
  }
  function reset() {
    try {
      localStorage.removeItem(STORAGE_KEY)
    } catch {}
    document.getElementById('ui-theme')?.remove()
    saved = false
  }
</script>

<p class="theme-reset" [hidden]="!saved" [use]="check">
  Demos show your theme.
  <button type="button" (click)="reset()">Reset to default theme</button>
</p>

<style scoped>
  :scope {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 0 0 16px;
    font-size: 14px;
  }
  :scope[hidden] {
    display: none;
  }
</style>
