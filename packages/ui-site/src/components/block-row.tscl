{{-- A block on /blocks: its name (linked), category and line from the registry, and its preview (the slot: an
     <iframe> written in the page, since its src is never data). --}}
@import { SECTION_KINDS, blocks, sections } from '~/registry.ts'
@input name: string

<script server>
  // A block, or a section kind shown by its first version: it links to the kind's page and says the kind.
  const entry = blocks.concat(sections).find((b) => b.name === name)
  if (!entry) throw new Error(`blockRow: no block or section "${name}" in the registry`)
  const kind = entry.section ? SECTION_KINDS[entry.section] : undefined
  const href = entry.section ? `/blocks/marketing/${entry.section}` : `/blocks/${name}`
  const title = kind?.title ?? entry.title
  const line = kind?.description ?? entry.description
</script>

<section
  class="block-row"
  [data-block]="name"
  [data-category]="entry.category ?? ''"
  [aria-labelledby]="'block-' + name"
>
  <div class="block-row-head">
    <h2 [id]="'block-' + name">
      <a [href]="href">{{ title }}</a>
    </h2>
    <span class="block-row-category">{{ entry.category }}</span>
  </div>
  <p>{{ line }}</p>
  <slot />
</section>

<style scoped>
  :scope {
    display: grid;
    gap: 8px;
    margin: 0 0 40px;
  }
  :scope[hidden] {
    display: none;
  }
  .block-row-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: baseline;
  }
  h2 {
    margin: 0;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  .block-row-category {
    padding: 2px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
  }
</style>
