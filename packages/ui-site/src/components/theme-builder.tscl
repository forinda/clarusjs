{{-- The theme builder (in the header's sheet, theme-sheet.tscl): presets, every colour token, fonts and shape, edited
     per mode. An edit is saved and set live on the page (#ui-theme, what every demo and block reads), and on /theme's
     preview as inline custom properties. Copy CSS hands out theme.css. Its controls are this library's own parts;
     the colours stay native <input type="color"> (no picker part yet) in a <details>. --}}
@import '~/registry/select.css'
@import '~/registry/popover.css'
@import uiSelect from '@clarusjs/ui-primitives/select.tscl'
@import uiPopover from '@clarusjs/ui-primitives/popover.tscl'
@import uiPopoverTrigger from '@clarusjs/ui-primitives/popover-trigger.tscl'
@import uiSlider from '~/registry/slider.tscl'
@import uiButton from '~/registry/button.tscl'

<script>
  import { effect } from 'clarusjs/runtime'
  import { presets } from '~/theme/presets.ts'
  import {
    MODELESS,
    PAIRS,
    SCALE,
    contrast,
    darkFrom,
    decode,
    encode,
    fromOklch,
    restore,
    brandTokens,
    siteCss,
    toCss,
  } from '~/theme/model.ts'
  import { SCOPE, SOURCE_KEY, STORAGE_KEY, loadFonts } from '~/theme/apply.ts'
  import { DENSITIES, FONTS, HEADINGS, MONOS, SHADOWS, SIZES } from '~/theme/options.ts'

  const PRESETS = ['teal', 'indigo', 'rose', 'amber', 'green', 'neutral'].map((name) => ({
    name,
    label: name[0].toUpperCase() + name.slice(1),
    accent: presets[name].light.accent,
  }))
  const t = (key, label) => ({ key, label })
  const GROUPS = [
    {
      title: 'Brand',
      tokens: [
        t('accent', 'Accent'),
        t('accent-fg', 'Accent text'),
        t('secondary', 'Secondary'),
        t('secondary-fg', 'Secondary text'),
      ],
    },
    {
      title: 'Surfaces',
      tokens: [
        t('bg', 'Background'),
        t('fg', 'Text'),
        t('card', 'Card'),
        t('card-fg', 'Card text'),
        t('popover', 'Popover'),
        t('popover-fg', 'Popover text'),
        t('muted-bg', 'Muted surface'),
        t('muted', 'Muted text'),
        t('accent-soft', 'Hover tint'),
        t('accent-soft-fg', 'Hover tint text'),
        t('border', 'Border'),
        t('input', 'Input border'),
        t('ring', 'Focus ring'),
      ],
    },
    {
      title: 'Status',
      tokens: [
        t('danger', 'Danger'),
        t('danger-fg', 'Danger text'),
        t('success', 'Success'),
        t('success-fg', 'Success text'),
        t('warning', 'Warning'),
        t('warning-fg', 'Warning text'),
      ],
    },
    {
      title: 'Chart',
      tokens: [1, 2, 3, 4, 5].map((n) => t(`chart-${n}`, `Series ${n}`)),
    },
    {
      title: 'Sidebar',
      tokens: [
        t('sidebar', 'Sidebar'),
        t('sidebar-fg', 'Sidebar text'),
        t('sidebar-accent', 'Sidebar accent'),
        t('sidebar-accent-fg', 'Sidebar accent text'),
        t('sidebar-border', 'Sidebar border'),
      ],
    },
  ]
  const SIZE_OPTIONS = SIZES.map((z) => ({ value: z, label: z }))
  const SHADOW_OPTIONS = [
    { value: 'none', label: 'None' },
    { value: 'soft', label: 'Soft' },
    { value: 'strong', label: 'Strong' },
  ]
  const clone = (theme) => ({ light: { ...theme.light }, dark: { ...theme.dark } })

  let base = state('teal')
  let theme = state(clone(presets.teal))
  let mode = state('light')
  let edited = state([])
  let shadow = state('soft')
  let copied = state(false)
  let shared = state(false)
  // Saved only after an edit here: opening /theme or a shared link never overwrites a saved theme.
  let dirty = state(false)
  const BG = Object.fromEntries(PAIRS)
  const ratio = (key) => (BG[key] ? Math.floor(contrast(theme[mode][key], theme[mode][BG[key]]) * 10) / 10 : 21)
  const low = (key) => ratio(key) < 4.5

  function pick(name) {
    dirty = true
    base = name
    theme = clone(presets[name])
    edited = []
    shadow = 'soft'
  }
  function set(key, value) {
    dirty = true
    if (MODELESS.includes(key)) {
      theme = { light: { ...theme.light, [key]: value }, dark: theme.dark }
    } else if (mode === 'dark') {
      theme = { light: theme.light, dark: { ...theme.dark, [key]: value } }
      if (!edited.includes(key)) edited = [...edited, key]
    } else {
      const light = { ...theme.light, [key]: value }
      theme = { light, dark: edited.includes(key) ? theme.dark : { ...theme.dark, [key]: darkFrom(light)[key] } }
    }
  }
  // A custom brand colour: the accent, and the ring, text and tint that go with it (else focus rings stay the preset's).
  function brand(value) {
    for (const [key, v] of Object.entries(brandTokens(value))) set(key, v)
  }
  const radius = (event) => set('radius', event.target.value + 'px')
  function font(key, value) {
    set(key, value)
    loadFonts(value)
  }

  function setShadow(name) {
    dirty = true
    shadow = name
    theme = { light: { ...theme.light, shadow: SHADOWS[name][0] }, dark: { ...theme.dark, shadow: SHADOWS[name][1] } }
  }
  function shuffle() {
    dirty = true
    const h = Math.random() * Math.PI * 2
    const tint = (set, accent, fg, soft) => ({
      ...set,
      accent,
      'accent-fg': fg,
      ring: accent,
      'accent-soft': soft,
      secondary: soft,
      'muted-bg': soft,
      'sidebar-accent': soft,
    })
    theme = {
      light: tint(theme.light, fromOklch([0.5, 0.15, h]), '#ffffff', fromOklch([0.96, 0.03, h])),
      dark: tint(theme.dark, fromOklch([0.78, 0.13, h]), theme.dark.bg, fromOklch([0.27, 0.05, h])),
    }
  }
  // Reset: the default theme, and the saved one forgotten (every page, tab and frame back to theme.css).
  function reset() {
    pick('teal')
    try {
      localStorage.removeItem(STORAGE_KEY)
      localStorage.removeItem(SOURCE_KEY)
    } catch {}
    document.getElementById('ui-theme')?.remove()
    dirty = false
  }
  async function share() {
    try {
      await navigator.clipboard.writeText(`${location.origin}/theme?t=${encodeURIComponent(encode(theme, base))}`)
      shared = true
      setTimeout(() => (shared = false), 1500)
    } catch {}
  }
  async function copy() {
    try {
      await navigator.clipboard.writeText(toCss(theme))
      copied = true
      setTimeout(() => (copied = false), 1500)
    } catch {}
  }
  const load = () => {
    let text = new URLSearchParams(location.search).get('t')
    if (text === null) {
      try {
        text = localStorage.getItem(SOURCE_KEY)
      } catch {}
    }
    const found = text ? decode(text) : null
    if (found) {
      base = found.base
      theme = found.theme
      const back = restore(found.theme, found.base)
      shadow = back.shadow
      edited = back.edited
      loadFonts(Object.values(found.theme.light).join(' '))
    }
  }
  const wire = (el) => {
    load()
    // Light or dark: the one the site shows (the header's switch, else the system setting), followed as it changes.
    const dark = matchMedia('(prefers-color-scheme: dark)')
    const follow = () => {
      const root = document.documentElement.dataset.theme
      mode = root === 'dark' || (root !== 'light' && dark.matches) ? 'dark' : 'light'
    }
    follow()
    const watch = new MutationObserver(follow)
    watch.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    dark.addEventListener('change', follow)
    const stop = effect(() => {
      const preview = document.querySelector('[data-ui-preview]')
      if (!(preview instanceof HTMLElement)) return
      const values = { ...theme.light, ...(mode === 'dark' ? theme.dark : {}) }
      for (const [key, value] of Object.entries(values)) preview.style.setProperty(`--ui-${key}`, String(value))
      // The scale is computed where it's declared: declare it here too, so it follows this unit, not the page's.
      for (const [k, v] of SCALE) preview.style.setProperty(`--ui-${k}`, v)
    })
    // Saved, and set on this page at once: the stylesheet every demo and block reads. Other tabs and the block
    // frames hear the save (a storage event) and set it too (APPLY_SCRIPT).
    const save = effect(() => {
      if (!dirty) return
      const css = toCss(theme, SCOPE) + siteCss(theme) // the demos' tokens, and the site's accent
      let sheet = document.getElementById('ui-theme')
      if (!sheet) {
        sheet = document.createElement('style')
        sheet.id = 'ui-theme'
        document.head.append(sheet)
      }
      sheet.textContent = css
      try {
        localStorage.setItem(STORAGE_KEY, css)
        localStorage.setItem(SOURCE_KEY, encode(theme, base))
      } catch {}
    })
    // The radius slider's value isn't bound (that renders the slider again on every input and ends the drag): a preset,
    // a shared link or Reset sets it here, in place.
    const slide = effect(() => {
      const value = String(parseInt(theme.light.radius))
      const input = el.querySelector('[data-part="slider"]')
      if (input instanceof HTMLInputElement && input.value !== value) input.value = value
    })
    el.setAttribute('data-ready', '')
    return () => {
      stop()
      save()
      slide()
      watch.disconnect()
      dark.removeEventListener('change', follow)
    }
  }
</script>

<div class="theme-builder" role="group" aria-label="Theme controls" [data-mode]="mode" [use]="wire">
  <div class="tb-body">
    <div class="tb-group" role="group" aria-labelledby="tb-g-colours">
      <p class="tb-group-title" id="tb-g-colours">Colours</p>
      <uiPopoverTrigger target="tb-presets">
        <span class="row-label">Preset</span>
        <span class="row-end"><span class="row-value">{{ theme.light.accent === presets[base]?.light.accent ? PRESETS.find((p) => p.name === base)?.label ?? 'Custom' : 'Custom' }}</span><span class="dot" [style]="'--sw: ' + theme[mode].accent"></span><icon name="lucide:chevron-right" /></span>
      </uiPopoverTrigger>
      <uiPopover id="tb-presets" side="bottom" align="end">
        <div class="presets" role="group" aria-label="Presets">
          @for (p of PRESETS; track p.name) {
            <button
              type="button"
              class="pick"
              [aria-label]="p.label + ' preset'"
              [aria-pressed]="String(base === p.name)"
              (click)="pick(p.name); document.getElementById('tb-presets')?.hidePopover()"
            >
              <span class="dot" [style]="'--sw: ' + p.accent"></span> {{ p.label }}
            </button>
          }
        </div>
      </uiPopover>
      <label class="row" for="tb-brand">
        <span class="row-label">Brand</span>
        <span class="row-end">
          <code class="row-value">{{ theme[mode].accent }}</code>
          <input
            type="color"
            id="tb-brand"
            aria-label="Brand"
            [value]="theme[mode].accent"
            (input)="brand($event.target.value)"
          />
        </span>
      </label>
      <details class="tb-colours">
        <summary><span class="row-label">Every colour ({{ mode }})</span><icon name="lucide:chevron-down" /></summary>
        @for (g of GROUPS; track g.title) {
          <fieldset>
            <legend>{{ g.title }}</legend>
            @for (tok of g.tokens; track tok.key) {
              <div class="colour">
                <label [for]="'tb-' + tok.key">{{ tok.label }}</label>
                <input
                  type="color"
                  [id]="'tb-' + tok.key"
                  [aria-describedby]="low(tok.key) ? 'tb-' + tok.key + '-warn' : null"
                  [value]="theme[mode][tok.key]"
                  (input)="set(tok.key, $event.target.value)"
                />
                <code>{{ theme[mode][tok.key] }}</code>
                <p class="warn" [id]="'tb-' + tok.key + '-warn'" [hidden]="!low(tok.key)">
                  Low contrast ({{ ratio(tok.key) }}:1, needs 4.5)
                </p>
              </div>
            }
          </fieldset>
        }
      </details>
    </div>
    <div class="tb-group" role="group" aria-labelledby="tb-g-type">
      <p class="tb-group-title" id="tb-g-type">Type</p>
      <div class="row row-select">
        <uiSelect id="tb-heading" label="Heading font" [options]="HEADINGS" [(value)]="theme.light['font-heading']" (change)="font('font-heading', $event)" />
      </div>
      <div class="row row-select">
        <uiSelect id="tb-font" label="Body font" [options]="FONTS" [(value)]="theme.light.font" (change)="font('font', $event)" />
      </div>
      <div class="row row-select">
        <uiSelect id="tb-mono" label="Code font" [options]="MONOS" [(value)]="theme.light['font-mono']" (change)="font('font-mono', $event)" />
      </div>
      <div class="row row-select">
        <uiSelect id="tb-size" label="Base size" [options]="SIZE_OPTIONS" [(value)]="theme.light['font-size']" (change)="set('font-size', $event)" />
      </div>
    </div>
    <div class="tb-group" role="group" aria-labelledby="tb-g-shape">
      <p class="tb-group-title" id="tb-g-shape">Shape</p>
      <div class="row">
        <span class="row-label" id="tb-radius-label">Radius</span>
        <span class="row-end">
          <span class="row-value">{{ theme.light.radius }}</span>
          <uiSlider id="tb-radius" aria-label="Radius" [min]="0" [max]="20" [value]="8" (input)="radius($event)" />
        </span>
      </div>
      <div class="row row-select">
        <uiSelect id="tb-density" label="Density" [options]="DENSITIES" [(value)]="theme.light.space" (change)="set('space', $event)" />
      </div>
      <div class="row row-select">
        <uiSelect id="tb-shadow" label="Shadow" [options]="SHADOW_OPTIONS" [(value)]="shadow" (change)="setShadow($event)" />
      </div>
    </div>
  </div>
  <div class="tb-foot">
    <uiButton (click)="copy()"><icon name="lucide:copy" /> {{ copied ? 'Copied' : 'Copy CSS' }}</uiButton>
    <uiButton variant="ghost" aria-label="Shuffle" (click)="shuffle()"><icon name="lucide:shuffle" /></uiButton>
    <uiButton variant="ghost" [aria-label]="shared ? 'Link copied' : 'Share link'" (click)="share()"><icon name="lucide:link" /></uiButton>
    <uiButton variant="ghost" aria-label="Reset" (click)="reset()"><icon name="lucide:rotate-ccw" /></uiButton>
    <a class="tb-preview" href="/theme" aria-label="Open the full preview">Preview <icon name="lucide:arrow-up-right" /></a>
  </div>
</div>

<style global>
  /* Global: much of it sits inside the library's parts (a select, a popover), where scoped rules stop. */
  /* A slim panel of rows (shadcn's /create): each a choice and its value; every colour in its own section. */
  .theme-builder {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    flex: 1;
  }
  /* The controls scroll; the sheet's header and this footer stay put. */
  .theme-builder .tb-body {
    overflow-y: auto;
    padding: 4px 16px 16px;
    overscroll-behavior: contain;
  }
  .theme-builder .tb-group + .tb-group {
    margin-top: 16px;
  }
  .theme-builder .tb-group-title {
    margin: 0 0 2px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* A row: one height, its name on the left and its value (and control) on the right, rows divided by a rule. */
  .theme-builder .row,
  .theme-builder .tb-group > [data-part='trigger'],
  .theme-builder .tb-colours summary {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 40px;
    padding: 4px 0;
    border: 0;
    border-top: 1px solid var(--rule);
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .theme-builder .tb-group-title + * {
    border-top: 0;
  }
  .theme-builder .row-label {
    font-size: 13px;
  }
  .theme-builder .row-end {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-width: 0;
    color: var(--muted);
  }
  .theme-builder .row-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--fg);
    font-size: 13px;
    font-weight: 600;
  }
  .theme-builder code.row-value {
    font-weight: 500;
  }
  /* A select row: the part's label as the row's name, its select as the value, right-aligned with a chevron. */
  .theme-builder .row-select {
    cursor: default;
  }
  .theme-builder .row-select [data-part='select'] {
    display: flex;
    flex: 1;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    max-width: none;
    min-width: 0;
  }
  .theme-builder .row-select [data-part='label'] {
    color: inherit;
    font-size: 13px;
    font-weight: 400;
  }
  .theme-builder .row-select select {
    min-width: 0;
    min-height: 0;
    padding: 4px 18px 4px 4px;
    border: 0;
    background: none;
    appearance: none;
    color: inherit;
    font-size: 13px;
    font-weight: 600;
    text-align: right;
    cursor: pointer;
  }
  .theme-builder .row-select [data-part='select'] {
    position: relative;
  }
  .theme-builder .row-select [data-part='select']::after {
    content: '';
    position: absolute;
    right: 2px;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    rotate: -45deg;
    pointer-events: none;
  }
  .theme-builder .row-end svg,
  .theme-builder .tb-colours summary svg {
    width: 14px;
    height: 14px;
    color: var(--muted);
  }
  .theme-builder .tb-colours summary {
    list-style: none;
  }
  .theme-builder .tb-colours summary::-webkit-details-marker {
    display: none;
  }
  .theme-builder .tb-colours[open] summary svg {
    rotate: 180deg;
  }
  .theme-builder .row input[type='color'] {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .theme-builder .row [data-part='slider'] {
    width: 96px;
  }
  .theme-builder .dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sw);
  }
  /* Under its row, right-aligned with it: the sheet sits at the screen's edge, so there's no room beside it. */
  .theme-builder #tb-presets {
    position-area: bottom span-left;
    min-width: 12rem;
    margin: 4px 0 0;
    padding: 6px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    color: inherit;
  }
  .theme-builder .pick {
    display: flex;
    gap: 8px;
    align-items: center;
    width: 100%;
    padding: 6px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .theme-builder .pick[aria-pressed='true'] {
    background: var(--accent-soft);
  }
  .theme-builder fieldset {
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding: 8px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .theme-builder .colour {
    display: grid;
    grid-template-columns: 1fr auto 5.5em;
    gap: 8px;
    align-items: center;
    font-size: 12px;
  }
  .theme-builder .colour input {
    width: 28px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
  }
  .theme-builder .warn {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ui-danger, #b42318);
    font-size: 12px;
  }
  .theme-builder .warn[hidden] {
    display: none;
  }
  /* The footer: stays at the bottom of the sheet. One action, three icon actions (named by aria-label), the preview. */
  .theme-builder .tb-foot {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 12px 16px;
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }
  .theme-builder .tb-foot [data-part='button'] {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
  }
  .theme-builder .tb-foot > [data-part='button']:first-child {
    margin-inline-end: 4px;
  }
  .theme-builder .tb-preview {
    display: inline-flex;
    gap: 2px;
    align-items: center;
    margin-inline-start: auto;
    color: inherit;
    font-size: 13px;
  }
  .theme-builder .tb-preview svg {
    width: 14px;
    height: 14px;
  }
</style>
