{{-- The theme builder (in the header's sheet, theme-sheet.tscl): presets, every colour token, fonts and shape, edited
     per mode. An edit is saved and set live on the page (#ui-theme, what every demo and block reads), and on /theme's
     preview as inline custom properties. Copy CSS hands out theme.css. Its controls are this library's own parts;
     the colours stay native <input type="color"> (no picker part yet) in a <details>. --}}
@import '~/registry/select.css'
@import '~/registry/popover.css'
@import uiSelect from '@clarusjs/ui-primitives/select.tscl'
@import uiPopover from '@clarusjs/ui-primitives/popover.tscl'
@import uiPopoverTrigger from '@clarusjs/ui-primitives/popover-trigger.tscl'
@import uiSlider from '~/registry/slider.tscl'
@import uiButton from '~/registry/button.tscl'

<script>
  import { effect } from 'clarusjs/runtime'
  import { presets } from '~/theme/presets.ts'
  import {
    MODELESS,
    PAIRS,
    SPACE_STEPS,
    contrast,
    darkFrom,
    decode,
    encode,
    fromOklch,
    restore,
    toCss,
  } from '~/theme/model.ts'
  import { SCOPE, SOURCE_KEY, STORAGE_KEY, loadFonts } from '~/theme/apply.ts'
  import { DENSITIES, FONTS, HEADINGS, MONOS, SHADOWS, SIZES } from '~/theme/options.ts'

  const PRESETS = ['teal', 'indigo', 'rose', 'amber', 'green', 'neutral'].map((name) => ({
    name,
    label: name[0].toUpperCase() + name.slice(1),
    accent: presets[name].light.accent,
  }))
  const t = (key, label) => ({ key, label })
  const GROUPS = [
    {
      title: 'Brand',
      tokens: [
        t('accent', 'Accent'),
        t('accent-fg', 'Accent text'),
        t('secondary', 'Secondary'),
        t('secondary-fg', 'Secondary text'),
      ],
    },
    {
      title: 'Surfaces',
      tokens: [
        t('bg', 'Background'),
        t('fg', 'Text'),
        t('card', 'Card'),
        t('card-fg', 'Card text'),
        t('popover', 'Popover'),
        t('popover-fg', 'Popover text'),
        t('muted-bg', 'Muted surface'),
        t('muted', 'Muted text'),
        t('accent-soft', 'Hover tint'),
        t('accent-soft-fg', 'Hover tint text'),
        t('border', 'Border'),
        t('input', 'Input border'),
        t('ring', 'Focus ring'),
      ],
    },
    {
      title: 'Status',
      tokens: [
        t('danger', 'Danger'),
        t('danger-fg', 'Danger text'),
        t('success', 'Success'),
        t('success-fg', 'Success text'),
        t('warning', 'Warning'),
        t('warning-fg', 'Warning text'),
      ],
    },
    {
      title: 'Sidebar',
      tokens: [
        t('sidebar', 'Sidebar'),
        t('sidebar-fg', 'Sidebar text'),
        t('sidebar-accent', 'Sidebar accent'),
        t('sidebar-accent-fg', 'Sidebar accent text'),
        t('sidebar-border', 'Sidebar border'),
      ],
    },
  ]
  const SIZE_OPTIONS = SIZES.map((z) => ({ value: z, label: z }))
  const SHADOW_OPTIONS = [
    { value: 'none', label: 'None' },
    { value: 'soft', label: 'Soft' },
    { value: 'strong', label: 'Strong' },
  ]
  const clone = (theme) => ({ light: { ...theme.light }, dark: { ...theme.dark } })

  let base = state('teal')
  let theme = state(clone(presets.teal))
  let mode = state('light')
  let edited = state([])
  let shadow = state('soft')
  let copied = state(false)
  let shared = state(false)
  // Saved only after an edit here: opening /theme or a shared link never overwrites a saved theme.
  let dirty = state(false)
  const BG = Object.fromEntries(PAIRS)
  const ratio = (key) => (BG[key] ? Math.floor(contrast(theme[mode][key], theme[mode][BG[key]]) * 10) / 10 : 21)
  const low = (key) => ratio(key) < 4.5

  function pick(name) {
    dirty = true
    base = name
    theme = clone(presets[name])
    edited = []
    shadow = 'soft'
  }
  function set(key, value) {
    dirty = true
    if (MODELESS.includes(key)) {
      theme = { light: { ...theme.light, [key]: value }, dark: theme.dark }
    } else if (mode === 'dark') {
      theme = { light: theme.light, dark: { ...theme.dark, [key]: value } }
      if (!edited.includes(key)) edited = [...edited, key]
    } else {
      const light = { ...theme.light, [key]: value }
      theme = { light, dark: edited.includes(key) ? theme.dark : { ...theme.dark, [key]: darkFrom(light)[key] } }
    }
  }
  const radius = (event) => set('radius', event.target.value + 'px')
  function font(key, value) {
    set(key, value)
    loadFonts(value)
  }

  function setShadow(name) {
    dirty = true
    shadow = name
    theme = { light: { ...theme.light, shadow: SHADOWS[name][0] }, dark: { ...theme.dark, shadow: SHADOWS[name][1] } }
  }
  function shuffle() {
    dirty = true
    const h = Math.random() * Math.PI * 2
    const tint = (set, accent, fg, soft) => ({
      ...set,
      accent,
      'accent-fg': fg,
      ring: accent,
      'accent-soft': soft,
      secondary: soft,
      'muted-bg': soft,
      'sidebar-accent': soft,
    })
    theme = {
      light: tint(theme.light, fromOklch([0.5, 0.15, h]), '#ffffff', fromOklch([0.96, 0.03, h])),
      dark: tint(theme.dark, fromOklch([0.78, 0.13, h]), theme.dark.bg, fromOklch([0.27, 0.05, h])),
    }
  }
  function reset() {
    pick(base)
  }
  async function share() {
    try {
      await navigator.clipboard.writeText(`${location.origin}/theme?t=${encodeURIComponent(encode(theme, base))}`)
      shared = true
      setTimeout(() => (shared = false), 1500)
    } catch {}
  }
  async function copy() {
    try {
      await navigator.clipboard.writeText(toCss(theme))
      copied = true
      setTimeout(() => (copied = false), 1500)
    } catch {}
  }
  const load = () => {
    let text = new URLSearchParams(location.search).get('t')
    if (text === null) {
      try {
        text = localStorage.getItem(SOURCE_KEY)
      } catch {}
    }
    const found = text ? decode(text) : null
    if (found) {
      base = found.base
      theme = found.theme
      const back = restore(found.theme, found.base)
      shadow = back.shadow
      edited = back.edited
      loadFonts(Object.values(found.theme.light).join(' '))
    }
  }
  const wire = (el) => {
    // ponytail: on the next tick, once this island is wired. A change made while it attaches never reaches the
    // nested selects (they keep the server's value); fix that in the runtime if another island needs it.
    setTimeout(load)
    // Light or dark: the one the site shows (the header's switch, else the system setting), followed as it changes.
    const dark = matchMedia('(prefers-color-scheme: dark)')
    const follow = () => {
      const root = document.documentElement.dataset.theme
      mode = root === 'dark' || (root !== 'light' && dark.matches) ? 'dark' : 'light'
    }
    follow()
    const watch = new MutationObserver(follow)
    watch.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    dark.addEventListener('change', follow)
    const stop = effect(() => {
      const preview = document.querySelector('[data-ui-preview]')
      if (!(preview instanceof HTMLElement)) return
      const values = { ...theme.light, ...(mode === 'dark' ? theme.dark : {}) }
      for (const [key, value] of Object.entries(values)) preview.style.setProperty(`--ui-${key}`, String(value))
      // The scale is computed where it's declared: declare it here too, so it follows this unit, not the page's.
      for (const n of SPACE_STEPS) preview.style.setProperty(`--ui-space-${n}`, `calc(var(--ui-space) * ${n})`)
    })
    // Saved, and set on this page at once: the stylesheet every demo and block reads. Other tabs and the block
    // frames hear the save (a storage event) and set it too (APPLY_SCRIPT).
    const save = effect(() => {
      if (!dirty) return
      const css = toCss(theme, SCOPE)
      let sheet = document.getElementById('ui-theme')
      if (!sheet) {
        sheet = document.createElement('style')
        sheet.id = 'ui-theme'
        document.head.append(sheet)
      }
      sheet.textContent = css
      try {
        localStorage.setItem(STORAGE_KEY, css)
        localStorage.setItem(SOURCE_KEY, encode(theme, base))
      } catch {}
    })
    el.setAttribute('data-ready', '')
    return () => {
      stop()
      save()
      watch.disconnect()
      dark.removeEventListener('change', follow)
    }
  }
</script>

<div class="theme-builder" role="group" aria-label="Theme controls" [data-mode]="mode" [use]="wire">
  <div class="tb-rows">
    <uiPopoverTrigger target="tb-presets">
      <span class="row-label">Preset</span>
      <span class="row-value">{{ PRESETS.find((p) => p.name === base)?.label ?? 'Custom' }}</span>
      <span class="dot" [style]="'--sw: ' + theme[mode].accent"></span>
    </uiPopoverTrigger>
    <uiPopover id="tb-presets" side="right" align="start">
      <div class="presets" role="group" aria-label="Presets">
        @for (p of PRESETS; track p.name) {
          <button
            type="button"
            class="pick"
            [aria-label]="p.label + ' preset'"
            [aria-pressed]="String(base === p.name)"
            (click)="pick(p.name); document.getElementById('tb-presets')?.hidePopover()"
          >
            <span class="dot" [style]="'--sw: ' + p.accent"></span> {{ p.label }}
          </button>
        }
      </div>
    </uiPopover>
    <label class="row" for="tb-brand">
      <span class="row-label">Brand</span>
      <code class="row-value">{{ theme[mode].accent }}</code>
      <input
        type="color"
        id="tb-brand"
        aria-label="Brand"
        [value]="theme[mode].accent"
        (input)="set('accent', $event.target.value)"
      />
    </label>
    <div class="row row-select">
      <uiSelect
        id="tb-heading"
        label="Heading font"
        [options]="HEADINGS"
        [(value)]="theme.light['font-heading']"
        (change)="font('font-heading', $event)"
      />
    </div>
    <div class="row row-select">
      <uiSelect
        id="tb-font"
        label="Body font"
        [options]="FONTS"
        [(value)]="theme.light.font"
        (change)="font('font', $event)"
      />
    </div>
    <div class="row row-select">
      <uiSelect
        id="tb-mono"
        label="Code font"
        [options]="MONOS"
        [(value)]="theme.light['font-mono']"
        (change)="font('font-mono', $event)"
      />
    </div>
    <div class="row row-select">
      <uiSelect
        id="tb-size"
        label="Base size"
        [options]="SIZE_OPTIONS"
        [(value)]="theme.light['font-size']"
        (change)="set('font-size', $event)"
      />
    </div>
    <div class="row">
      <span class="row-label" id="tb-radius-label">Radius</span>
      <span class="row-value">{{ theme.light.radius }}</span>
      <uiSlider
        id="tb-radius"
        aria-label="Radius"
        [min]="0"
        [max]="20"
        [value]="parseInt(theme.light.radius)"
        (input)="radius($event)"
      />
    </div>
    <div class="row row-select">
      <uiSelect
        id="tb-density"
        label="Density"
        [options]="DENSITIES"
        [(value)]="theme.light.space"
        (change)="set('space', $event)"
      />
    </div>
    <div class="row row-select">
      <uiSelect
        id="tb-shadow"
        label="Shadow"
        [options]="SHADOW_OPTIONS"
        [(value)]="shadow"
        (change)="setShadow($event)"
      />
    </div>
  </div>
  <details class="tb-colours">
    <summary><icon name="lucide:palette" /> Every colour ({{ mode }})</summary>
    @for (g of GROUPS; track g.title) {
      <fieldset>
        <legend>{{ g.title }}</legend>
        @for (tok of g.tokens; track tok.key) {
          <div class="colour">
            <label [for]="'tb-' + tok.key">{{ tok.label }}</label>
            <input
              type="color"
              [id]="'tb-' + tok.key"
              [aria-describedby]="low(tok.key) ? 'tb-' + tok.key + '-warn' : null"
              [value]="theme[mode][tok.key]"
              (input)="set(tok.key, $event.target.value)"
            />
            <code>{{ theme[mode][tok.key] }}</code>
            <p class="warn" [id]="'tb-' + tok.key + '-warn'" [hidden]="!low(tok.key)">
              Low contrast ({{ ratio(tok.key) }}:1, needs 4.5)
            </p>
          </div>
        }
      </fieldset>
    }
  </details>
  <div class="tb-actions">
    <uiButton (click)="copy()"><icon name="lucide:copy" /> {{ copied ? 'Copied' : 'Copy CSS' }}</uiButton>
    <uiButton variant="outline" (click)="shuffle()"><icon name="lucide:shuffle" /> Shuffle</uiButton>
    <uiButton variant="outline" (click)="share()"
      ><icon name="lucide:link" /> {{ shared ? 'Link copied' : 'Share link' }}</uiButton
    >
    <uiButton variant="outline" (click)="reset()"><icon name="lucide:rotate-ccw" /> Reset</uiButton>
  </div>
</div>

<style global>
  /* Global: much of it sits inside the library's parts (a select, a popover), where scoped rules stop. */
  /* A slim panel of rows (shadcn's /create): each a choice and its value; every colour in its own section. */
  .theme-builder {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .theme-builder .tb-rows {
    display: grid;
    gap: 4px;
  }
  .theme-builder .row,
  .theme-builder .tb-rows > [data-part='trigger'] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 8px;
    align-items: center;
    width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .theme-builder .row-label {
    grid-column: 1;
    color: var(--muted);
    font-size: 11px;
  }
  .theme-builder .row-value {
    grid-column: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
  }
  /* A select row: its label small and muted, its control the row's value, borderless. */
  .theme-builder .row-select {
    grid-template-columns: minmax(0, 1fr);
    cursor: default;
  }
  .theme-builder .row-select > :last-child {
    grid-column: 1;
    grid-row: auto;
  }
  .theme-builder .row-select [data-part='select'] {
    gap: 0;
    max-width: none;
    min-width: 0;
  }
  .theme-builder .row-select [data-part='label'] {
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
  }
  .theme-builder .row-select select {
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .theme-builder .row > :last-child,
  .theme-builder .tb-rows > [data-part='trigger'] > :last-child {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .theme-builder .row input[type='color'] {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .theme-builder .row [data-part='slider'] {
    width: 84px;
  }
  .theme-builder .dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sw);
  }
  .theme-builder #tb-presets {
    position-area: right span-bottom;
    margin: 0 0 0 8px;
    padding: 6px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    color: inherit;
  }
  .theme-builder .pick {
    display: flex;
    gap: 8px;
    align-items: center;
    width: 100%;
    padding: 6px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .theme-builder .pick[aria-pressed='true'] {
    background: var(--accent-soft);
  }
  .theme-builder .tb-colours summary {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 6px 10px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }
  .theme-builder fieldset {
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding: 8px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .theme-builder .colour {
    display: grid;
    grid-template-columns: 1fr auto 5.5em;
    gap: 8px;
    align-items: center;
    font-size: 12px;
  }
  .theme-builder .colour input {
    width: 28px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
  }
  .theme-builder .warn {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ui-danger, #b42318);
    font-size: 12px;
  }
  .theme-builder .warn[hidden] {
    display: none;
  }
  .theme-builder .tb-actions {
    display: grid;
    gap: 4px;
  }
  .theme-builder .tb-actions [data-part='button'] {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
</style>
