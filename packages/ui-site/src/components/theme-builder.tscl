{{-- The theme builder (in the header's sheet, theme-sheet.tscl): presets, every colour token, fonts and shape, edited
     per mode. An edit is saved and set live on the page (#ui-theme, what every demo and block reads), and on /theme's
     preview as inline custom properties. Copy CSS hands out theme.css. --}}

<script>
  import { effect } from 'clarusjs/runtime'
  import { presets } from '~/theme/presets.ts'
  import {
    MODELESS,
    PAIRS,
    SPACE_STEPS,
    contrast,
    darkFrom,
    decode,
    encode,
    fromOklch,
    restore,
    toCss,
  } from '~/theme/model.ts'
  import { SCOPE, SOURCE_KEY, STORAGE_KEY, loadFonts } from '~/theme/apply.ts'
  import { DENSITIES, FONTS, HEADINGS, MONOS, SHADOWS, SIZES } from '~/theme/options.ts'

  const PRESETS = ['teal', 'indigo', 'rose', 'amber', 'green', 'neutral'].map((name) => ({
    name,
    label: name[0].toUpperCase() + name.slice(1),
    accent: presets[name].light.accent,
  }))
  const t = (key, label) => ({ key, label })
  const GROUPS = [
    {
      title: 'Brand',
      tokens: [
        t('accent', 'Accent'),
        t('accent-fg', 'Accent text'),
        t('secondary', 'Secondary'),
        t('secondary-fg', 'Secondary text'),
      ],
    },
    {
      title: 'Surfaces',
      tokens: [
        t('bg', 'Background'),
        t('fg', 'Text'),
        t('card', 'Card'),
        t('card-fg', 'Card text'),
        t('popover', 'Popover'),
        t('popover-fg', 'Popover text'),
        t('muted-bg', 'Muted surface'),
        t('muted', 'Muted text'),
        t('accent-soft', 'Hover tint'),
        t('accent-soft-fg', 'Hover tint text'),
        t('border', 'Border'),
        t('input', 'Input border'),
        t('ring', 'Focus ring'),
      ],
    },
    {
      title: 'Status',
      tokens: [
        t('danger', 'Danger'),
        t('danger-fg', 'Danger text'),
        t('success', 'Success'),
        t('success-fg', 'Success text'),
        t('warning', 'Warning'),
        t('warning-fg', 'Warning text'),
      ],
    },
    {
      title: 'Sidebar',
      tokens: [
        t('sidebar', 'Sidebar'),
        t('sidebar-fg', 'Sidebar text'),
        t('sidebar-accent', 'Sidebar accent'),
        t('sidebar-accent-fg', 'Sidebar accent text'),
        t('sidebar-border', 'Sidebar border'),
      ],
    },
  ]
  const clone = (theme) => ({ light: { ...theme.light }, dark: { ...theme.dark } })

  let base = state('teal')
  let theme = state(clone(presets.teal))
  let mode = state('light')
  let edited = state([])
  let shadow = state('soft')
  let copied = state(false)
  let shared = state(false)
  // Saved only after an edit here: opening /theme or a shared link never overwrites a saved theme.
  let dirty = state(false)
  const BG = Object.fromEntries(PAIRS)
  const ratio = (key) => (BG[key] ? Math.floor(contrast(theme[mode][key], theme[mode][BG[key]]) * 10) / 10 : 21)
  const low = (key) => ratio(key) < 4.5

  function pick(name) {
    dirty = true
    base = name
    theme = clone(presets[name])
    edited = []
    shadow = 'soft'
  }
  function set(key, value) {
    dirty = true
    if (MODELESS.includes(key)) {
      theme = { light: { ...theme.light, [key]: value }, dark: theme.dark }
    } else if (mode === 'dark') {
      theme = { light: theme.light, dark: { ...theme.dark, [key]: value } }
      if (!edited.includes(key)) edited = [...edited, key]
    } else {
      const light = { ...theme.light, [key]: value }
      theme = { light, dark: edited.includes(key) ? theme.dark : { ...theme.dark, [key]: darkFrom(light)[key] } }
    }
  }
  function font(key, value) {
    set(key, value)
    loadFonts(value)
  }

  function setShadow(name) {
    dirty = true
    shadow = name
    theme = { light: { ...theme.light, shadow: SHADOWS[name][0] }, dark: { ...theme.dark, shadow: SHADOWS[name][1] } }
  }
  function shuffle() {
    dirty = true
    const h = Math.random() * Math.PI * 2
    const tint = (set, accent, fg, soft) => ({
      ...set,
      accent,
      'accent-fg': fg,
      ring: accent,
      'accent-soft': soft,
      secondary: soft,
      'muted-bg': soft,
      'sidebar-accent': soft,
    })
    theme = {
      light: tint(theme.light, fromOklch([0.5, 0.15, h]), '#ffffff', fromOklch([0.96, 0.03, h])),
      dark: tint(theme.dark, fromOklch([0.78, 0.13, h]), theme.dark.bg, fromOklch([0.27, 0.05, h])),
    }
  }
  function reset() {
    pick(base)
  }
  async function share() {
    try {
      await navigator.clipboard.writeText(`${location.origin}/theme?t=${encodeURIComponent(encode(theme, base))}`)
      shared = true
      setTimeout(() => (shared = false), 1500)
    } catch {}
  }
  async function copy() {
    try {
      await navigator.clipboard.writeText(toCss(theme))
      copied = true
      setTimeout(() => (copied = false), 1500)
    } catch {}
  }
  const load = () => {
    let text = new URLSearchParams(location.search).get('t')
    if (text === null) {
      try {
        text = localStorage.getItem(SOURCE_KEY)
      } catch {}
    }
    const found = text ? decode(text) : null
    if (found) {
      base = found.base
      theme = found.theme
      const back = restore(found.theme, found.base)
      shadow = back.shadow
      edited = back.edited
      loadFonts(Object.values(found.theme.light).join(' '))
    }
  }
  const wire = (el) => {
    load()
    // Light or dark: the one the site shows (the header's switch, else the system setting), followed as it changes.
    const dark = matchMedia('(prefers-color-scheme: dark)')
    const follow = () => {
      const root = document.documentElement.dataset.theme
      mode = root === 'dark' || (root !== 'light' && dark.matches) ? 'dark' : 'light'
    }
    follow()
    const watch = new MutationObserver(follow)
    watch.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    dark.addEventListener('change', follow)
    const stop = effect(() => {
      const preview = document.querySelector('[data-ui-preview]')
      if (!(preview instanceof HTMLElement)) return
      const values = { ...theme.light, ...(mode === 'dark' ? theme.dark : {}) }
      for (const [key, value] of Object.entries(values)) preview.style.setProperty(`--ui-${key}`, String(value))
      // The scale is computed where it's declared: declare it here too, so it follows this unit, not the page's.
      for (const n of SPACE_STEPS) preview.style.setProperty(`--ui-space-${n}`, `calc(var(--ui-space) * ${n})`)
    })
    // Saved, and set on this page at once: the stylesheet every demo and block reads. Other tabs and the block
    // frames hear the save (a storage event) and set it too (APPLY_SCRIPT).
    const save = effect(() => {
      if (!dirty) return
      const css = toCss(theme, SCOPE)
      let sheet = document.getElementById('ui-theme')
      if (!sheet) {
        sheet = document.createElement('style')
        sheet.id = 'ui-theme'
        document.head.append(sheet)
      }
      sheet.textContent = css
      try {
        localStorage.setItem(STORAGE_KEY, css)
        localStorage.setItem(SOURCE_KEY, encode(theme, base))
      } catch {}
    })
    el.setAttribute('data-ready', '')
    return () => {
      stop()
      save()
      watch.disconnect()
      dark.removeEventListener('change', follow)
    }
  }
</script>

<div class="theme-builder" role="group" aria-label="Theme controls" [data-mode]="mode" [use]="wire">
  <div class="tb-rows">
    <button type="button" class="row" id="tb-preset" popovertarget="tb-presets">
      <span class="row-label">Preset</span>
      <span class="row-value">{{ PRESETS.find((p) => p.name === base)?.label ?? 'Custom' }}</span>
      <span class="dot" [style]="'--sw: ' + theme[mode].accent"></span>
    </button>
    <div id="tb-presets" popover class="pop" role="group" aria-label="Presets">
      @for (p of PRESETS; track p.name) {
        <button
          type="button"
          class="pick"
          [aria-label]="p.label + ' preset'"
          [aria-pressed]="String(base === p.name)"
          (click)="pick(p.name)"
          popovertarget="tb-presets"
          popovertargetaction="hide"
        >
          <span class="dot" [style]="'--sw: ' + p.accent"></span> {{ p.label }}
        </button>
      }
    </div>
    <label class="row" for="tb-brand">
      <span class="row-label">Brand</span>
      <code class="row-value">{{ theme[mode].accent }}</code>
      <input
        type="color"
        id="tb-brand"
        aria-label="Brand"
        [value]="theme[mode].accent"
        (input)="set('accent', $event.target.value)"
      />
    </label>
    <label class="row" for="tb-heading">
      <span class="row-label">Heading font</span>
      <select
        id="tb-heading"
        aria-label="Heading font"
        class="row-value"
        (change)="font('font-heading', $event.target.value)"
      >
        @for (f of HEADINGS; track f.label) {
          <option [value]="f.value" [selected]="theme.light['font-heading'] === f.value">{{ f.label }}</option>
        }
      </select>
      <icon name="lucide:heading" />
    </label>
    <label class="row" for="tb-font">
      <span class="row-label">Body font</span>
      <select id="tb-font" aria-label="Body font" class="row-value" (change)="font('font', $event.target.value)">
        @for (f of FONTS; track f.label) {
          <option [value]="f.value" [selected]="theme.light.font === f.value">{{ f.label }}</option>
        }
      </select>
      <icon name="lucide:type" />
    </label>
    <label class="row" for="tb-mono">
      <span class="row-label">Code font</span>
      <select id="tb-mono" aria-label="Code font" class="row-value" (change)="font('font-mono', $event.target.value)">
        @for (f of MONOS; track f.label) {
          <option [value]="f.value" [selected]="theme.light['font-mono'] === f.value">{{ f.label }}</option>
        }
      </select>
      <icon name="lucide:code" />
    </label>
    <label class="row" for="tb-size">
      <span class="row-label">Base size</span>
      <select id="tb-size" aria-label="Base size" class="row-value" (change)="set('font-size', $event.target.value)">
        @for (z of SIZES; track z) {
          <option [value]="z" [selected]="theme.light['font-size'] === z">{{ z }}</option>
        }
      </select>
      <icon name="lucide:a-large-small" />
    </label>
    <label class="row" for="tb-radius">
      <span class="row-label">Radius</span>
      <span class="row-value">{{ theme.light.radius }}</span>
      <input
        type="range"
        id="tb-radius"
        aria-label="Radius"
        min="0"
        max="20"
        [value]="parseInt(theme.light.radius)"
        (input)="set('radius', $event.target.value + 'px')"
      />
    </label>
    <label class="row" for="tb-density">
      <span class="row-label">Density</span>
      <select id="tb-density" aria-label="Density" class="row-value" (change)="set('space', $event.target.value)">
        @for (d of DENSITIES; track d.value) {
          <option [value]="d.value" [selected]="theme.light.space === d.value">{{ d.label }}</option>
        }
      </select>
      <icon name="lucide:move-horizontal" />
    </label>
    <label class="row" for="tb-shadow">
      <span class="row-label">Shadow</span>
      <select id="tb-shadow" aria-label="Shadow" class="row-value" (change)="setShadow($event.target.value)">
        <option value="none" [selected]="shadow === 'none'">None</option>
        <option value="soft" [selected]="shadow === 'soft'">Soft</option>
        <option value="strong" [selected]="shadow === 'strong'">Strong</option>
      </select>
      <icon name="lucide:layers" />
    </label>
  </div>
  <details class="tb-colours">
    <summary><icon name="lucide:palette" /> Every colour ({{ mode }})</summary>
    @for (g of GROUPS; track g.title) {
      <fieldset>
        <legend>{{ g.title }}</legend>
        @for (tok of g.tokens; track tok.key) {
          <div class="colour">
            <label [for]="'tb-' + tok.key">{{ tok.label }}</label>
            <input
              type="color"
              [id]="'tb-' + tok.key"
              [aria-describedby]="low(tok.key) ? 'tb-' + tok.key + '-warn' : null"
              [value]="theme[mode][tok.key]"
              (input)="set(tok.key, $event.target.value)"
            />
            <code>{{ theme[mode][tok.key] }}</code>
            <p class="warn" [id]="'tb-' + tok.key + '-warn'" [hidden]="!low(tok.key)">
              Low contrast ({{ ratio(tok.key) }}:1, needs 4.5)
            </p>
          </div>
        }
      </fieldset>
    }
  </details>
  <div class="tb-actions">
    <button type="button" class="primary" (click)="copy()">
      <icon name="lucide:copy" /> {{ copied ? 'Copied' : 'Copy CSS' }}
    </button>
    <button type="button" (click)="shuffle()"><icon name="lucide:shuffle" /> Shuffle</button>
    <button type="button" (click)="share()">
      <icon name="lucide:link" /> {{ shared ? 'Link copied' : 'Share link' }}
    </button>
    <button type="button" (click)="reset()"><icon name="lucide:rotate-ccw" /> Reset</button>
  </div>
</div>

<style scoped>
  /* A slim panel of rows (shadcn's /create): each a choice and its value; every colour in its own section. */
  :scope.theme-builder {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .tb-rows {
    display: grid;
    gap: 4px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 8px;
    align-items: center;
    width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .row-label {
    grid-column: 1;
    color: var(--muted);
    font-size: 11px;
  }
  .row-value {
    grid-column: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
  }
  select.row-value {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .row > :last-child {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .row input[type='color'] {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .row input[type='range'] {
    width: 84px;
  }
  .dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sw);
  }
  .pop {
    position-area: right span-bottom;
    margin: 0 0 0 8px;
    padding: 6px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg);
    color: inherit;
  }
  .pick {
    display: flex;
    gap: 8px;
    align-items: center;
    width: 100%;
    padding: 6px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .pick[aria-pressed='true'] {
    background: var(--accent-soft);
  }
  .tb-colours summary {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 6px 10px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }
  fieldset {
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding: 8px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .colour {
    display: grid;
    grid-template-columns: 1fr auto 5.5em;
    gap: 8px;
    align-items: center;
    font-size: 12px;
  }
  .colour input {
    width: 28px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
  }
  .warn {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ui-danger, #b42318);
    font-size: 12px;
  }
  .warn[hidden] {
    display: none;
  }
  .tb-actions {
    display: grid;
    gap: 4px;
  }
  .tb-actions button {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .primary {
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
  }
</style>
