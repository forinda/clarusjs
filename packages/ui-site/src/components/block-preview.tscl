{{-- A block in a frame of its own page (/view/<name>), at desktop, tablet or phone width: the block's CSS answers
     the frame's width, as it will the window's once copied. The page writes the <iframe> itself (a frame's src is
     never data); this sizes it. --}}
@input name: string

<script>
  const SIZES = ['Desktop', 'Tablet', 'Phone']
  let size = state('Desktop')
</script>

<div class="block-preview" [data-size]="size.toLowerCase()">
  <div class="block-preview-bar">
    <div role="group" aria-label="Preview width" class="block-preview-sizes">
      @for (s of SIZES; track s) {
        <button type="button" [aria-pressed]="size === s ? 'true' : 'false'" (click)="size = s">{{ s }}</button>
      }
    </div>
    <a [href]="'/view/' + name" target="_blank" rel="noopener">Open in new tab</a>
  </div>
  <slot />
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 8px;
    margin: 16px 0;
  }
  .block-preview-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }
  .block-preview-sizes {
    display: flex;
    gap: 4px;
  }
  button {
    padding: 4px 10px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  button[aria-pressed='true'] {
    background: var(--accent-soft);
  }
  :scope[data-size='tablet'] iframe {
    width: 768px;
  }
  :scope[data-size='phone'] iframe {
    width: 390px;
  }
  iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
  }
</style>
