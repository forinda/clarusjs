{{-- The parts, for the Tailwind parity test (e2e/tailwind.spec.ts): it takes this markup and renders it alone, once with the parts' CSS and once with their Tailwind stylesheets compiled. Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import '~/registry/select.css'
@import '~/registry/combobox.css'
@import '~/registry/toggle.css'
@import uiCheckbox from '~/registry/checkbox.tscl'
@import uiSwitch from '~/registry/switch.tscl'
@import uiRadioGroup from '~/registry/radio-group.tscl'
@import uiField from '~/registry/field.tscl'
@import uiSelect from '@clarusjs/ui-primitives/select.tscl'
@import uiCombobox from '@clarusjs/ui-primitives/combobox.tscl'
@import uiToggle from '@clarusjs/ui-primitives/toggle.tscl'
@import uiToggleGroup from '@clarusjs/ui-primitives/toggle-group.tscl'
@import uiToggleItem from '@clarusjs/ui-primitives/toggle-item.tscl'

@import '~/registry/dialog.css'
@import '~/registry/sheet.css'
@import '~/registry/popover.css'
@import '~/registry/tooltip.css'
@import '~/registry/menu.css'
@import '~/registry/toast.css'
@import uiAlertDialog from '~/registry/alert-dialog.tscl'
@import uiDialog from '@clarusjs/ui-primitives/dialog.tscl'
@import uiDialogClose from '@clarusjs/ui-primitives/dialog-close.tscl'
@import uiPopover from '@clarusjs/ui-primitives/popover.tscl'
@import uiTooltip from '@clarusjs/ui-primitives/tooltip.tscl'
@import uiMenu from '@clarusjs/ui-primitives/menu.tscl'
@import uiMenuTrigger from '@clarusjs/ui-primitives/menu-trigger.tscl'
@import uiMenuList from '@clarusjs/ui-primitives/menu-list.tscl'
@import uiMenuItem from '@clarusjs/ui-primitives/menu-item.tscl'
<script server>
  const sizes = [{ value: 's', label: 'Small' }, { value: 'm', label: 'Medium' }, { value: 'l', label: 'Large' }]
  const fruits = [{ value: 'apple', label: 'Apple' }, { value: 'pear', label: 'Pear' }, { value: 'plum', label: 'Plum' }]
  const toastTypes = ['', 'success', 'error', 'info', 'warning']
</script>

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <div data-sample="checkbox"><uiCheckbox label="Terms" /><uiCheckbox label="On" [checked]="true" /><uiCheckbox label="Off" [disabled]="true" /></div>
  <div data-sample="switch"><uiSwitch label="Wi-Fi" /><uiSwitch label="On" [checked]="true" /><uiSwitch label="Off" [disabled]="true" /></div>
  <div data-sample="radio-group"><uiRadioGroup name="size" label="Size" [options]="sizes" value="m" /></div>
  <div data-sample="field">
    <uiField id="p-email" label="Email" type="email" placeholder="you@example.com" description="We never share it." />
    <uiField id="p-err" label="Name" placeholder="Ada" error="Enter your name." [show]="true" />
  </div>
  <div data-sample="select"><uiSelect id="p-size" label="Size" [options]="sizes" value="m" /></div>
  <div data-sample="combobox">
    <uiCombobox [id]="'p-fruit'" [label]="'Fruit'" [options]="fruits" />
    <uiCombobox [id]="'p-many'" [label]="'Fruits'" [options]="fruits" [multiple]="true" [values]="['apple', 'pear']" />
  </div>
  <div data-sample="toggle">
    <uiToggle aria-label="Bold"><b>B</b></uiToggle>
    <uiToggleGroup label="Alignment" value="left">
      <uiToggleItem value="left">Left</uiToggleItem>
      <uiToggleItem value="right">Right</uiToggleItem>
    </uiToggleGroup>
  </div>
  {{-- Overlays: closed in the markup; the test opens every dialog and popover before measuring. --}}
  <div data-sample="dialog">
    <uiDialog id="p-dialog">
      @slot('title') {
        Delete this file?
      }
      <p>It can't be undone.</p>
      <uiDialogClose target="p-dialog">Cancel</uiDialogClose>
    </uiDialog>
  </div>
  <div data-sample="sheet">
    <uiDialog id="p-sheet" data-side="right">
      @slot('title') {
        Filters
      }
      <p>Status, owner and date range.</p>
    </uiDialog>
    <uiDialog id="p-sheet-bottom" data-side="bottom">
      @slot('title') {
        Share
      }
    </uiDialog>
  </div>
  <div data-sample="alert-dialog">
    <uiAlertDialog id="p-alert">
      @slot('title') {
        Delete this project?
      }
      Its files and history go with it.
      @slot('actions') {
        <uiDialogClose target="p-alert">Cancel</uiDialogClose>
      }
    </uiAlertDialog>
  </div>
  <div data-sample="popover"><uiPopover id="p-pop" side="bottom" align="start"><p>Copy the link.</p></uiPopover></div>
  <div data-sample="tooltip"><uiTooltip id="p-tip" side="bottom">Copies the address</uiTooltip></div>
  <div data-sample="menu">
    <uiMenu id="p-menu">
      <uiMenuTrigger>File</uiMenuTrigger>
      <uiMenuList>
        <uiMenuItem value="new">New</uiMenuItem>
        <uiMenuItem value="save" [disabled]="true">Save</uiMenuItem>
      </uiMenuList>
    </uiMenu>
  </div>
  <div data-sample="toast">
    {{-- A toast as the region's script builds it (static: the test page runs no scripts). --}}
    <section aria-label="Notifications" data-part="toast-region">
      <div aria-live="polite" data-part="toast-list">
        @for (type of toastTypes; track type) {
          <div data-part="toast" [data-type]="type" tabindex="0">
            <span data-part="toast-kind">{{ type }}</span><span data-part="toast-icon" aria-hidden="true"></span>
            <p data-part="toast-message">Saved.</p>
            <button type="button" data-part="toast-action">Undo</button>
            <button type="button" data-part="toast-close" aria-label="Dismiss">×</button>
          </div>
        }
      </div>
    </section>
  </div>
</div>
