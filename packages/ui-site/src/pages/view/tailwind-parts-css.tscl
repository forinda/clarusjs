{{-- The parts, for the Tailwind parity test (e2e/tailwind.spec.ts): it takes this markup and renders it alone, once with the parts' CSS and once with their Tailwind stylesheets compiled. Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import '~/registry/select.css'
@import '~/registry/combobox.css'
@import '~/registry/toggle.css'
@import '~/registry/chip-input.css'
@import '~/registry/editor.css'
@import uiCheckbox from '~/registry/checkbox.tscl'
@import uiSwitch from '~/registry/switch.tscl'
@import uiRadioGroup from '~/registry/radio-group.tscl'
@import uiField from '~/registry/field.tscl'
@import uiSelect from '@clarusjs/ui-primitives/select.tscl'
@import uiCombobox from '@clarusjs/ui-primitives/combobox.tscl'
@import uiChipInput from '@clarusjs/ui-primitives/chip-input.tscl'
@import editorField from '@clarusjs/editor/components/field.tscl'
@import editorToolbar from '@clarusjs/editor/components/toolbar.tscl'
@import editorTool from '@clarusjs/editor/components/tool.tscl'
@import editorCount from '@clarusjs/editor/components/count.tscl'
@import editorSend from '@clarusjs/editor/components/send.tscl'
@import editorFiles from '@clarusjs/editor/components/files.tscl'
@import uiToggle from '@clarusjs/ui-primitives/toggle.tscl'
@import uiToggleGroup from '@clarusjs/ui-primitives/toggle-group.tscl'
@import uiToggleItem from '@clarusjs/ui-primitives/toggle-item.tscl'
@import '~/registry/dialog.css'
@import '~/registry/sheet.css'
@import '~/registry/popover.css'
@import '~/registry/tooltip.css'
@import '~/registry/menu.css'
@import '~/registry/toast.css'
@import uiAlertDialog from '~/registry/alert-dialog.tscl'
@import uiDialog from '@clarusjs/ui-primitives/dialog.tscl'
@import uiDialogClose from '@clarusjs/ui-primitives/dialog-close.tscl'
@import uiPopover from '@clarusjs/ui-primitives/popover.tscl'
@import uiTooltip from '@clarusjs/ui-primitives/tooltip.tscl'
@import uiMenu from '@clarusjs/ui-primitives/menu.tscl'
@import uiMenuTrigger from '@clarusjs/ui-primitives/menu-trigger.tscl'
@import uiMenuList from '@clarusjs/ui-primitives/menu-list.tscl'
@import uiMenuItem from '@clarusjs/ui-primitives/menu-item.tscl'
@import '~/registry/tabs.css'
@import '~/registry/typography.css'
@import '~/registry/sidebar.css'
@import uiAccordion from '~/registry/accordion.tscl'
@import uiTabs from '@clarusjs/ui-primitives/tabs.tscl'
@import uiTabList from '@clarusjs/ui-primitives/tab-list.tscl'
@import uiTab from '@clarusjs/ui-primitives/tab.tscl'
@import uiTabPanel from '@clarusjs/ui-primitives/tab-panel.tscl'
@import uiSidebar from '@clarusjs/ui-primitives/sidebar.tscl'
@import uiSidebarTrigger from '@clarusjs/ui-primitives/sidebar-trigger.tscl'

<script server>
  const sizes = [
    { value: 's', label: 'Small' },
    { value: 'm', label: 'Medium' },
    { value: 'l', label: 'Large' },
  ]
  const fruits = [
    { value: 'apple', label: 'Apple' },
    { value: 'pear', label: 'Pear' },
    { value: 'plum', label: 'Plum' },
  ]
  const toastTypes = ['', 'success', 'error', 'info', 'warning']
</script>

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <div data-sample="checkbox">
    <uiCheckbox label="Terms" /><uiCheckbox label="On" [checked]="true" /><uiCheckbox label="Off" [disabled]="true" />
  </div>
  <div data-sample="switch">
    <uiSwitch label="Wi-Fi" /><uiSwitch label="On" [checked]="true" /><uiSwitch label="Off" [disabled]="true" />
  </div>
  <div data-sample="radio-group"><uiRadioGroup name="size" label="Size" [options]="sizes" value="m" /></div>
  <div data-sample="field">
    <uiField id="p-email" label="Email" type="email" placeholder="you@example.com" description="We never share it." />
    <uiField id="p-err" label="Name" placeholder="Ada" error="Enter your name." [show]="true" />
  </div>
  <div data-sample="select"><uiSelect id="p-size" label="Size" [options]="sizes" value="m" /></div>
  <div data-sample="combobox">
    <uiCombobox [id]="'p-fruit'" [label]="'Fruit'" [options]="fruits" />
    <uiCombobox [id]="'p-many'" [label]="'Fruits'" [options]="fruits" [multiple]="true" [values]="['apple', 'pear']" />
  </div>
  <div data-sample="chip-input"><uiChipInput id="p-tags" label="Tags" [values]="['css', 'html']" /></div>
  <div data-sample="editor">
    <editorField attach="interaction" [id]="'p-editor'" [maxLength]="20" [format]="'html'" [value]="'<p>Over the twenty-character limit</p>'" />
    <editorToolbar [field]="'p-editor'"><editorTool command="bold" label="Bold">B</editorTool><editorTool command="italic" label="Italic">I</editorTool></editorToolbar>
    <editorCount [field]="'p-editor'" /><editorFiles /><editorSend [field]="'p-editor'" />
    {{-- What the field becomes once its editor runs: the editable (empty, then with marks and a mention), and an open list. --}}
    <div data-part="editor"><div role="textbox" data-empty data-placeholder="Reply…"><p></p></div></div>
    <div data-part="editor"><div role="textbox"><p>Hi <span data-mention="u1">@Mara</span>, <code>npm</code> <a href="/components">link</a></p><pre><code>let a = 1</code></pre></div></div>
    <div data-part="toolbar" role="toolbar" aria-label="Formatting"><button type="button" data-part="tool" aria-label="Bold" aria-pressed="true">B</button><button type="button" data-part="tool" aria-label="Italic" aria-pressed="false">I</button></div>
    <span data-part="count" data-over>21/20</span>
    <ul data-part="suggestions" role="listbox" aria-label="People"><li data-part="suggestion" role="option" aria-selected="true">Mara</li><li data-part="suggestion" role="option" aria-selected="false">Marcus</li></ul>
  </div>
  <div data-sample="toggle">
    <uiToggle aria-label="Bold"><b>B</b></uiToggle>
    <uiToggleGroup label="Alignment" value="left">
      <uiToggleItem value="left">Left</uiToggleItem>
      <uiToggleItem value="right">Right</uiToggleItem>
    </uiToggleGroup>
  </div>
  {{-- Overlays: closed in the markup; the test opens every dialog and popover before measuring. --}}
  <div data-sample="dialog">
    <uiDialog id="p-dialog">
      @slot('title') {
        Delete this file?
      }
      <p>It can't be undone.</p>
      <uiDialogClose target="p-dialog">Cancel</uiDialogClose>
    </uiDialog>
  </div>
  <div data-sample="sheet">
    <uiDialog id="p-sheet" data-side="right">
      @slot('title') {
        Filters
      }
      <p>Status, owner and date range.</p>
    </uiDialog>
    <uiDialog id="p-sheet-bottom" data-side="bottom">
      @slot('title') {
        Share
      }
    </uiDialog>
  </div>
  <div data-sample="alert-dialog">
    <uiAlertDialog id="p-alert">
      @slot('title') {
        Delete this project?
      }
      Its files and history go with it.
      @slot('actions') {
        <uiDialogClose target="p-alert">Cancel</uiDialogClose>
      }
    </uiAlertDialog>
  </div>
  <div data-sample="popover">
    <uiPopover id="p-pop" side="bottom" align="start"><p>Copy the link.</p></uiPopover>
  </div>
  <div data-sample="tooltip"><uiTooltip id="p-tip" side="bottom">Copies the address</uiTooltip></div>
  <div data-sample="menu">
    <uiMenu id="p-menu">
      <uiMenuTrigger>File</uiMenuTrigger>
      <uiMenuList>
        <uiMenuItem value="new">New</uiMenuItem>
        <uiMenuItem value="save" [disabled]="true">Save</uiMenuItem>
      </uiMenuList>
    </uiMenu>
  </div>
  <div data-sample="toast">
    {{-- A toast as the region's script builds it (static: the test page runs no scripts). --}}
    <section aria-label="Notifications" data-part="toast-region">
      <div aria-live="polite" data-part="toast-list">
        @for (type of toastTypes; track type) {
          <div data-part="toast" [data-type]="type" tabindex="0">
            <span data-part="toast-kind">{{ type }}</span
            ><span data-part="toast-icon" aria-hidden="true"></span>
            <p data-part="toast-message">Saved.</p>
            <button type="button" data-part="toast-action">Undo</button>
            <button type="button" data-part="toast-close" aria-label="Dismiss">×</button>
          </div>
        }
      </div>
    </section>
  </div>
  <div data-sample="accordion">
    <uiAccordion group="p-faq" [open]="true">
      @slot('trigger') {
        Does it need JavaScript?
      }
      No: it's a details element.
    </uiAccordion>
    <uiAccordion group="p-faq">
      @slot('trigger') {
        Can two be open?
      }
      Not in the same group.
    </uiAccordion>
  </div>
  <div data-sample="tabs">
    <uiTabs id="p-tabs" label="Package manager" value="npm">
      <uiTabList>
        <uiTab value="npm">npm</uiTab>
        <uiTab value="pnpm">pnpm</uiTab>
      </uiTabList>
      <uiTabPanel value="npm">npm i clarusjs</uiTabPanel>
      <uiTabPanel value="pnpm">pnpm add clarusjs</uiTabPanel>
    </uiTabs>
  </div>
  <div data-sample="typography">
    <article data-part="prose">
      <h2>Field notes</h2>
      <p>
        Plain HTML, as Markdown gives it: <strong>no classes</strong>. Read the
        <a href="/components">component list</a>, press <kbd>Ctrl</kbd> + <kbd>K</kbd> to search, or call
        <code>render(props)</code>.
      </p>
      <h3>What we packed</h3>
      <ul>
        <li>A tent and two sleeping bags</li>
        <li>
          Food for three days
          <ul>
            <li>Oats and coffee</li>
          </ul>
        </li>
      </ul>
      <h4>The route</h4>
      <ol>
        <li>Up the ridge before noon</li>
        <li>Down to the lake</li>
      </ol>
      <blockquote><p>The view from the top was worth every step.</p></blockquote>
      <pre><code>const pack = ['tent', 'stove', 'map']</code></pre>
      <table>
        <thead>
          <tr>
            <th scope="col">Day</th>
            <th scope="col">Distance</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>One</td>
            <td>12 km</td>
          </tr>
          <tr>
            <td>Two</td>
            <td>9 km</td>
          </tr>
        </tbody>
      </table>
      <hr />
      <p>Back home by Sunday.</p>
    </article>
  </div>
  <div data-sample="sidebar">
    <uiSidebar id="p-nav" label="Project">
      <a href="#p-overview" aria-current="page">Overview</a>
      <a href="#p-issues">Issues</a>
    </uiSidebar>
    <uiSidebarTrigger target="p-nav">Menu</uiSidebarTrigger>
  </div>
</div>
