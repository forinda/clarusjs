{{-- The cta-centred section alone (the frame on /blocks/marketing/cta shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import ctaCentred from '~/registry/sections/cta/cta-centred.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <ctaCentred />
</div>
