{{-- The chat-composer block alone (the frame on /blocks/chat-composer shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import chatComposerBlock from '~/registry/blocks/chat-composer/chat-composer.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <chatComposerBlock />
</div>
