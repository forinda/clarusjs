{{-- The stats section alone (the frame on /blocks/marketing/stats shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import stats from '~/registry/sections/stats/stats.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <stats />
</div>
