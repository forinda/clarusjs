{{-- The logo-cloud section alone (the frame on /blocks/marketing/logo-cloud shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import logoCloud from '~/registry/sections/logo-cloud/logo-cloud.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <logoCloud />
</div>
