{{-- The header-menus section alone (the frame on /blocks/marketing/header shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import headerMenus from '~/registry/sections/header/header-menus.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <headerMenus />
</div>
