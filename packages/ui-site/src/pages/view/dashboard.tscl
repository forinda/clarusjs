{{-- The dashboard block alone (the frame on /blocks/dashboard shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import dashboard from '~/registry/blocks/dashboard/dashboard.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <dashboard />
</div>
