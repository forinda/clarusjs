{{-- The faq-accordion section alone (the frame on /blocks/marketing/faq shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import faqAccordion from '~/registry/sections/faq/faq-accordion.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <faqAccordion />
</div>
