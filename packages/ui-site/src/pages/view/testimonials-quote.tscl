{{-- The testimonials-quote section alone (the frame on /blocks/marketing/testimonials shows it). Out of the nav, search and the sitemap. --}}
@import '~/theme.css'
@import '~/view.css'
@import testimonialsQuote from '~/registry/sections/testimonials/testimonials-quote.tscl'

<cl-head>
  <meta name="sitemap" content="false" />
  <meta name="robots" content="noindex" />
</cl-head>

<div data-ui-preview>
  <testimonialsQuote />
</div>
