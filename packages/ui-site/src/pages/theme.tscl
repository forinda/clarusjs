@import wide from '~/layouts/wide.tscl'
@import themePreview from '~/components/theme-preview.tscl'
@import themeBuilder from '~/components/theme-builder.tscl'

<wide
  [title]="'Theme'"
  [path]="'/theme'"
  [description]="'Tune the --ui- tokens over a live dashboard of the components, then copy your theme.css.'"
>
  <div class="theme-page">
    <h1>Theme</h1>
    <p class="lead">
      Every component styles itself with the <code>--ui-</code> tokens. Change them here and see the whole set at once.
    </p>
    <div class="workbench">
      <themeBuilder />
      <themePreview />
    </div>
  </div>
</wide>

<style scoped>
  .workbench {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
  }
  .tb-toolbar {
    order: -1;
  }
  @media (min-width: 960px) {
    .workbench {
      grid-template-columns: 260px minmax(0, 1fr);
      grid-template-areas: 'panel toolbar' 'panel preview';
      align-items: start;
    }
    .theme-builder {
      grid-area: panel;
    }
    .tb-toolbar {
      grid-area: toolbar;
    }
    [data-ui-preview] {
      grid-area: preview;
    }
  }
</style>
