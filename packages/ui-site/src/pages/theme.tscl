@import wide from '~/layouts/wide.tscl'
@import themePreview from '~/components/theme-preview.tscl'
@import uiDialogTrigger from '@clarusjs/ui-primitives/dialog-trigger.tscl'

<wide
  [title]="'Theme'"
  [path]="'/theme'"
  [description]="'Tune the --ui- tokens over a live dashboard of the components, then copy your theme.css.'"
>
  <div class="theme-page">
    <div class="theme-head">
      <div class="theme-title">
        <h1>Theme</h1>
        {{-- The same sheet as the header's button. --}}
        <uiDialogTrigger target="theme-sheet"><icon name="lucide:sliders-horizontal" /> Customize</uiDialogTrigger>
      </div>
      <p class="lead">
        Every component styles itself with the <code>--ui-</code> tokens. Change them in the Theme sheet (the header's
        button, on every page) and see the whole set at once.
      </p>
    </div>
    {{-- The dashboard block in a frame (a page of its own, with its own <main>): it follows each edit, which the
         builder saves as it goes. Then the rest of the components. --}}
    <div class="theme-canvas">
      <iframe src="/view/dashboard" title="Dashboard preview" class="theme-dash"></iframe>
      <h2 class="theme-more">Components</h2>
      <themePreview />
    </div>
  </div>
</wide>

<style scoped>
  .theme-head {
    margin-bottom: 16px;
  }
  /* The title and Customize on one row; the lead under them. */
  .theme-title {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  .theme-title h1 {
    margin: 0;
  }
  .theme-head .lead {
    margin: 8px 0 0;
  }
  .theme-canvas {
    display: grid;
    gap: 16px;
  }
  .theme-dash {
    display: block;
    width: 100%;
    height: 900px;
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
  .theme-more {
    margin: 24px 0 0;
  }
  [data-part='trigger'] {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
</style>
