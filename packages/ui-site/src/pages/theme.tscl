@import wide from '~/layouts/wide.tscl'
@import themePreview from '~/components/theme-preview.tscl'
@import uiDialogTrigger from '@clarusjs/ui-primitives/dialog-trigger.tscl'

<wide
  [title]="'Theme'"
  [path]="'/theme'"
  [description]="'Tune the --ui- tokens over a live dashboard of the components, then copy your theme.css.'"
>
  <div class="theme-page">
    <div class="theme-head">
      <div>
        <h1>Theme</h1>
        <p class="lead">
          Every component styles itself with the <code>--ui-</code> tokens. Change them in the Theme sheet (the header's
          button, on every page) and see the whole set at once.
        </p>
      </div>
      {{-- The same sheet as the header's button. --}}
      <uiDialogTrigger target="theme-sheet"><icon name="lucide:sliders-horizontal" /> Customize</uiDialogTrigger>
    </div>
    <themePreview />
  </div>
</wide>

<style scoped>
  .theme-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .theme-head .lead {
    margin-bottom: 0;
  }
  [data-part='trigger'] {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
</style>
