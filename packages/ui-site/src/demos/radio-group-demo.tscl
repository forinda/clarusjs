  let size = state('m')
  const sizes = [
    { value: 's', label: 'Small' },
    { value: 'm', label: 'Medium' },
    { value: 'l', label: 'Large' },
    { value: 'xl', label: 'Extra large', disabled: true },
  ]
</script>

<div class="demo">
  <uiRadioGroup name="size" label="Size" [options]="sizes" [(value)]="size" />
  <p>
    Size: <span class="out">{{ size }}</span>
  </p>
</div>

