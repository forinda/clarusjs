@import '../registry/dialog/dialog.css'
@import uiDialog from '@clarusjs/ui-primitives/dialog.tscl'
@import uiDialogTrigger from '@clarusjs/ui-primitives/dialog-trigger.tscl'
@import uiDialogClose from '@clarusjs/ui-primitives/dialog-close.tscl'

<div class="demo">
  <uiDialogTrigger target="demo-dialog">Delete file…</uiDialogTrigger>
  <uiDialog id="demo-dialog">
    @slot('title') {
      Delete this file?
    }
    <p>It can't be undone.</p>
    <uiDialogClose target="demo-dialog">Cancel</uiDialogClose>
  </uiDialog>
</div>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 24px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
