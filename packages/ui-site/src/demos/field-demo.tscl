@import uiField from '../registry/field/field.tscl'
@import uiButton from '../registry/button/button.tscl'

<script>
  let email = state('')
  let tried = state(false)
</script>

<form class="demo" novalidate (submit)="$event.preventDefault(); tried = true">
  <uiField
    id="demo-email"
    label="Email"
    type="email"
    description="We never share it."
    [error]="email.includes('@') ? '' : 'Enter an email address.'"
    [show]="tried"
    [(value)]="email"
  />
  <uiButton type="submit">Sign up</uiButton>
</form>

<style scoped>
  :scope {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 24px;
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius);
    background: var(--ui-bg);
    color: var(--ui-fg);
  }
  p {
    margin: 0;
  }
</style>
