{{-- The layout: the docs theme with this site's navigation (src/nav.ts) and the tokens components use (src/theme.css). --}}
@import docsTheme from '@clarusjs/theme-docs/layout.tscl'
@import { theme } from '~/nav.ts'
@import type { Heading } from '@clarusjs/theme-docs/nav.ts'
@import '~/theme.css'
@import themeReset from '~/components/theme-reset.tscl'
@import themeSheet from '~/components/theme-sheet.tscl'
@import toastRegion from '@clarusjs/ui-primitives/toast-region.tscl'
@import '~/registry/toast.css'
@input title: string
@input path: string = '/'
@input source: string = ''
@input url: string = ''
@input description: string = 'Styled clarusjs components to copy into your project.'
@input headings: Heading[] = []
@input app: boolean = false

<docsTheme
  [config]="theme"
  [title]="title"
  [path]="path"
  [source]="source"
  [url]="url"
  [description]="description"
  [headings]="headings"
  [app]="app"
  >@slot('header-end') {<themeSheet />}@if (!app) {<themeReset />}<slot /><toastRegion
/></docsTheme>

<style global>
  /* The docs theme makes Markdown tables scroll (display: block); a chart's data table stays a table. */
  .content [data-part='chart-table'] {
    display: table;
    overflow: visible;
  }
</style>
