{{--
  Combobox (#466): pick one option, or several with [multiple]="true", from a list you can search by typing.
  @import combobox from '@clarusjs/ui-primitives/combobox.tscl', or copy this file into your project. Bind the pick
  with [(value)] (a string), or the picks with [(values)] (a list).

  Headless: data-part names each element (combobox, label, control, chip, input, listbox, option, status), and the
  option the keys are on has data-highlighted. Only what it needs to work is styled (the list below the input).

  <combobox [id]="'country'" [label]="'Country'" [options]="countries" [(value)]="form.country" />
  <combobox [id]="'topics'" [label]="'Topics'" [options]="topics" [multiple]="true" [(values)]="form.topics" />

  Remote options: give [src] a URL; typing asks it for `src?q=<search>` (JSON: [{ value, label }]), 200 ms after the
  last key, and the newest search wins. <combobox [id]="'city'" [label]="'City'" [src]="'/api/cities'" [(value)]="city" />

  Keyboard: ↑ ↓ move, Home / End jump, Enter picks, Esc closes, Backspace in an empty search removes the last pick.

  Each pick or removal sends (change) first, with the option and whether it's now selected; $info.reason is 'select',
  'deselect' or 'remove', and $info.cancel() keeps it from happening:
  <combobox … (change)="if (tooMany && $event.selected) $info.cancel()" />
  Give each one its own id: its listbox and options are named after it.
--}}
@type Option = { value: string; label: string }
@input id: string = 'combobox'
@input label: string = 'Fruit'
@input options: Option[] = [
  { value: 'apple', label: 'Apple' },
  { value: 'apricot', label: 'Apricot' },
  { value: 'banana', label: 'Banana' },
  { value: 'cherry', label: 'Cherry' },
  { value: 'grape', label: 'Grape' },
  { value: 'mango', label: 'Mango' },
  { value: 'orange', label: 'Orange' },
  { value: 'pear', label: 'Pear' },
]
@input multiple: boolean = false
@input placeholder: string = 'Search…'
@input src: string = ''
@model value: string = ''
@model values: string[] = []
@event change: { value: string; label: string; selected: boolean }

<script>
  import { json, resource } from 'clarusjs/fetch'
  let query = state('')
  let term = state('') // the search sent to src: the query, 200 ms after the last key
  let known = state({}) // labels of remote options picked, by value (the next search may not list them)
  let timer
  let open = state(false)
  let active = state(0)
  // What's chosen, as a list in both modes.
  const chosen = derived(() => (multiple ? values : value ? [value] : []))
  // With src: the server's answer for the term, cached by it; nothing is asked until the list opens.
  const remote = resource(
    ({ signal }) =>
      src && open ? json(src + (src.includes('?') ? '&' : '?') + 'q=' + encodeURIComponent(term), { signal }) : false,
    { key: () => (src && open ? ['combobox', src, term] : false) },
  )
  // The options matching what's typed (by label, ignoring case), or the server's.
  const shown = derived(() => {
    if (src) return remote.value ?? []
    const q = query.trim().toLowerCase()
    return q ? options.filter((o) => o.label.toLowerCase().includes(q)) : options
  })
  const labelOf = (v) => known[v] ?? options.find((o) => o.value === v)?.label ?? v
  const status = derived(() => {
    if (!open) return ''
    if (src && remote.loading) return 'Searching…'
    if (src && remote.error) return "Couldn't load the options."
    return shown.length ? '' : 'No match for "' + query + '"'
  })

  function show() {
    open = true
    active = Math.max(
      0,
      shown.findIndex((o) => chosen.includes(o.value)),
    )
  }
  function pick(option, event) {
    const selected = !(multiple && chosen.includes(option.value))
    if (
      !emit(
        'change',
        { value: option.value, label: option.label, selected },
        { reason: selected ? 'select' : 'deselect', event },
      )
    )
      return
    if (src) known = { ...known, [option.value]: option.label }
    if (multiple) {
      values = chosen.includes(option.value) ? chosen.filter((v) => v !== option.value) : [...chosen, option.value]
    } else {
      value = option.value
      open = false
    }
    query = ''
    term = ''
  }
  function remove(v, event) {
    if (!emit('change', { value: v, label: labelOf(v), selected: false }, { reason: 'remove', event })) return
    values = chosen.filter((x) => x !== v)
  }
  function type(text) {
    query = text
    open = true
    active = 0
    clearTimeout(timer)
    timer = setTimeout(() => (term = text), src ? 200 : 0)
  }
  function key(event) {
    const last = shown.length - 1
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault()
      if (!open) return show()
      active = event.key === 'ArrowDown' ? Math.min(active + 1, last) : Math.max(active - 1, 0)
    } else if (open && (event.key === 'Home' || event.key === 'End')) {
      event.preventDefault()
      active = event.key === 'Home' ? 0 : last
    } else if (event.key === 'Enter' && open && shown[active]) {
      event.preventDefault()
      pick(shown[active], event)
    } else if (event.key === 'Escape' && open) {
      event.preventDefault()
      open = false
      query = '' // back to what's chosen
    } else if (event.key === 'Backspace' && multiple && !query && chosen.length) {
      remove(chosen[chosen.length - 1], event)
    }
  }
  // Closes when focus leaves the whole combobox (a click outside, Tab away).
  function leave(event) {
    if (!event.currentTarget.contains(event.relatedTarget)) {
      open = false
      query = ''
    }
  }
</script>

<div data-part="combobox" (focusout)="leave($event)">
  <label [for]="id + '-input'" data-part="label">{{ label }}</label>
  <div data-part="control">
    @if (multiple) {
      @for (v of chosen; track v) {
        <span data-part="chip"
          >{{ labelOf(v) }}
          <button type="button" [aria-label]="'Remove ' + labelOf(v)" (click)="remove(v, $event)">×</button></span
        >
      }
    }
    <input
      [id]="id + '-input'"
      role="combobox"
      autocomplete="off"
      data-part="input"
      aria-autocomplete="list"
      [aria-expanded]="open ? 'true' : 'false'"
      [aria-controls]="id + '-list'"
      [aria-activedescendant]="open && shown[active] ? id + '-' + shown[active].value : false"
      [placeholder]="multiple || !chosen.length ? placeholder : false"
      [value]="open || multiple ? query : labelOf(value)"
      (input)="type($event.target.value)"
      (click)="show()"
      (keydown)="key($event)"
    />
  </div>
  <ul
    [id]="id + '-list'"
    role="listbox"
    [aria-label]="label"
    [aria-multiselectable]="multiple ? 'true' : false"
    [hidden]="!open"
    (mousedown)="$event.preventDefault()"
    data-part="listbox"
  >
    @for (option of shown; track option.value) {
      <li
        [id]="id + '-' + option.value"
        role="option"
        [aria-selected]="chosen.includes(option.value) ? 'true' : 'false'"
        [data-highlighted]="$index === active ? '' : false"
        data-part="option"
        (click)="pick(option, $event)"
      >
        {{ option.label }}
      </li>
    }
  </ul>
  <p role="status" data-part="status">{{ status }}</p>
</div>

<style scoped>
  /* What it needs to work: the list opens below the input, over what follows. The rest is yours to style. */
  :scope {
    position: relative;
  }
  [data-part='listbox'] {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    max-height: 240px;
    overflow-y: auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
