{{--
  Toast region: where toast('…') messages appear. Put it once in your layout. Its look is yours: write the markup of
  a toast in @slot('toast') (one root element: it becomes the toast), and a kind's own in @slot('success' | 'error' | 'info' | 'warning'); the region copies it
  for each toast and fills the parts it finds: data-part="toast-message" (the text), "toast-action" (removed when the
  toast has none), "toast-close", "toast-icon" (a default icon when it's empty). Static markup: it's copied, not run. A polite live region: screen readers
  announce new messages without moving focus. Each message stays its duration (paused while hovered or focused);
  Escape dismisses the focused one; an action runs and dismisses.

  <toast-region />   …   import { toast } from '@clarusjs/ui-primitives'; toast('Saved')
  [label] names the region ("Notifications"): give a second region on a page its own.
--}}
@input label: string = 'Notifications'

<script>
  import { dismissToast, subscribeToasts, toasts } from '@clarusjs/ui-primitives'
  const KINDS = { success: 'Success:', error: 'Error:', info: 'Info:', warning: 'Warning:' }
  const PATHS = {
    success: 'M5 12l5 5 9-10',
    error: 'M6 6l12 12M18 6L6 18',
    info: 'M12 8h.01M11 12h1v5h1',
    warning: 'M12 4l9 16H3zM12 10v4M12 17h.01',
  }
  function svg(type) {
    const ns = 'http://www.w3.org/2000/svg'
    const root = document.createElementNS(ns, 'svg')
    root.setAttribute('viewBox', '0 0 24 24')
    root.setAttribute('width', '18')
    root.setAttribute('height', '18')
    root.setAttribute('fill', 'none')
    root.setAttribute('stroke', 'currentColor')
    root.setAttribute('stroke-width', '2')
    const path = document.createElementNS(ns, 'path')
    path.setAttribute('d', PATHS[type])
    root.append(path)
    return root
  }
  function wire(el) {
    // A toast's markup: its kind's template, else the general one, else the default (icon, message, action, close).
    // A template has one root element, which becomes the toast; one with none or several is ignored.
    const usable = (tpl) => {
      if (!(tpl instanceof HTMLTemplateElement) || !tpl.content.childNodes.length) return false
      const loose = [...tpl.content.childNodes].some((n) => n.nodeType === 3 && n.textContent?.trim())
      if (tpl.content.childElementCount === 1 && !loose) return true
      console.warn(
        `[ui-primitives] <toast-region>: the ${tpl.dataset.type} template needs one root element; using the default`,
      )
      return false
    }
    const template = (type) => {
      const own = type && el.querySelector(`template[data-type="${type}"]`)
      if (own && usable(own)) return own
      const general = el.querySelector('template[data-type="toast"]')
      return general && usable(general) ? general : null
    }
    const piece = (t) => {
      const chosen = template(t.type)
      const root = chosen?.content.firstElementChild?.cloneNode(true)
      if (root instanceof HTMLElement) return root
      const make = (tag, part, text = '') => {
        const node = document.createElement(tag)
        node.dataset.part = part
        if (text) node.textContent = text
        return node
      }
      const action = make('button', 'toast-action')
      const close = make('button', 'toast-close', '×')
      action.setAttribute('type', 'button')
      close.setAttribute('type', 'button')
      close.setAttribute('aria-label', 'Dismiss')
      const box = document.createElement('div')
      box.append(make('span', 'toast-icon'), make('p', 'toast-message'), action, close)
      return box
    }
    const list = el.querySelector('[data-part="toast-list"]')
    const timers = new Map()
    let origin // where focus was before it came into the list, to go back to
    const start = (t, item) => {
      clearTimeout(timers.get(t.id))
      if (!Number.isFinite(t.duration)) return
      timers.set(
        t.id,
        setTimeout(() => dismissToast(t.id), t.duration),
      )
      item.dataset.timing = ''
    }
    // Dismissing the focused toast moves focus to the next one, or back where it came from.
    const leave = (id, item) => {
      const next = item.nextElementSibling ?? item.previousElementSibling
      const focused = item.contains(document.activeElement)
      dismissToast(id)
      if (focused) (next instanceof HTMLElement && next.isConnected ? next : origin)?.focus()
    }
    const pause = (id, item) => {
      clearTimeout(timers.get(id))
      delete item.dataset.timing
    }
    let stop = () => {}
    const render = () => {
      // A region taken out of the page (a fragment swap, a re-render) stops listening.
      if (!el.isConnected) {
        for (const id of timers.values()) clearTimeout(id)
        return stop()
      }
      const now = toasts()
      for (const item of [...list.children]) {
        if (!now.some((t) => String(t.id) === item.dataset.id)) {
          clearTimeout(timers.get(Number(item.dataset.id)))
          item.remove()
        }
      }
      for (const t of now) {
        if (list.querySelector(`[data-id="${t.id}"]`)) continue
        const item = piece(t)
        item.dataset.part = 'toast'
        item.dataset.id = String(t.id)
        if (t.type) item.dataset.type = t.type
        item.tabIndex = 0
        const kind = document.createElement('span')
        kind.dataset.part = 'toast-kind'
        kind.textContent = t.type ? KINDS[t.type] : ''
        item.prepend(kind)
        const icon = item.querySelector('[data-part="toast-icon"]')
        if (icon) {
          icon.setAttribute('aria-hidden', 'true')
          if (t.icon === false) icon.replaceChildren()
          else if (!icon.childNodes.length && t.type) icon.append(svg(t.type))
        }
        const message = item.querySelector('[data-part="toast-message"]')
        if (message) message.textContent = t.message
        const action = item.querySelector('[data-part="toast-action"]')
        const act = t.action
        if (action && act) {
          action.textContent = act.label
          action.addEventListener('click', () => {
            act.onClick()
            leave(t.id, item)
          })
        } else action?.remove()
        item.querySelector('[data-part="toast-close"]')?.addEventListener('click', () => leave(t.id, item))
        const hold = () => pause(t.id, item)
        const resume = () => {
          if (!item.matches(':hover') && !item.contains(document.activeElement)) start(t, item)
        }
        item.addEventListener('pointerenter', hold)
        item.addEventListener('focusin', (event) => {
          if (!(event.relatedTarget instanceof Node && list.contains(event.relatedTarget)))
            origin = event.relatedTarget instanceof HTMLElement ? event.relatedTarget : origin
          hold()
        })
        item.addEventListener('pointerleave', resume)
        item.addEventListener('focusout', () => setTimeout(resume))
        item.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') leave(t.id, item)
        })
        list.append(item)
        start(t, item)
      }
    }
    stop = subscribeToasts(render)
    return () => {
      stop()
      for (const id of timers.values()) clearTimeout(id)
    }
  }
</script>

<section [aria-label]="label" data-part="toast-region" [use]="wire">
  <template data-type="toast"><slot name="toast" /></template>
  <template data-type="success"><slot name="success" /></template>
  <template data-type="error"><slot name="error" /></template>
  <template data-type="info"><slot name="info" /></template>
  <template data-type="warning"><slot name="warning" /></template>
  <div aria-live="polite" data-part="toast-list"></div>
</section>
