{{--
  Toast region: where toast('…') messages appear. Put it once in your layout. A polite live region: screen readers
  announce new messages without moving focus. Each message stays its duration (paused while hovered or focused);
  Escape dismisses the focused one; an action runs and dismisses.

  <toast-region />   …   import { toast } from '@clarusjs/ui-primitives'; toast('Saved')
--}}
<script>
  import { dismissToast, subscribeToasts, toasts } from '@clarusjs/ui-primitives'
  function wire(el) {
    const list = el.querySelector('[data-part="toast-list"]')
    const timers = new Map()
    let origin // where focus was before it came into the list, to go back to
    const start = (t, item) => {
      clearTimeout(timers.get(t.id))
      if (!Number.isFinite(t.duration)) return
      timers.set(t.id, setTimeout(() => dismissToast(t.id), t.duration))
      item.dataset.timing = ''
    }
    // Dismissing the focused toast moves focus to the next one, or back where it came from.
    const leave = (id, item) => {
      const next = item.nextElementSibling ?? item.previousElementSibling
      const focused = item.contains(document.activeElement)
      dismissToast(id)
      if (focused) (next instanceof HTMLElement && next.isConnected ? next : origin)?.focus()
    }
    const pause = (id, item) => {
      clearTimeout(timers.get(id))
      delete item.dataset.timing
    }
    let stop = () => {}
    const render = () => {
      // A region taken out of the page (a fragment swap, a re-render) stops listening.
      if (!el.isConnected) {
        for (const id of timers.values()) clearTimeout(id)
        return stop()
      }
      const now = toasts()
      for (const item of [...list.children]) {
        if (!now.some((t) => String(t.id) === item.dataset.id)) {
          clearTimeout(timers.get(Number(item.dataset.id)))
          item.remove()
        }
      }
      for (const t of now) {
        if (list.querySelector(`[data-id="${t.id}"]`)) continue
        const item = document.createElement('li')
        item.dataset.part = 'toast'
        item.dataset.id = String(t.id)
        item.tabIndex = 0
        const message = document.createElement('p')
        message.dataset.part = 'toast-message'
        message.textContent = t.message
        item.append(message)
        const act = t.action
        if (act) {
          const action = document.createElement('button')
          action.type = 'button'
          action.dataset.part = 'toast-action'
          action.textContent = act.label
          action.addEventListener('click', () => {
            act.onClick()
            leave(t.id, item)
          })
          item.append(action)
        }
        const close = document.createElement('button')
        close.type = 'button'
        close.dataset.part = 'toast-close'
        close.setAttribute('aria-label', 'Dismiss')
        close.textContent = '×'
        close.addEventListener('click', () => leave(t.id, item))
        item.append(close)
        const hold = () => pause(t.id, item)
        const resume = () => {
          if (!item.matches(':hover') && !item.contains(document.activeElement)) start(t, item)
        }
        item.addEventListener('pointerenter', hold)
        item.addEventListener('focusin', (event) => {
          if (!(event.relatedTarget instanceof Node && list.contains(event.relatedTarget))) origin = event.relatedTarget instanceof HTMLElement ? event.relatedTarget : origin
          hold()
        })
        item.addEventListener('pointerleave', resume)
        item.addEventListener('focusout', () => setTimeout(resume))
        item.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') leave(t.id, item)
        })
        list.append(item)
        start(t, item)
      }
    }
    stop = subscribeToasts(render)
    return () => {
      stop()
      for (const id of timers.values()) clearTimeout(id)
    }
  }
</script>

<section aria-label="Notifications" data-part="toast-region" [use]="wire">
  <ol aria-live="polite" data-part="toast-list"></ol>
</section>
