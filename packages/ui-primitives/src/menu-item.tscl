{{-- Menu item (#465): one choice in a <menu-list>; its value goes to the menu's (select). --}}
@input value: string
@input disabled: boolean = false

<button type="button" role="menuitem" tabindex="-1" [data-value]="value" [aria-disabled]="disabled ? 'true' : false" data-part="menu-item">
  <slot />
</button>
