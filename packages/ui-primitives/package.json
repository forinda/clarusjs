{
  "name": "@clarusjs/ui-primitives",
  "version": "0.0.0",
  "description": "Accessible behaviours for clarusjs components: roving focus, typeahead, dismiss, transitions, focus return and positioning, as small DOM functions for [use].",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "types": "node scripts/types.mjs",
    "prepack": "pnpm types",
    "test": "vitest run",
    "typecheck": "pnpm types && tsc --noEmit"
  },
  "peerDependencies": {
    "clarusjs": "workspace:^"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/clarusjs.git",
    "directory": "packages/ui-primitives"
  },
  "keywords": [
    "clarusjs",
    "accessibility",
    "headless",
    "primitives",
    "ui"
  ],
  "homepage": "https://clarusjs.com/guide/ui-primitives",
  "bugs": {
    "url": "https://github.com/forinda/clarusjs/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "clarusjs": "workspace:^",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
