{
  "name": "clarusjs-vscode",
  "displayName": "clarusjs",
  "description": "clarusjs .tscl templates: the clarusjs language server (template errors, HTML/CSS/Emmet, components, references, renames), highlighting, snippets, file icon.",
  "version": "0.1.0",
  "private": true,
  "publisher": "forinda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/clarusjs",
    "directory": "packages/vscode"
  },
  "homepage": "https://clarusjs.com/guide/editor",
  "icon": "icons/extension.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "clarusjs",
    "tscl",
    "template",
    "islands"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:tscl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tscl",
        "aliases": [
          "clarusjs template",
          "tscl"
        ],
        "extensions": [
          ".tscl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tscl-light.svg",
          "dark": "./icons/tscl-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tscl",
        "scopeName": "text.html.tscl",
        "path": "./syntaxes/tscl.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.css": "css",
          "meta.embedded.expression.tscl": "typescript"
        }
      },
      {
        "scopeName": "text.html.tscl.bindings",
        "path": "./syntaxes/tscl-bindings.tmLanguage.json",
        "injectTo": [
          "text.html.tscl"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.tscl": "typescript"
        }
      }
    ],
    "snippets": [
      {
        "language": "tscl",
        "path": "./snippets/tscl.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/load.json"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "tscl": "html"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "package": "pnpm build && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --mode server"
  },
  "devDependencies": {
    "@clarusjs/language-server": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.91.0",
    "@volar/test-utils": "~2.4.31",
    "@vscode/vsce": "^4.1.1",
    "clarusjs": "workspace:*",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vscode-languageclient": "^11.0.0",
    "vscode-uri": "^3.2.0"
  }
}
