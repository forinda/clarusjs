{
  "name": "@clarusjs/language-server",
  "version": "0.1.0",
  "description": "The clarusjs language server (clarusjs-ls): .tscl templates in any editor, from the clarusjs compiler.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forinda/clarusjs.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://clarusjs.com/guide/editor",
  "keywords": [
    "clarusjs",
    "tscl",
    "language-server",
    "lsp",
    "volar"
  ],
  "bin": {
    "clarusjs-ls": "./bin/clarusjs-ls.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@volar/language-core": "~2.4.31",
    "@volar/language-server": "~2.4.31",
    "@volar/language-service": "~2.4.31",
    "@volar/test-utils": "~2.4.31",
    "clarusjs": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "volar-service-css": "~0.0.71",
    "volar-service-emmet": "~0.0.71",
    "volar-service-html": "~0.0.71",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-uri": "^3.2.0"
  }
}
